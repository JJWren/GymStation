@page "/{Slug}"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using System.Security.Claims
@using GymStation.Domain.People
@using Microsoft.AspNetCore.DataProtection
@using GymStation.Domain.Scheduling
@using GymStation.Domain.Tenancy
@using GymStation.Infrastructure.Tenancy
@inject IDbContextFactory<GymStationDbContext> DbFactory
@inject Microsoft.AspNetCore.DataProtection.IDataProtectionProvider DataProtection
@inject GymMembershipService Memberships
@inject TenantContext Tenant

@if (_gym is null)
{
    <PageTitle>GymStation</PageTitle>
    <main class="auth-shell">
        <h1>GYMSTATION</h1>
        <p class="tagline">NO GYM AT THIS ADDRESS</p>
        <p class="auth-note">Check the link your gym gave you, or <a href="/login">sign in</a>.</p>
    </main>
}
else
{
    <PageTitle>@_gym.Name — Schedule &amp; Instructors</PageTitle>
    <HeadContent>
        <meta name="description" content="@($"{_gym.Name}: weekly schedule, instructors, and how to visit.")" />
    </HeadContent>

    @* Tenant accent AND the gym's default mode apply to the public face too. *@
    <div class="@(_dark ? null : "theme-light")" style="--tenant:@_accent">
        <header class="pub-hero" style="@(_settings?.HeroPath is { } hero ? $"background-image:url('/media/{hero}')" : null)">
            <div class="pub-hero-scrim">
                @if (_settings?.LogoPath is { } logo)
                {
                    <img class="pub-crest" src="/media/@logo" alt="@_gym.Name logo" />
                }
                else
                {
                    <div class="pub-crest" role="img" aria-label="@_gym.Name crest"><BrandMark Size="2.875rem" /></div>
                }
                <h1>@_gym.Name.ToUpperInvariant()</h1>
                <p class="pub-tag">
                    @for (var i = 0; i < _visibleSections.Count; i++)
                    {
                        if (i > 0)
                        {
                            <text> · </text>
                        }
                        var anchorKey = _visibleSections[i];
                        <a href="#@anchorKey">@LabelFor(anchorKey)</a>
                    }
                </p>
                @if (_signedInEmail is { } email)
                {
                    <p class="pub-tag" style="margin:0 0 0.625rem">SIGNED IN AS @email.ToUpperInvariant()</p>
                    <div style="display:flex;gap:0.5rem;flex-wrap:wrap">
                        <a class="btn" href="@_portalPath">BACK TO YOUR PORTAL</a>
                        <form method="post" action="/auth/logout" style="margin:0">
                            <AntiforgeryToken />
                            <button class="btn btn--ghost" type="submit">SIGN OUT</button>
                        </form>
                    </div>
                }
                else
                {
                    <a class="btn" href="/login">MEMBER SIGN-IN</a>
                }
            </div>
        </header>

        @* Sections render in the admin-set order (#134); empty ones auto-hide.
           Hero and foot bracket the page immutably; Contact rides with visit. *@
        @foreach (var sectionKey in _visibleSections)
        {
            switch (sectionKey)
            {
                case LandingSections.About:
                    <section class="pub-section" id="about">
                        <h2>@(_settings?.AboutTitle ?? "ABOUT")</h2>
                        <div class="patch pub-about"><MarkdownBlock Text="@_settings?.AboutText" /></div>
                    </section>
                    break;
                case LandingSections.Programs:
                    <section class="pub-section" id="programs">
                        <h2>@(_settings?.ProgramsTitle ?? "PROGRAMS")</h2>
                        @if (!string.IsNullOrWhiteSpace(_settings?.ProgramsIntro))
                        {
                            <div class="pub-intro"><MarkdownBlock Text="@_settings!.ProgramsIntro" /></div>
                        }
                        <div class="pub-programs">
                            @foreach (var program in _programs)
                            {
                                <a class="pub-prog" href="/@_gym.Slug?program=@program.Id#programs">
                                    @if (program.ImagePath is not null)
                                    {
                                        <img src="/media/@program.ImagePath" alt="" />
                                    }
                                    <b>@program.Title.ToUpperInvariant()</b>
                                </a>
                            }
                        </div>
                    </section>
                    break;
                case LandingSections.Schedule:
        <section class="pub-strip" id="schedule">
            <h2>THIS WEEK AT @_gym.Name.ToUpperInvariant() — LIVE</h2>
            <div class="pub-days">
                @foreach (var day in _week)
                {
                    <div class="pub-day">
                        <b>@day.Key.ToString().ToUpperInvariant()[..3]</b>
                        @foreach (var template in day.Value)
                        {
                            <span>@template.StartTime.ToString("HH\\:mm") @template.Name.ToUpperInvariant()</span>
                        }
                        @if (day.Value.Count == 0)
                        {
                            <span style="color:var(--ink-faint)">—</span>
                        }
                    </div>
                }
            </div>
        </section>
                    break;
                case LandingSections.Instructors:
        <section class="pub-section" id="instructors">
            <h2>@(_settings?.TaglineInstructors ?? "INSTRUCTORS")</h2>
            <div class="pub-coaches">
                @foreach (var coach in _instructors)
                {
                    @* Portraits are PUBLIC for instructors (#137, ADR 0003). *@
                    <a class="patch pub-coach" href="/@_gym.Slug?instructor=@coach.Person.Id#instructors">
                        @if (GymStation.Domain.People.InstructorPortraits.PubliclyVisible(coach.Person))
                        {
                            <span class="avatar" style="display:block"><img src="/media/instructor-portrait/@_gym.Id/@coach.Person.Id" alt="Portrait of @coach.Person.DisplayName" /></span>
                        }
                        else
                        {
                            <span class="avatar" style="display:block" role="img" aria-label="Portrait placeholder"></span>
                        }
                        <b style="display:block;margin-top:0.5rem">@coach.Person.DisplayName</b>
                        @if (coach.Profile?.ExperienceSummary is { } experience)
                        {
                            <i style="display:block;font:0.5625rem/1.6 var(--font-mono);color:var(--ink-faint);font-style:normal;letter-spacing:.06em">@experience.ToUpperInvariant()</i>
                        }
                    </a>
                }
            </div>
        </section>
                    break;
                case LandingSections.Stories:
                    <section class="pub-section" id="stories">
                        <h2>@(_settings?.StoriesTitle ?? "SUCCESS STORIES")</h2>
                        @if (_settings?.StoriesImagePath is { } storiesImage)
                        {
                            <img class="pub-stories-img" src="/media/@storiesImage" alt="" />
                        }
                        <div class="pub-stories">
                            @foreach (var story in _stories)
                            {
                                <div class="pub-story">
                                    <MarkdownBlock Text="@story.Body" />
                                    @if (story.AttributedTo is { } by)
                                    {
                                        <p class="cap" style="margin-top:0.375rem">— @by.ToUpperInvariant()</p>
                                    }
                                </div>
                            }
                        </div>
                    </section>
                    break;
                case LandingSections.Visit:
        <section class="pub-section" id="visit">
            <h2>@(_settings?.TaglineVisit ?? "VISIT")</h2>
            @if (_settings is { } vs && (vs.VisitAddress ?? vs.VisitPhone ?? vs.VisitEmail ?? vs.SocialInstagram ?? vs.SocialFacebook ?? vs.SocialYouTube ?? vs.SocialTikTok ?? vs.SocialX) is not null)
            {
                <div class="patch">
                    @if (vs.VisitAddress is { } address)
                    {
                        <p class="mono" style="margin:0 0 0.375rem">@address.ToUpperInvariant()</p>
                    }
                    @if (vs.VisitPhone is { } phone)
                    {
                        <p class="mono" style="margin:0 0 0.375rem"><a href="tel:@Uri.EscapeDataString(phone)">@phone</a></p>
                    }
                    @if (vs.VisitEmail is { } visitEmail)
                    {
                        <p class="mono" style="margin:0 0 0.375rem"><a href="mailto:@Uri.EscapeDataString(visitEmail)">@visitEmail.ToUpperInvariant()</a></p>
                    }
                    @* Brand icon row (#125) — the flex gap is the separator, so links can
                       never run together the way the old whitespace-only <text> did.
                       Render-side guard still applies: pre-existing bad data must never link. *@
                    <div class="pub-socials">
                        @if (SafeHttpUrl(vs.SocialInstagram) is { } ig)
                        {
                            <a class="soc soc--instagram" href="@ig" rel="noopener noreferrer" target="_blank" aria-label="Instagram" title="Instagram">
                                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><rect x="2" y="2" width="12" height="12" rx="3.5" /><circle cx="8" cy="8" r="2.9" /><circle cx="11.7" cy="4.3" r="0.4" fill="currentColor" stroke="none" /></svg>
                            </a>
                        }
                        @if (SafeHttpUrl(vs.SocialFacebook) is { } fb)
                        {
                            <a class="soc soc--facebook" href="@fb" rel="noopener noreferrer" target="_blank" aria-label="Facebook" title="Facebook">
                                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><path d="M9.75 14V8.75h2.1M9.75 8.75V6.4a2.15 2.15 0 0 1 2.15-2.15h.85M9.75 8.75H7.1" /></svg>
                            </a>
                        }
                        @if (SafeHttpUrl(vs.SocialYouTube) is { } yt)
                        {
                            <a class="soc soc--youtube" href="@yt" rel="noopener noreferrer" target="_blank" aria-label="YouTube" title="YouTube">
                                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><rect x="1.5" y="4" width="13" height="8.5" rx="2.5" /><path d="M6.9 6.35l3.2 1.9-3.2 1.9z" fill="currentColor" stroke="none" /></svg>
                            </a>
                        }
                        @if (SafeHttpUrl(vs.SocialTikTok) is { } tk)
                        {
                            <a class="soc soc--tiktok" href="@tk" rel="noopener noreferrer" target="_blank" aria-label="TikTok" title="TikTok">
                                @* The chromatic-offset note: cyan/red echoes under an ink core. *@
                                <svg viewBox="0 0 16 16" fill="none" stroke-width="1.5" aria-hidden="true" focusable="false">
                                    <g stroke="#25F4EE" transform="translate(-0.55 -0.55)"><path d="M9.6 3.2v6.9a2.6 2.6 0 1 1-2.6-2.6" /><path d="M9.6 4.7c.65 1.25 1.85 2.05 3.2 2.15" /></g>
                                    <g stroke="#FE2C55" transform="translate(0.55 0.55)"><path d="M9.6 3.2v6.9a2.6 2.6 0 1 1-2.6-2.6" /><path d="M9.6 4.7c.65 1.25 1.85 2.05 3.2 2.15" /></g>
                                    <g stroke="currentColor"><path d="M9.6 3.2v6.9a2.6 2.6 0 1 1-2.6-2.6" /><path d="M9.6 4.7c.65 1.25 1.85 2.05 3.2 2.15" /></g>
                                </svg>
                            </a>
                        }
                        @if (SafeHttpUrl(vs.SocialX) is { } xu)
                        {
                            <a class="soc soc--x" href="@xu" rel="noopener noreferrer" target="_blank" aria-label="X" title="X">
                                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false"><path d="M3 2.5l10 11" /><path d="M13 2.5L8.9 7.1M7.1 9.1L3 13.5" /></svg>
                            </a>
                        }
                    </div>
                </div>
            }
            else
            {
                <p class="cap" style="margin:0">DROP IN — FIRST CLASS IS ON THE MAT. ASK ANY COACH.</p>
            }

            @* Contact rides with Visit (#138). The trap field is invisible to
               humans; the protected ts dates the render for the min-time check. *@
            <h3 class="pub-contact-h">GET IN TOUCH</h3>
            @if (Sent == 1)
            {
                <p class="auth-ok" role="status">MESSAGE SENT — WE'LL GET BACK TO YOU.</p>
            }
            else if (ContactErr is not null)
            {
                <p class="auth-error" role="alert">THAT DIDN'T GO THROUGH — CHECK THE FIELDS (EMAIL OR PHONE, AT LEAST ONE) AND TRY AGAIN.</p>
            }
            <form method="post" action="/public-actions/contact" class="patch pub-contact">
                <AntiforgeryToken />
                <input type="hidden" name="gymId" value="@_gym.Id" />
                <input type="hidden" name="ts" value="@_contactTs" />
                <div class="pub-contact-trap" aria-hidden="true">
                    <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
                </div>
                <div class="form-grid">
                    <div>
                        <label for="cfn">First name</label>
                        <input id="cfn" type="text" name="firstName" required maxlength="80" autocomplete="given-name" />
                    </div>
                    <div>
                        <label for="cln">Last name</label>
                        <input id="cln" type="text" name="lastName" required maxlength="80" autocomplete="family-name" />
                    </div>
                    <div>
                        <label for="cem">Email</label>
                        <input id="cem" type="email" name="email" maxlength="200" autocomplete="email" />
                    </div>
                    <div>
                        <label for="cph">Phone</label>
                        <input id="cph" type="tel" name="phone" maxlength="20" autocomplete="tel" data-phone-mask />
                    </div>
                </div>
                <label for="cmsg">Message</label>
                <textarea id="cmsg" name="message" rows="4" required minlength="10" maxlength="2000"></textarea>
                <p class="cap" style="margin-top:0.25rem">EMAIL OR PHONE — AT LEAST ONE.</p>
                <p style="margin-top:0.625rem"><button class="btn" type="submit">SEND MESSAGE</button></p>
            </form>
        </section>
                    break;
            }
        }

        @if (_openInstructor is { } openCoach)
        {
            <div class="modal-wrap" role="dialog" aria-modal="true" aria-label="@openCoach.Person.DisplayName">
                <a class="modal-scrim" href="/@_gym.Slug#instructors" aria-label="Close instructor card"></a>
                <div class="modal-card">
                    <div class="head-row">
                        <h2 class="section-h" style="margin:0">@openCoach.Person.DisplayName.ToUpperInvariant()</h2>
                        <a class="btn btn--ghost btn--xs" href="/@_gym.Slug#instructors">✕ CLOSE</a>
                    </div>
                    @if (GymStation.Domain.People.InstructorPortraits.PubliclyVisible(openCoach.Person))
                    {
                        <img class="pub-coach-photo" src="/media/instructor-portrait/@_gym.Id/@openCoach.Person.Id" alt="Portrait of @openCoach.Person.DisplayName" />
                    }
                    @if (openCoach.Rank is { } coachRank)
                    {
                        <div style="margin-top:0.625rem">
                            <BeltBar Size="s" BandColorHex="@coachRank.BandColorHex" BarColorHex="@coachRank.BarColorHex"
                                     Stripes="@openCoach.Stripes" Label="@($"{coachRank.Name}, {openCoach.Stripes} stripes")" />
                        </div>
                    }
                    @if (openCoach.Profile?.ExperienceSummary is { } coachExperience)
                    {
                        <p class="cap" style="margin-top:0.375rem">@coachExperience.ToUpperInvariant()</p>
                    }
                    @if (openCoach.Profile?.Bio is { } coachBio)
                    {
                        <div style="margin-top:0.625rem;color:var(--ink-dim)"><MarkdownBlock Text="@coachBio" /></div>
                    }
                    @if (openCoach.Profile?.Hobbies is { } coachHobbies)
                    {
                        <p class="cap" style="margin-top:0.5rem">OFF THE MAT: @coachHobbies.ToUpperInvariant()</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_settings?.AboutText))
                    {
                        @* The gym's About text repeats here by decision 12. *@
                        <div style="margin-top:0.625rem;border-top:1px dashed var(--edge);padding-top:0.625rem;color:var(--ink-faint)"><MarkdownBlock Text="@_settings!.AboutText" /></div>
                    }
                </div>
            </div>
        }

        @if (_openProgram is { } openProgram)
        {
            @* SSR modal, ?program= — the exact ?edit= idiom the schedule uses. *@
            <div class="modal-wrap" role="dialog" aria-modal="true" aria-label="@openProgram.Title">
                <a class="modal-scrim" href="/@_gym.Slug#programs" aria-label="Close program"></a>
                <div class="modal-card">
                    <div class="head-row">
                        <h2 class="section-h" style="margin:0">@openProgram.Title.ToUpperInvariant()</h2>
                        <a class="btn btn--ghost btn--xs" href="/@_gym.Slug#programs">✕ CLOSE</a>
                    </div>
                    @if (openProgram.ImagePath is not null)
                    {
                        <img class="pub-prog-hero" src="/media/@openProgram.ImagePath" alt="@openProgram.Title" />
                    }
                    <div style="margin-top:0.625rem"><MarkdownBlock Text="@openProgram.Description" /></div>
                </div>
            </div>
        }

        <footer class="pub-foot">
            <span>© @DateTime.Today.Year @_gym.Name.ToUpperInvariant()</span>
            <span class="foot-lock"><BrandMark Ink Size="1.25rem" /> POWERED BY GYMSTATION</span>
            <PlatformFooter />
        </footer>
    </div>
}

@code {
    [Parameter] public string Slug { get; set; } = "";

    [CascadingParameter] public HttpContext? HttpContext { get; set; }

    private string? _signedInEmail;
    private string _portalPath = "/schedule";
    private Gym? _gym;
    private GymSettings? _settings;
    private List<string> _visibleSections = [];
    private List<GymStation.Domain.Marketing.GymProgram> _programs = [];
    private GymStation.Domain.Marketing.GymProgram? _openProgram;
    private List<GymStation.Domain.Marketing.SuccessStory> _stories = [];

    [SupplyParameterFromQuery(Name = "program")] public string? ProgramRaw { get; set; }
    private string _accent = "#C9503B";
    private bool _dark = true;
    private List<KeyValuePair<DayOfWeek, List<ClassTemplate>>> _week = [];
    private sealed record Coach(Person Person, StaffProfile? Profile, Rank? Rank, int Stripes);
    private List<Coach> _instructors = [];
    private Coach? _openInstructor;

    [SupplyParameterFromQuery(Name = "instructor")] public string? InstructorRaw { get; set; }
    [SupplyParameterFromQuery(Name = "sent")] public int? Sent { get; set; }
    [SupplyParameterFromQuery(Name = "contact")] public string? ContactErr { get; set; }
    private string _contactTs = "";

    // Empty sections hide themselves (#134); programs and stories additionally
    // stay hidden until #135/#136 give them a data source. Visit stays — its
    // DROP IN fallback is the page's call to action even for a bare gym.
    private bool SectionVisible(string key) => key switch
    {
        LandingSections.About => !string.IsNullOrWhiteSpace(_settings?.AboutText),
        LandingSections.Programs => _programs.Count > 0,
        LandingSections.Stories => _stories.Count > 0,
        LandingSections.Schedule => _week.Any(day => day.Value.Count > 0),
        LandingSections.Instructors => _instructors.Count > 0,
        _ => true,
    };

    private string LabelFor(string key) => key switch
    {
        LandingSections.About => _settings?.AboutTitle ?? "ABOUT",
        LandingSections.Programs => _settings?.ProgramsTitle ?? "PROGRAMS",
        LandingSections.Schedule => _settings?.TaglineSchedule ?? "SCHEDULE",
        LandingSections.Instructors => _settings?.TaglineInstructors ?? "INSTRUCTORS",
        LandingSections.Stories => _settings?.StoriesTitle ?? "SUCCESS STORIES",
        LandingSections.Visit => _settings?.TaglineVisit ?? "VISIT",
        _ => key.ToUpperInvariant(),
    };

    private static string? SafeHttpUrl(string? raw)
        => Uri.TryCreate(raw, UriKind.Absolute, out var uri)
            && (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps)
            ? raw
            : null;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _gym = await db.Gyms.SingleOrDefaultAsync(g => g.Slug == Slug.ToLowerInvariant());
        if (_gym is null)
        {
            return;
        }

        // The visitor's own active gym (claim-hydrated by the middleware) — captured
        // BEFORE the slug overrides the tenant, so "back to your portal" routes by
        // where they belong, not by whichever gym's page they're looking at.
        var activeGymId = Tenant.CurrentGymId;

        // The slug is the tenant for everything this page renders.
        Tenant.SetGym(_gym.Id);

        // A signed-in visitor gets their identity and a way back to their portal
        // instead of a sign-in button they don't need.
        if (HttpContext?.User.Identity?.IsAuthenticated == true)
        {
            _signedInEmail = HttpContext.User.Identity.Name;
            var raw = HttpContext.User.FindFirstValue(ClaimTypes.NameIdentifier);
            if (Guid.TryParse(raw, out var userId))
            {
                _portalPath = await Memberships.LandingPathAsync(userId, activeGymId ?? _gym.Id);
            }
        }

        _settings = await db.GymSettings.SingleOrDefaultAsync();
        _contactTs = DataProtection.CreateProtector(GymStation.Web.PublicActions.ContactEndpoints.TsPurpose)
            .Protect(DateTimeOffset.UtcNow.ToUnixTimeMilliseconds().ToString());
        if (_settings is not null)
        {
            if (ThemeMath.TryParseHexColor(_settings.AccentColorHex, out _))
            {
                _accent = _settings.AccentColorHex;
            }

            _dark = _settings.DefaultThemeDark;
        }

        var templates = await db.ClassTemplates.Where(t => t.Active).OrderBy(t => t.StartTime).ToListAsync();
        _week = Enum.GetValues<DayOfWeek>()
            .OrderBy(d => (int)d) // Sunday first — the product-wide week start (#126)
            .Select(d => new KeyValuePair<DayOfWeek, List<ClassTemplate>>(d, templates.Where(t => t.Day == d).ToList()))
            .ToList();

        // Bios only — pay data has no public representation anywhere.
        var instructorPersons = await db.Persons
            .Where(p => !p.Archived && p.Roles.HasFlag(PersonRoles.Instructor))
            .OrderBy(p => p.FirstName)
            .ToListAsync();
        // Profiles now cover admins/owners/staff too — fetch only the instructors'.
        var instructorIds = instructorPersons.Select(p => p.Id).ToList();
        var profiles = await db.StaffProfiles
            .Where(p => instructorIds.Contains(p.PersonId))
            .ToDictionaryAsync(p => p.PersonId, p => p);

        // Latest award per instructor = the belt on the public modal (#137).
        // Rank colors come from Rank data and are never tenant-themed.
        var awards = await db.RankAwards
            .Include(a => a.Rank)
            .Where(a => instructorIds.Contains(a.PersonId))
            .ToListAsync();
        var currentRanks = awards
            .GroupBy(a => a.PersonId)
            .ToDictionary(
                g => g.Key,
                g => g.OrderByDescending(a => a.AwardedOn).ThenByDescending(a => a.Stripes).First());

        _instructors = instructorPersons
            .Select(p => new Coach(
                p,
                profiles.GetValueOrDefault(p.Id),
                currentRanks.GetValueOrDefault(p.Id)?.Rank,
                currentRanks.GetValueOrDefault(p.Id)?.Stripes ?? 0))
            .ToList();

        if (Guid.TryParse(InstructorRaw, out var instructorId))
        {
            _openInstructor = _instructors.FirstOrDefault(c => c.Person.Id == instructorId);
        }

        // Programs (#135): active only, admin order; the modal resolves from the
        // same list so an archived or foreign id simply doesn't open.
        _programs = await db.GymPrograms
            .Where(p => !p.Archived)
            .OrderBy(p => p.SortOrder).ThenBy(p => p.Title)
            .ToListAsync();
        if (Guid.TryParse(ProgramRaw, out var programId))
        {
            _openProgram = _programs.FirstOrDefault(p => p.Id == programId);
        }

        _stories = await db.SuccessStories
            .Where(s => !s.Archived)
            .OrderBy(s => s.SortOrder).ThenBy(s => s.Id)
            .ToListAsync();

        // Visibility depends on the data above — compute LAST, or an empty
        // schedule/instructor list could never hide its section (review catch).
        _visibleSections = LandingSections.Normalize(_settings?.SectionOrder).Where(SectionVisible).ToList();
    }
}
