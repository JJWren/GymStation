@page "/{Slug}"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using System.Security.Claims
@using GymStation.Domain.People
@using GymStation.Domain.Scheduling
@using GymStation.Domain.Tenancy
@using GymStation.Infrastructure.Tenancy
@inject IDbContextFactory<GymStationDbContext> DbFactory
@inject GymMembershipService Memberships
@inject TenantContext Tenant

@if (_gym is null)
{
    <PageTitle>GymStation</PageTitle>
    <main class="auth-shell">
        <h1>GYMSTATION</h1>
        <p class="tagline">NO GYM AT THIS ADDRESS</p>
        <p class="auth-note">Check the link your gym gave you, or <a href="/login">sign in</a>.</p>
    </main>
}
else
{
    <PageTitle>@_gym.Name — Schedule &amp; Instructors</PageTitle>
    <HeadContent>
        <meta name="description" content="@($"{_gym.Name}: weekly schedule, instructors, and how to visit.")" />
    </HeadContent>

    @* Tenant accent AND the gym's default mode apply to the public face too. *@
    <div class="@(_dark ? null : "theme-light")" style="--tenant:@_accent">
        <header class="pub-hero" style="@(_settings?.HeroPath is { } hero ? $"background-image:url('/media/{hero}')" : null)">
            <div class="pub-hero-scrim">
                @if (_settings?.LogoPath is { } logo)
                {
                    <img class="pub-crest" src="/media/@logo" alt="@_gym.Name logo" />
                }
                else
                {
                    <div class="pub-crest" role="img" aria-label="@_gym.Name crest" style="background:var(--tenant)"></div>
                }
                <h1>@_gym.Name.ToUpperInvariant()</h1>
                <p class="pub-tag">
                    <a href="#schedule">@(_settings?.TaglineSchedule ?? "SCHEDULE")</a> ·
                    <a href="#instructors">@(_settings?.TaglineInstructors ?? "INSTRUCTORS")</a> ·
                    <a href="#visit">@(_settings?.TaglineVisit ?? "VISIT")</a>
                </p>
                @if (_signedInEmail is { } email)
                {
                    <p class="pub-tag" style="margin:0 0 0.625rem">SIGNED IN AS @email.ToUpperInvariant()</p>
                    <div style="display:flex;gap:0.5rem;flex-wrap:wrap">
                        <a class="btn" href="@_portalPath">BACK TO YOUR PORTAL</a>
                        <form method="post" action="/auth/logout" style="margin:0">
                            <AntiforgeryToken />
                            <button class="btn btn--ghost" type="submit">SIGN OUT</button>
                        </form>
                    </div>
                }
                else
                {
                    <a class="btn" href="/login">MEMBER SIGN-IN</a>
                }
            </div>
        </header>

        <section class="pub-strip" id="schedule">
            <h2>THIS WEEK AT @_gym.Name.ToUpperInvariant() — LIVE</h2>
            <div class="pub-days">
                @foreach (var day in _week)
                {
                    <div class="pub-day">
                        <b>@day.Key.ToString().ToUpperInvariant()[..3]</b>
                        @foreach (var template in day.Value)
                        {
                            <span>@template.StartTime.ToString("HH\\:mm") @template.Name.ToUpperInvariant()</span>
                        }
                        @if (day.Value.Count == 0)
                        {
                            <span style="color:var(--ink-faint)">—</span>
                        }
                    </div>
                }
            </div>
        </section>

        <section class="pub-section" id="instructors">
            <h2>INSTRUCTORS</h2>
            <div class="pub-coaches">
                @foreach (var (person, experience) in _instructors)
                {
                    <div class="patch">
                        <div class="avatar" role="img" aria-label="Portrait placeholder"></div>
                        <b style="display:block;margin-top:0.5rem">@person.DisplayName</b>
                        @if (experience is not null)
                        {
                            <i style="display:block;font:0.5625rem/1.6 var(--font-mono);color:var(--ink-faint);font-style:normal;letter-spacing:.06em">@experience.ToUpperInvariant()</i>
                        }
                    </div>
                }
            </div>
        </section>

        <section class="pub-section" id="visit">
            <h2>@(_settings?.TaglineVisit ?? "VISIT")</h2>
            @if (_settings is { } vs && (vs.VisitAddress ?? vs.VisitPhone ?? vs.VisitEmail ?? vs.SocialInstagram ?? vs.SocialFacebook ?? vs.SocialYouTube ?? vs.SocialTikTok ?? vs.SocialX) is not null)
            {
                <div class="patch">
                    @if (vs.VisitAddress is { } address)
                    {
                        <p class="mono" style="margin:0 0 0.375rem">@address.ToUpperInvariant()</p>
                    }
                    @if (vs.VisitPhone is { } phone)
                    {
                        <p class="mono" style="margin:0 0 0.375rem"><a href="tel:@Uri.EscapeDataString(phone)">@phone</a></p>
                    }
                    @if (vs.VisitEmail is { } visitEmail)
                    {
                        <p class="mono" style="margin:0 0 0.375rem"><a href="mailto:@Uri.EscapeDataString(visitEmail)">@visitEmail.ToUpperInvariant()</a></p>
                    }
                    @* Brand icon row (#125) — the flex gap is the separator, so links can
                       never run together the way the old whitespace-only <text> did.
                       Render-side guard still applies: pre-existing bad data must never link. *@
                    <div class="pub-socials">
                        @if (SafeHttpUrl(vs.SocialInstagram) is { } ig)
                        {
                            <a class="soc soc--instagram" href="@ig" rel="noopener noreferrer" target="_blank" aria-label="Instagram" title="Instagram">
                                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><rect x="2" y="2" width="12" height="12" rx="3.5" /><circle cx="8" cy="8" r="2.9" /><circle cx="11.7" cy="4.3" r="0.4" fill="currentColor" stroke="none" /></svg>
                            </a>
                        }
                        @if (SafeHttpUrl(vs.SocialFacebook) is { } fb)
                        {
                            <a class="soc soc--facebook" href="@fb" rel="noopener noreferrer" target="_blank" aria-label="Facebook" title="Facebook">
                                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><path d="M9.75 14V8.75h2.1M9.75 8.75V6.4a2.15 2.15 0 0 1 2.15-2.15h.85M9.75 8.75H7.1" /></svg>
                            </a>
                        }
                        @if (SafeHttpUrl(vs.SocialYouTube) is { } yt)
                        {
                            <a class="soc soc--youtube" href="@yt" rel="noopener noreferrer" target="_blank" aria-label="YouTube" title="YouTube">
                                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><rect x="1.5" y="4" width="13" height="8.5" rx="2.5" /><path d="M6.9 6.35l3.2 1.9-3.2 1.9z" fill="currentColor" stroke="none" /></svg>
                            </a>
                        }
                        @if (SafeHttpUrl(vs.SocialTikTok) is { } tk)
                        {
                            <a class="soc soc--tiktok" href="@tk" rel="noopener noreferrer" target="_blank" aria-label="TikTok" title="TikTok">
                                @* The chromatic-offset note: cyan/red echoes under an ink core. *@
                                <svg viewBox="0 0 16 16" fill="none" stroke-width="1.5" aria-hidden="true" focusable="false">
                                    <g stroke="#25F4EE" transform="translate(-0.55 -0.55)"><path d="M9.6 3.2v6.9a2.6 2.6 0 1 1-2.6-2.6" /><path d="M9.6 4.7c.65 1.25 1.85 2.05 3.2 2.15" /></g>
                                    <g stroke="#FE2C55" transform="translate(0.55 0.55)"><path d="M9.6 3.2v6.9a2.6 2.6 0 1 1-2.6-2.6" /><path d="M9.6 4.7c.65 1.25 1.85 2.05 3.2 2.15" /></g>
                                    <g stroke="currentColor"><path d="M9.6 3.2v6.9a2.6 2.6 0 1 1-2.6-2.6" /><path d="M9.6 4.7c.65 1.25 1.85 2.05 3.2 2.15" /></g>
                                </svg>
                            </a>
                        }
                        @if (SafeHttpUrl(vs.SocialX) is { } xu)
                        {
                            <a class="soc soc--x" href="@xu" rel="noopener noreferrer" target="_blank" aria-label="X" title="X">
                                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false"><path d="M3 2.5l10 11" /><path d="M13 2.5L8.9 7.1M7.1 9.1L3 13.5" /></svg>
                            </a>
                        }
                    </div>
                </div>
            }
            else
            {
                <p class="cap" style="margin:0">DROP IN — FIRST CLASS IS ON THE MAT. ASK ANY COACH.</p>
            }
        </section>

        <footer class="pub-foot">
            <span>© @DateTime.Today.Year @_gym.Name.ToUpperInvariant()</span>
            <span>POWERED BY GYMSTATION</span>
            <PlatformFooter />
        </footer>
    </div>
}

@code {
    [Parameter] public string Slug { get; set; } = "";

    [CascadingParameter] public HttpContext? HttpContext { get; set; }

    private string? _signedInEmail;
    private string _portalPath = "/schedule";
    private Gym? _gym;
    private GymSettings? _settings;
    private string _accent = "#C9503B";
    private bool _dark = true;
    private List<KeyValuePair<DayOfWeek, List<ClassTemplate>>> _week = [];
    private List<(Person Person, string? Experience)> _instructors = [];

    private static string? SafeHttpUrl(string? raw)
        => Uri.TryCreate(raw, UriKind.Absolute, out var uri)
            && (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps)
            ? raw
            : null;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _gym = await db.Gyms.SingleOrDefaultAsync(g => g.Slug == Slug.ToLowerInvariant());
        if (_gym is null)
        {
            return;
        }

        // The visitor's own active gym (claim-hydrated by the middleware) — captured
        // BEFORE the slug overrides the tenant, so "back to your portal" routes by
        // where they belong, not by whichever gym's page they're looking at.
        var activeGymId = Tenant.CurrentGymId;

        // The slug is the tenant for everything this page renders.
        Tenant.SetGym(_gym.Id);

        // A signed-in visitor gets their identity and a way back to their portal
        // instead of a sign-in button they don't need.
        if (HttpContext?.User.Identity?.IsAuthenticated == true)
        {
            _signedInEmail = HttpContext.User.Identity.Name;
            var raw = HttpContext.User.FindFirstValue(ClaimTypes.NameIdentifier);
            if (Guid.TryParse(raw, out var userId))
            {
                _portalPath = await Memberships.LandingPathAsync(userId, activeGymId ?? _gym.Id);
            }
        }

        _settings = await db.GymSettings.SingleOrDefaultAsync();
        if (_settings is not null)
        {
            if (ThemeMath.TryParseHexColor(_settings.AccentColorHex, out _))
            {
                _accent = _settings.AccentColorHex;
            }

            _dark = _settings.DefaultThemeDark;
        }

        var templates = await db.ClassTemplates.Where(t => t.Active).OrderBy(t => t.StartTime).ToListAsync();
        _week = Enum.GetValues<DayOfWeek>()
            .OrderBy(d => (int)d) // Sunday first — the product-wide week start (#126)
            .Select(d => new KeyValuePair<DayOfWeek, List<ClassTemplate>>(d, templates.Where(t => t.Day == d).ToList()))
            .ToList();

        // Bios only — pay data has no public representation anywhere.
        var instructorPersons = await db.Persons
            .Where(p => !p.Archived && p.Roles.HasFlag(PersonRoles.Instructor))
            .OrderBy(p => p.FirstName)
            .ToListAsync();
        // Profiles now cover admins/owners/staff too — fetch only the instructors'.
        var instructorIds = instructorPersons.Select(p => p.Id).ToList();
        var profiles = await db.StaffProfiles
            .Where(p => instructorIds.Contains(p.PersonId))
            .ToDictionaryAsync(p => p.PersonId, p => p.ExperienceSummary);
        _instructors = instructorPersons.Select(p => (p, profiles.GetValueOrDefault(p.Id))).ToList();
    }
}
