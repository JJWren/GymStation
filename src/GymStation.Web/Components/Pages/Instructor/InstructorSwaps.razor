@page "/instructor/swaps"
@* Staff oversight only (#95): instructors accept and claim covers right on
   /schedule now — this page audits and gate-keeps. *@
@attribute [Authorize(Policy = "GymStaff")]
@layout AdminLayout
@using System.Security.Claims
@using GymStation.Domain.Scheduling
@inject IDbContextFactory<GymStationDbContext> DbFactory
@inject GymStation.Infrastructure.Scheduling.ScheduleService Schedule

<PageTitle>Substitutions · GymStation</PageTitle>

<h1 class="page-title">SUBSTITUTIONS</h1>
<p class="page-sub">REQUEST COVER FOR YOUR SESSIONS · CLAIM OPEN REQUESTS · ACCEPT ONES NAMED TO YOU</p>

@if (Failed)
{
    <p class="auth-error" role="alert">That action couldn't be completed — the request may have changed state, or open claims are disabled.</p>
}

<div class="detail-cols" style="display:grid;grid-template-columns:1fr 1fr;gap:1.125rem;align-items:start">
    <section>
        <h2 class="section-h">My upcoming sessions — request cover</h2>
        @if (_mySessions.Count == 0)
        {
            <p class="cap">NO UPCOMING SESSIONS ASSIGNED TO YOU IN THE NEXT 14 DAYS.</p>
        }
        @foreach (var session in _mySessions)
        {
            <div class="form-card" style="margin-bottom:0.625rem">
                <b>@session.Name · @session.Date.ToString("ddd dd MMM").ToUpperInvariant() @session.StartTime.ToString("HH\\:mm")</b>
                <a class="chip" href="/instructor/roll/@session.Id" style="margin-left:0.5rem">LIVE ROLL →</a>
                <form method="post" action="/instructor/actions/request-sub" class="row-form" style="margin-top:0.5rem">
                    <AntiforgeryToken />
                    <input type="hidden" name="sessionId" value="@session.Id" />
                    <select name="proposedSubPersonId" aria-label="Proposed substitute">
                        <option value="">OPEN — anyone can claim</option>
                        @foreach (var (id, name) in _otherInstructors)
                        {
                            <option value="@id">@name</option>
                        }
                    </select>
                    <button type="submit" class="btn btn--ghost btn--xs">MARK ME OUT</button>
                </form>
            </div>
        }

        <h2 class="section-h">My requests</h2>
        @foreach (var request in _myRequests)
        {
            <div class="form-card" style="margin-bottom:0.625rem">
                <b>@request.Session.Name · @request.Session.Date.ToString("ddd dd MMM").ToUpperInvariant()</b>
                <span class="stamp stamp--dim">@request.Status.ToString().ToUpperInvariant()</span>
                @if (request.Status is SubstitutionStatus.Requested or SubstitutionStatus.PendingApproval)
                {
                    <form method="post" action="/instructor/actions/withdraw-sub" class="row-form">
                        <AntiforgeryToken />
                        <input type="hidden" name="requestId" value="@request.Id" />
                        <button type="submit" class="btn btn--ghost btn--xs">WITHDRAW</button>
                    </form>
                }
            </div>
        }
    </section>

    <section>
        <h2 class="section-h">Claimable + named to me</h2>
        @if (_actionable.Count == 0)
        {
            <p class="cap">NOTHING WAITING ON YOU.</p>
        }
        @foreach (var request in _actionable)
        {
            <div class="form-card" style="margin-bottom:0.625rem">
                <b>@request.Session.Name · @request.Session.Date.ToString("ddd dd MMM").ToUpperInvariant() @request.Session.StartTime.ToString("HH\\:mm")</b>
                <p class="cap" style="margin:0.25rem 0 0.5rem">
                    @(request.ProposedSubPersonId is null ? "OPEN REQUEST" : "NAMED TO YOU") ·
                    REQUESTED BY @_names.GetValueOrDefault(request.RequestedByPersonId, "?").ToUpperInvariant()
                </p>
                <form method="post" action="/instructor/actions/accept-sub" class="row-form">
                    <AntiforgeryToken />
                    <input type="hidden" name="requestId" value="@request.Id" />
                    <button type="submit" class="btn btn--xs">@(request.ProposedSubPersonId is null ? "CLAIM THIS SESSION" : "ACCEPT")</button>
                </form>
            </div>
        }
    </section>
</div>

@code {
    [SupplyParameterFromQuery(Name = "failed")] public int? FailedFlag { get; set; }
    private bool Failed => FailedFlag == 1;

    [CascadingParameter] public HttpContext? HttpContext { get; set; }

    private Guid _myPersonId;
    private List<ClassSession> _mySessions = [];
    private List<SubstitutionRequest> _myRequests = [];
    private List<SubstitutionRequest> _actionable = [];
    private List<(Guid Id, string Name)> _otherInstructors = [];
    private Dictionary<Guid, string> _names = [];

    protected override async Task OnInitializedAsync()
    {
        var raw = HttpContext?.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (!Guid.TryParse(raw, out var userId))
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var me = await db.Persons.SingleOrDefaultAsync(p => p.UserId == userId && !p.Archived);
        if (me is null)
        {
            return;
        }

        _myPersonId = me.Id;

        var today = DateOnly.FromDateTime(DateTime.Today);
        await Schedule.GetWeekAsync(Weeks.WeekOf(today));
        await Schedule.GetWeekAsync(Weeks.WeekOf(today).AddDays(7));

        _mySessions = await db.ClassSessions
            .Where(s => s.InstructorPersonId == _myPersonId && s.Status == SessionStatus.Scheduled
                && s.Date >= today && s.Date <= today.AddDays(14))
            .OrderBy(s => s.Date).ThenBy(s => s.StartTime)
            .ToListAsync();

        var open = await db.SubstitutionRequests
            .Include(r => r.Session)
            .Where(r => r.Status == SubstitutionStatus.Requested || r.Status == SubstitutionStatus.PendingApproval)
            .OrderBy(r => r.Session.Date)
            .ToListAsync();

        _myRequests = open.Where(r => r.RequestedByPersonId == _myPersonId).ToList();
        _actionable = open.Where(r => r.Status == SubstitutionStatus.Requested
            && r.RequestedByPersonId != _myPersonId
            && (r.ProposedSubPersonId == null || r.ProposedSubPersonId == _myPersonId)).ToList();

        var instructorPersons = await db.Persons
            .Where(p => !p.Archived && p.Id != _myPersonId && p.Roles.HasFlag(PersonRoles.Instructor))
            .OrderBy(p => p.FirstName).ToListAsync();
        _otherInstructors = instructorPersons.Select(p => (p.Id, p.DisplayName)).ToList();

        var nameIds = open.Select(r => r.RequestedByPersonId).Distinct().ToList();
        _names = await db.Persons.Where(p => nameIds.Contains(p.Id)).ToDictionaryAsync(p => p.Id, p => p.DisplayName);
    }
}
