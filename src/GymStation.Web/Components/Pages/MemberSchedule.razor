@page "/schedule"
@attribute [Authorize]
@layout MemberLayout
@using System.Security.Claims
@using GymStation.Domain.Attendance
@using GymStation.Domain.Scheduling
@using GymStation.Domain.Tenancy
@inject IDbContextFactory<GymStationDbContext> DbFactory
@inject GymStation.Infrastructure.Scheduling.ScheduleService Schedule
@inject ITenantContext Tenant

<PageTitle>Schedule · GymStation</PageTitle>

<main class="member-shell">
    <div class="daynav">
        <a href="@($"/schedule?date={_date.AddDays(-1):yyyy-MM-dd}")" aria-label="Previous day">◀</a>
        <span>@_date.ToString("ddd · dd MMM").ToUpperInvariant()</span>
        <a href="@($"/schedule?date={_date.AddDays(1):yyyy-MM-dd}")" aria-label="Next day">▶</a>
    </div>

    <div class="filters">
        <a class="chip @(Type is null ? "active" : null)" href="@($"/schedule?date={_date:yyyy-MM-dd}")">all</a>
        @foreach (var type in _types)
        {
            <a class="chip @(Type == type.Name ? "active" : null)"
               href="@($"/schedule?date={_date:yyyy-MM-dd}&type={Uri.EscapeDataString(type.Name)}")"
               style="@(Type == type.Name ? $"border-color:{type.ColorHex};color:{type.ColorHex}" : null)">@type.Name</a>
        }
    </div>

    @if (Failed)
    {
        <p class="auth-error" role="alert">That check-in couldn't be recorded — the window may be closed.</p>
    }

    @if (_sessions.Count == 0)
    {
        <p class="cap">NO SESSIONS ON THIS DAY@(Type is null ? null : " FOR THAT TAG").</p>
    }
    @foreach (var session in _sessions)
    {
        <div class="ses @(session.Status == SessionStatus.Cancelled ? "ses--cancelled" : null)" style="margin-bottom:0.625rem">
            <div class="head-row">
                <span class="t">@session.StartTime.ToString("HH\\:mm")</span>
                <span>
                    @foreach (var type in session.ClassTypes)
                    {
                        <span class="tag" style="border-color:@type.ColorHex;color:@type.ColorHex">@type.Name</span>
                    }
                </span>
            </div>
            <div class="n" style="font-size:1rem">@session.Name</div>
            <div class="c">@(_names.GetValueOrDefault(session.InstructorPersonId ?? Guid.Empty, "UNASSIGNED").ToUpperInvariant()) · @session.DurationMinutes MIN</div>
            @if (session.InstructorPersonId is { } instructorId && _minePersonIds.Contains(instructorId))
            {
                <p style="margin:0.375rem 0 0"><span class="stamp stamp--ok">YOU TEACH</span> <a class="chip" href="/instructor/roll/@session.Id">LIVE ROLL →</a></p>
            }
            @if (session.Status == SessionStatus.Cancelled)
            {
                <span class="stamp stamp--bad">CANCELLED</span>
            }
            else
            {
                @foreach (var person in _checkable)
                {
                    var record = _records.GetValueOrDefault((session.Id, person.Id));
                    <div class="row-form">
                        @* Name the row whenever it isn't the signed-in user's own record —
                           a guardian's single child must never read as self-check-in. *@
                        @if (_checkable.Count > 1 || person.UserId != _userId)
                        {
                            <span class="mono">@person.FirstName</span>
                        }
                        @if (record is not null)
                        {
                            <span class="stamp @(record.Status == AttendanceStatus.Confirmed ? "stamp--ok" : record.Status == AttendanceStatus.Pending ? "stamp--warn" : "stamp--bad")">
                                @(record.Status == AttendanceStatus.Pending ? "CHECKED IN · PENDING ROLL" : record.Status.ToString().ToUpperInvariant())
                            </span>
                        }
                        else if (WindowOpen(session))
                        {
                            <form method="post" action="/member/actions/check-in">
                                <AntiforgeryToken />
                                <input type="hidden" name="sessionId" value="@session.Id" />
                                <input type="hidden" name="personId" value="@person.Id" />
                                <input type="hidden" name="date" value="@_date.ToString("yyyy-MM-dd")" />
                                <button class="btn btn--xs" type="submit">CHECK IN</button>
                            </form>
                        }
                        else
                        {
                            <span class="cap" style="margin:0">WINDOW @(BeforeWindow(session) ? $"OPENS {session.StartTime.AddMinutes(-_windowMinutes):HH\\:mm}" : "CLOSED")</span>
                        }
                    </div>
                }
            }
        </div>
    }
</main>

@code {
    [SupplyParameterFromQuery(Name = "date")] public string? DateRaw { get; set; }
    [SupplyParameterFromQuery(Name = "type")] public string? Type { get; set; }
    [SupplyParameterFromQuery(Name = "failed")] public int? FailedFlag { get; set; }
    private bool Failed => FailedFlag == 1;

    [CascadingParameter] public HttpContext? HttpContext { get; set; }

    private DateOnly _date;
    private List<ClassSession> _sessions = [];
    private List<ClassType> _types = [];
    private Dictionary<Guid, string> _names = [];
    private List<Person> _checkable = [];
    private HashSet<Guid> _minePersonIds = [];
    private Dictionary<(Guid SessionId, Guid PersonId), AttendanceRecord> _records = [];
    private int _windowMinutes = 60;
    private DateTime _gymNow;
    private Guid _userId;

    protected override async Task OnInitializedAsync()
    {
        _date = DateOnly.TryParse(DateRaw, out var parsed) ? parsed : DateOnly.FromDateTime(DateTime.Today);
        await using var db = await DbFactory.CreateDbContextAsync();

        var diff = ((int)_date.DayOfWeek + 6) % 7;
        var sessions = (await Schedule.GetWeekAsync(_date.AddDays(-diff))).Where(s => s.Date == _date);

        _types = await db.ClassTypes.Where(t => !t.Archived).OrderBy(t => t.Name).ToListAsync();

        _sessions = sessions
            .Where(s => Type == null || s.ClassTypes.Any(t => t.Name == Type))
            .OrderBy(s => s.StartTime)
            .ToList();

        var ids = _sessions.Where(s => s.InstructorPersonId != null).Select(s => s.InstructorPersonId!.Value).Distinct().ToList();
        _names = await db.Persons.Where(p => ids.Contains(p.Id)).ToDictionaryAsync(p => p.Id, p => p.DisplayName);

        var settings = await db.GymSettings.SingleOrDefaultAsync();
        _windowMinutes = settings?.CheckInWindowMinutes ?? 60;

        if (Tenant.CurrentGymId is { } gymId)
        {
            var gym = await db.Gyms.SingleAsync(g => g.Id == gymId);
            var zone = TimeZoneInfo.FindSystemTimeZoneById(gym.TimeZoneId);
            _gymNow = TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, zone).DateTime;
        }

        var raw = HttpContext?.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (Guid.TryParse(raw, out var userId))
        {
            _userId = userId;
            var mine = await db.Persons.Where(p => p.UserId == userId && !p.Archived).ToListAsync();
            var childIds = await db.FamilyGuardians
                .Where(g => g.GuardianUserId == userId && g.ActForWards)
                .Join(db.FamilyMembers.Where(m => m.IsWard), g => g.FamilyId, m => m.FamilyId, (g, m) => m.PersonId)
                .ToListAsync();
            var children = await db.Persons.Where(p => childIds.Contains(p.Id) && !p.Archived).ToListAsync();
            _checkable = [.. mine, .. children];
            _minePersonIds = mine.Select(p => p.Id).ToHashSet();

            var checkableIds = _checkable.Select(p => p.Id).ToList();
            var sessionIds = _sessions.Select(s => s.Id).ToList();
            _records = await db.AttendanceRecords
                .Where(a => sessionIds.Contains(a.SessionId) && checkableIds.Contains(a.PersonId))
                .ToDictionaryAsync(a => ValueTuple.Create(a.SessionId, a.PersonId));
        }
    }

    private bool WindowOpen(ClassSession session) => CheckInWindow.IsOpen(session, _gymNow, _windowMinutes);

    private bool BeforeWindow(ClassSession session)
        => _gymNow < session.Date.ToDateTime(session.StartTime).AddMinutes(-_windowMinutes);
}
