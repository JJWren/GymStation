@page "/admin/finance"
@page "/admin/dues"
@attribute [Authorize(Policy = "GymStaff")]
@layout AdminLayout
@using GymStation.Domain.Money
@using GymStation.Infrastructure.Money
@inject IDbContextFactory<GymStationDbContext> DbFactory
@inject LedgerService Ledger
@inject NavigationManager Nav

<PageTitle>Finance · GymStation</PageTitle>

<h1 class="page-title">FINANCE</h1>
<p class="page-sub">DUES · PLANS · INCOME · EXPENSES — BALANCES ARE DERIVED (ΣCHARGES − ΣPAYMENTS) · GYMSTATION TRACKS MONEY, IT DOES NOT MOVE IT</p>
<p class="cap">THE MONTHLY CYCLE RUNS ITSELF (EVERY 6 HOURS, IDEMPOTENT) — CHARGES AND RECURRING EXPENSES NEED NO BUTTON.</p>

@if (Failed)
{
    <p class="auth-error" role="alert">That payment couldn't be recorded — the amount must be positive.</p>
}
@if (FailedFlag is 2 or 3 or 4)
{
    <p class="auth-error" role="alert">
        @(FailedFlag == 2
            ? "That change was rejected — amounts must be positive, names/labels unique and in range, notes under 300 characters."
            : FailedFlag == 3
                ? "That category change was rejected — the name must be unique."
                : "That recurring expense was rejected — positive amount, day between 1 and 31.")
    </p>
}

<div class="filters">
    <span class="chip chip--on">$@_summary.CollectedInMonth.ToString("N0") COLLECTED · @_month.ToString("MMM").ToUpperInvariant()</span>
    <span class="chip">$@_summary.Outstanding.ToString("N0") OUTSTANDING</span>
    <span class="chip">@_summary.MembersCurrent CURRENT · @_summary.MembersBehind BEHIND</span>
    <span class="chip">$@_summary.OtherIncomeInMonth.ToString("N0") OTHER INCOME · @_month.ToString("MMM").ToUpperInvariant()</span>
</div>

<div class="detail-cols" style="display:grid;grid-template-columns:1.3fr 1fr;gap:1.125rem;align-items:start">
    <section>
        <h2 class="section-h">Behind on dues — oldest first</h2>
        <form method="get" class="row-form" style="margin:0 0 0.625rem">
            <input type="search" name="q" value="@Q" placeholder="SEARCH NAME…" aria-label="Search members behind on dues" />
            <input type="hidden" name="size" value="@_size" />
            <button class="btn btn--ghost btn--xs" type="submit">SEARCH</button>
        </form>
        @if (_dues.Count == 0)
        {
            <p class="cap">@(string.IsNullOrWhiteSpace(Q) ? "EVERYONE IS CURRENT. STAMP IT [PAID]." : "NO ONE BEHIND MATCHES THAT SEARCH.")</p>
        }
        @foreach (var row in _duesView)
        {
            <div class="form-card" style="margin-bottom:0.5rem">
                <div class="head-row">
                    <b><a href="/admin/people/@row.PersonId">@row.Name</a></b>
                    <span class="stamp stamp--bad">DUE $@row.Balance.ToString("N0")</span>
                </div>
                <p class="cap" style="margin:0.25rem 0 0.5rem">BEHIND SINCE @row.OldestUnpaidSince.ToString("dd MMM yyyy").ToUpperInvariant() · @((DateOnly.FromDateTime(DateTime.Today).DayNumber - row.OldestUnpaidSince.DayNumber)) DAYS</p>
                <form method="post" action="/admin/actions/record-payment" class="row-form">
                    <AntiforgeryToken />
                    <input type="hidden" name="personId" value="@row.PersonId" />
                    <input type="number" name="amount" value="@row.Balance" step="0.01" min="0.01" aria-label="Payment amount" style="width:6.875rem" />
                    <button class="btn btn--xs" type="submit">RECORD PAYMENT</button>
                </form>
            </div>
        }
        @if (_dues.Count > 0)
        {
            <Pager Path="/admin/finance" Page="@_page" PageCount="@_pageCount" Size="@_size"
                   Preserve="@(new Dictionary<string, string?> { ["q"] = Q })" />
        }
    </section>

    <section>
        <h2 class="section-h">Membership plans</h2>
        @foreach (var plan in _plans.Where(p => !p.Archived))
        {
            <div class="form-card" style="margin-bottom:0.5rem">
                <form method="post" action="/admin/actions/update-plan" class="row-form" style="margin:0">
                    <AntiforgeryToken />
                    <input type="hidden" name="planId" value="@plan.Id" />
                    <input type="text" name="name" value="@plan.Name" aria-label="Plan name" required maxlength="80" style="flex:1;min-width:7.5rem" />
                    <input type="number" name="price" value="@plan.Price" step="0.01" min="0" aria-label="Monthly price" style="width:5.625rem" />
                    <button class="btn btn--ghost btn--xs" type="submit">SAVE</button>
                </form>
                <div class="head-row" style="margin-top:0.375rem">
                    <span class="cap" style="margin:0">@plan.Cadence.ToString().ToUpperInvariant()@(plan.Scope == PlanScope.Family ? $" · FAMILY-SCOPE · {_familyPlanCounts.GetValueOrDefault(plan.Id)} FAMILIES" : $" · {_planCounts.GetValueOrDefault(plan.Id)} MEMBERS") · PRICE CHANGES AFFECT FUTURE CYCLES ONLY</span>
                    <form method="post" action="/admin/actions/plan-archived" style="margin:0">
                        <AntiforgeryToken />
                        <input type="hidden" name="planId" value="@plan.Id" />
                        <input type="hidden" name="archived" value="True" />
                        <button class="btn btn--ghost btn--xs" type="submit">ARCHIVE</button>
                    </form>
                </div>
            </div>
        }
        @foreach (var plan in _plans.Where(p => p.Archived))
        {
            <div class="form-card head-row" style="margin-bottom:0.5rem;opacity:.55">
                <span class="mono">@plan.Name.ToUpperInvariant() · $@plan.Price.ToString("N0") · ARCHIVED</span>
                <form method="post" action="/admin/actions/plan-archived" style="margin:0">
                    <AntiforgeryToken />
                    <input type="hidden" name="planId" value="@plan.Id" />
                    <input type="hidden" name="archived" value="False" />
                    <button class="btn btn--ghost btn--xs" type="submit">UNARCHIVE</button>
                </form>
            </div>
        }
        <EditForm class="form-card" FormName="add-plan" Model="PlanForm" OnValidSubmit="AddPlanAsync">
            <div class="form-grid">
                <div>
                    <label for="pname">Plan name</label>
                    <InputText id="pname" @bind-Value="PlanForm!.Name" />
                </div>
                <div>
                    <label for="pprice">Monthly price (0 = comped, raises no charges)</label>
                    <InputNumber id="pprice" @bind-Value="PlanForm!.Price" />
                </div>
            </div>
            <div class="check-row" style="margin-top:0.5rem">
                <label><InputCheckbox @bind-Value="PlanForm!.IsFamilyScope" /> FAMILY PLAN — ONE CHARGE ON THE PRIMARY GUARDIAN, COVERED MEMBERS SKIPPED</label>
            </div>
            @if (_planError is not null)
            {
                <p class="validation-message">@_planError</p>
            }
            <p style="margin-top:0.75rem"><button class="btn btn--ghost" type="submit">+ PLAN</button></p>
        </EditForm>

        <h2 class="section-h">Other income — @_month.ToString("MMMM").ToUpperInvariant()</h2>
        <div class="form-card">
            @foreach (var income in _incomes)
            {
                <div style="border-bottom:1px dashed #2c3440;padding:0.375rem 0">
                    <form method="post" action="/admin/actions/update-income" class="row-form" style="margin:0">
                        <AntiforgeryToken />
                        <input type="hidden" name="incomeId" value="@income.Id" />
                        <input type="text" name="label" value="@income.Label" aria-label="Income label" required maxlength="60" style="flex:1;min-width:6.25rem" />
                        <input type="number" name="amount" value="@income.Amount" step="0.01" min="0.01" aria-label="Amount" style="width:5.25rem" />
                        <input type="date" name="receivedOn" value="@income.ReceivedOn.ToString("yyyy-MM-dd")" aria-label="Received on" />
                        <input type="hidden" name="note" value="@income.Note" />
                        <button class="btn btn--ghost btn--xs" type="submit">SAVE</button>
                        <button class="btn btn--ghost btn--xs" type="submit" formaction="/admin/actions/delete-income" title="Delete this income entry">DELETE</button>
                    </form>
                </div>
            }
            @if (_incomes.Count == 0)
            {
                <p class="cap" style="margin:0 0 0.375rem">NOTHING LOGGED — SEMINARS, MERCH, AND MAT FEES BELONG HERE. DUES PAYMENTS LIVE ABOVE AND NEVER MOVE.</p>
            }
            <div class="head-row" style="padding:0.5rem 0 0">
                <span class="cap">TOTAL</span>
                <b class="mono" style="color:var(--ink)">$@_incomes.Sum(x => x.Amount).ToString("N0")</b>
            </div>
            <form method="post" action="/admin/actions/add-income" class="row-form" style="margin-top:0.5rem">
                <AntiforgeryToken />
                <input type="text" name="label" placeholder="SEMINAR, MERCH…" aria-label="Income label" required maxlength="60" style="flex:1;min-width:6.25rem" />
                <input type="number" name="amount" step="0.01" min="0.01" placeholder="amount" aria-label="Amount" style="width:5.25rem" />
                <input type="date" name="receivedOn" value="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")" aria-label="Received on" />
                <input type="hidden" name="note" value="" />
                <button class="btn btn--ghost btn--xs" type="submit">+ INCOME</button>
            </form>
        </div>

        <h2 class="section-h">Expenses — @_month.ToString("MMMM").ToUpperInvariant()</h2>
        <div class="form-card">
            @foreach (var expense in _expenses)
            {
                <div style="border-bottom:1px dashed #2c3440;padding:0.375rem 0">
                    <form method="post" action="/admin/actions/update-expense" class="row-form" style="margin:0">
                        <AntiforgeryToken />
                        <input type="hidden" name="expenseId" value="@expense.Id" />
                        <select name="categoryId" aria-label="Category">
                            @foreach (var category in _allCategories)
                            {
                                <option value="@category.Id" selected="@(category.Id == expense.CategoryId)">@category.Name</option>
                            }
                        </select>
                        <input type="number" name="amount" value="@expense.Amount" step="0.01" min="0.01" aria-label="Amount" style="width:5.25rem" />
                        <input type="date" name="spentOn" value="@expense.SpentOn.ToString("yyyy-MM-dd")" aria-label="Spent on" />
                        <input type="hidden" name="note" value="@expense.Note" />
                        <button class="btn btn--ghost btn--xs" type="submit">SAVE</button>
                        <button class="btn btn--ghost btn--xs" type="submit" formaction="/admin/actions/delete-expense" title="Delete this expense">DELETE</button>
                    </form>
                </div>
            }
            <div class="head-row" style="padding:0.5rem 0 0">
                <span class="cap">TOTAL</span>
                <b class="mono" style="color:var(--ink)">$@_expenses.Sum(x => x.Amount).ToString("N0")</b>
            </div>
            <p class="cap" style="margin-top:0.375rem">DELETING A MATERIALIZED RECURRING ROW WON'T RESURRECT IT — THE RECURRING'S HIGH-WATER MARK REMEMBERS THE MONTH.</p>
        </div>
        <EditForm class="form-card" FormName="add-expense" Model="ExpenseForm" OnValidSubmit="AddExpenseAsync" style="margin-top:0.625rem">
            <div class="form-grid">
                <div>
                    <label for="ecat">Category (yours to define)</label>
                    <InputSelect id="ecat" @bind-Value="ExpenseForm!.CategoryId">
                        <option value="">— category —</option>
                        @foreach (var category in _categories)
                        {
                            <option value="@category.Id">@category.Name</option>
                        }
                    </InputSelect>
                </div>
                <div>
                    <label for="eamt">Amount</label>
                    <InputNumber id="eamt" @bind-Value="ExpenseForm!.Amount" />
                </div>
                <div>
                    <label for="eon">Spent on</label>
                    <InputDate id="eon" @bind-Value="ExpenseForm!.SpentOn" />
                </div>
                <div>
                    <label for="enew">…or a new category name</label>
                    <InputText id="enew" @bind-Value="ExpenseForm!.NewCategory" />
                </div>
            </div>
            @if (_expenseError is not null)
            {
                <p class="validation-message">@_expenseError</p>
            }
            <p style="margin-top:0.75rem"><button class="btn btn--ghost" type="submit">+ EXPENSE</button></p>
        </EditForm>

        <h2 class="section-h">Recurring — auto-logged monthly</h2>
        <div class="form-card">
            @foreach (var recurring in _recurrings)
            {
                <div class="head-row" style="padding:0.25rem 0;@(recurring.Active ? null : "opacity:.55")">
                    <span class="mono">@recurring.Category.Name.ToUpperInvariant() · $@recurring.Amount.ToString("N0") · DAY @recurring.DayOfMonth</span>
                    <form method="post" action="/admin/actions/recurring-active" style="margin:0">
                        <AntiforgeryToken />
                        <input type="hidden" name="recurringId" value="@recurring.Id" />
                        <input type="hidden" name="active" value="@((!recurring.Active).ToString())" />
                        <button class="btn btn--ghost btn--xs" type="submit">@(recurring.Active ? "PAUSE" : "RESUME")</button>
                    </form>
                </div>
            }
            @if (_recurrings.Count == 0)
            {
                <p class="cap" style="margin:0 0 0.375rem">NOTHING RECURRING YET — RENT AND INSURANCE BELONG HERE.</p>
            }
            <form method="post" action="/admin/actions/add-recurring" class="row-form" style="margin-top:0.5rem">
                <AntiforgeryToken />
                <select name="categoryId" aria-label="Category">
                    @foreach (var category in _categories)
                    {
                        <option value="@category.Id">@category.Name</option>
                    }
                </select>
                <input type="number" name="amount" step="0.01" min="0.01" placeholder="amount" aria-label="Amount" style="width:5.25rem" />
                <input type="number" name="dayOfMonth" min="1" max="31" value="1" aria-label="Day of month" style="width:3.5rem" />
                <button class="btn btn--ghost btn--xs" type="submit">+ RECURRING</button>
            </form>
            <p class="cap">MATERIALIZES INTO THE LOG ON ITS DAY EACH MONTH · SHORT MONTHS USE THEIR LAST DAY.</p>
        </div>

        <h2 class="section-h">Expense categories</h2>
        <div class="form-card">
            @foreach (var category in _allCategories)
            {
                <div class="head-row" style="padding:0.25rem 0;@(category.Archived ? "opacity:.55" : null)">
                    <form method="post" action="/admin/actions/rename-category" class="row-form" style="margin:0">
                        <AntiforgeryToken />
                        <input type="hidden" name="categoryId" value="@category.Id" />
                        <input type="text" name="name" value="@category.Name" aria-label="Category name" required maxlength="60" style="width:9.375rem" />
                        <button class="btn btn--ghost btn--xs" type="submit">SAVE</button>
                    </form>
                    <form method="post" action="/admin/actions/category-archived" style="margin:0">
                        <AntiforgeryToken />
                        <input type="hidden" name="categoryId" value="@category.Id" />
                        <input type="hidden" name="archived" value="@((!category.Archived).ToString())" />
                        <button class="btn btn--ghost btn--xs" type="submit">@(category.Archived ? "UNARCHIVE" : "ARCHIVE")</button>
                    </form>
                </div>
            }
            <p class="cap">ARCHIVED CATEGORIES KEEP THEIR HISTORY BUT LEAVE THE PICKERS.</p>
        </div>
    </section>
</div>

@code {
    [SupplyParameterFromQuery(Name = "failed")] public int? FailedFlag { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public int? PageRaw { get; set; }
    [SupplyParameterFromQuery(Name = "size")] public int? SizeRaw { get; set; }

    private int _page = 1;
    private int _pageCount = 1;
    private int _size = Pager.DefaultSize;
    private List<DuesRow> _duesView = [];
    private bool Failed => FailedFlag == 1;

    // Parameter names must match the identifiers bound in markup — SSR input names come
    // from the bind expression and the binder matches them to the parameter name.
    [SupplyParameterFromForm(FormName = "add-plan")]
    public AddPlanForm? PlanForm { get; set; }

    [SupplyParameterFromForm(FormName = "add-expense")]
    public AddExpenseForm? ExpenseForm { get; set; }

    protected override void OnInitialized()
    {
        PlanForm ??= new();
        ExpenseForm ??= new();
    }

    private DateOnly _month = DateOnly.FromDateTime(DateTime.Today);
    private (decimal CollectedInMonth, decimal Outstanding, int MembersCurrent, int MembersBehind, decimal OtherIncomeInMonth) _summary;
    private List<DuesRow> _dues = [];
    private List<MembershipPlan> _plans = [];
    private Dictionary<Guid, int> _planCounts = [];
    private Dictionary<Guid, int> _familyPlanCounts = [];
    private List<Expense> _expenses = [];
    private List<OtherIncome> _incomes = [];
    private List<ExpenseCategory> _categories = [];
    private List<ExpenseCategory> _allCategories = [];
    private List<RecurringExpense> _recurrings = [];
    private string? _planError;
    private string? _expenseError;

    public class AddPlanForm
    {
        public string Name { get; set; } = "";
        public decimal Price { get; set; }
        public bool IsFamilyScope { get; set; }
    }

    public class AddExpenseForm
    {
        public Guid? CategoryId { get; set; }
        public decimal Amount { get; set; }
        public DateOnly SpentOn { get; set; } = DateOnly.FromDateTime(DateTime.Today);
        public string? NewCategory { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _summary = await Ledger.MonthSummaryAsync(_month);
        _dues = await Ledger.DuesAsync();
        if (!string.IsNullOrWhiteSpace(Q))
        {
            _dues = _dues.Where(d => d.Name.Contains(Q.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();
        }

        // Page AFTER the search filter; a too-high page request clamps to the last page.
        _size = Pager.ResolveSize(SizeRaw);
        (_page, _pageCount) = Pager.Resolve(PageRaw, _dues.Count, _size);
        _duesView = _dues.Skip((_page - 1) * _size).Take(_size).ToList();
        _plans = await db.MembershipPlans.OrderBy(p => p.Archived).ThenBy(p => p.Price).ToListAsync();

        var counts = await db.Persons.Where(p => !p.Archived && p.MembershipPlanId != null)
            .GroupBy(p => p.MembershipPlanId!.Value)
            .Select(g => new { g.Key, Count = g.Count() })
            .ToListAsync();
        _planCounts = counts.ToDictionary(x => x.Key, x => x.Count);

        var familyCounts = await db.Families.Where(f => f.MembershipPlanId != null)
            .GroupBy(f => f.MembershipPlanId!.Value)
            .Select(g => new { g.Key, Count = g.Count() })
            .ToListAsync();
        _familyPlanCounts = familyCounts.ToDictionary(x => x.Key, x => x.Count);

        var monthStart = new DateOnly(_month.Year, _month.Month, 1);
        var monthEnd = monthStart.AddMonths(1).AddDays(-1);
        _expenses = await db.Expenses.Include(x => x.Category)
            .Where(x => x.SpentOn >= monthStart && x.SpentOn <= monthEnd)
            .OrderByDescending(x => x.SpentOn)
            .ToListAsync();
        _incomes = await db.OtherIncomes
            .Where(x => x.ReceivedOn >= monthStart && x.ReceivedOn <= monthEnd)
            .OrderByDescending(x => x.ReceivedOn)
            .ToListAsync();
        _allCategories = await db.ExpenseCategories.OrderBy(c => c.Archived).ThenBy(c => c.Name).ToListAsync();
        _categories = _allCategories.Where(c => !c.Archived).ToList();
        _recurrings = await db.RecurringExpenses.Include(r => r.Category)
            .OrderByDescending(r => r.Active).ThenBy(r => r.Category.Name).ToListAsync();
    }

    private async Task AddPlanAsync()
    {
        var form = PlanForm!;
        var name = form.Name.Trim();
        if (string.IsNullOrWhiteSpace(name))
        {
            _planError = "A plan name is required.";
            return;
        }

        if (form.Price < 0)
        {
            _planError = "Price can't be negative — use 0 for a comped plan (instructors, staff).";
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        if (await db.MembershipPlans.AnyAsync(p => p.Name == name))
        {
            _planError = $"A plan named '{name}' already exists.";
            return;
        }

        db.MembershipPlans.Add(new MembershipPlan
        {
            Id = Guid.NewGuid(),
            Name = name,
            Price = form.Price,
            Scope = form.IsFamilyScope ? PlanScope.Family : PlanScope.PerPerson,
        });
        await db.SaveChangesAsync();
        Nav.NavigateTo("/admin/finance");
    }

    private async Task AddExpenseAsync()
    {
        var form = ExpenseForm!;
        if (form.Amount <= 0)
        {
            _expenseError = "The amount must be positive.";
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var categoryId = form.CategoryId;
        if (!string.IsNullOrWhiteSpace(form.NewCategory))
        {
            // Reuse an existing category (incl. the seeded starters) instead of tripping
            // the unique (GymId, Name) index.
            var name = form.NewCategory.Trim().ToUpperInvariant();
            var category = await db.ExpenseCategories.SingleOrDefaultAsync(c => c.Name == name);
            if (category is null)
            {
                category = new ExpenseCategory { Id = Guid.NewGuid(), Name = name };
                db.ExpenseCategories.Add(category);
            }

            categoryId = category.Id;
        }

        if (categoryId is not { } id)
        {
            _expenseError = "Pick a category, or type a new category name.";
            return;
        }

        db.Expenses.Add(new Expense { Id = Guid.NewGuid(), CategoryId = id, Amount = form.Amount, SpentOn = form.SpentOn });
        await db.SaveChangesAsync();
        Nav.NavigateTo("/admin/finance");
    }
}
