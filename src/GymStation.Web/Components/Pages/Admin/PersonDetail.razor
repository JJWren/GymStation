@page "/admin/people/{PersonId:guid}"
@attribute [Authorize(Policy = "Cap:ManageRoster")]
@layout AdminLayout
@using System.Security.Claims
@inject IDbContextFactory<GymStationDbContext> DbFactory
@inject RankService Ranks
@inject GymStation.Infrastructure.Attendance.AttendanceService Attendance
@inject GymStation.Infrastructure.People.PersonService People
@inject GymStation.Infrastructure.People.PermissionService Permissions
@inject NavigationManager Nav

<PageTitle>@(_person?.DisplayName ?? "Person") · GymStation</PageTitle>

@if (_person is null)
{
    <p class="cap">PERSON NOT FOUND IN THE ACTIVE GYM.</p>
}
else
{
    <p class="page-sub"><a href="/admin/roster">ROSTER</a> → @_person.DisplayName.ToUpperInvariant()</p>

    @if (Failed)
    {
        <p class="auth-error" role="alert">That action was rejected — it didn't pass validation. Check the values and try again.</p>
    }

    @if (LinkFailed == 1)
    {
        <p class="auth-error" role="alert">Link refused — no login exists for that email, or it already belongs to another member of this gym, or this record can't hold one (Staff-only grants no portal; already-linked records unlink first).</p>
    }

    <header class="patch" style="display:flex;gap:1.125rem;align-items:center">
        <label for="portrait-file" class="media-edit" style="position:relative;z-index:1" title="Click to upload a new portrait">
            <span class="avatar avatar--l" style="display:block" role="img"
                  aria-label="@(_person.PortraitPath is null ? "Portrait placeholder — click to upload" : $"Portrait of {_person.DisplayName} — click to replace")">
                @if (_person.PortraitPath is not null)
                {
                    <img src="/admin/media/portrait/@_person.Id" alt="" />
                }
                else
                {
                    <InitialsAvatar Name="@_person.DisplayName" />
                }
            </span>
            <span class="media-edit-veil" aria-hidden="true"><Glyph Name="pencil" /></span>
        </label>
        <div style="flex:1;position:relative;z-index:1">
            @* Name edits inline at the title (#128) — first/last left the edit-person form. *@
            <form method="post" action="/admin/actions/rename-person" class="ie" data-inline-edit style="margin:0">
                <AntiforgeryToken />
                <input type="hidden" name="personId" value="@_person.Id" />
                <div class="ie-view" hidden>
                    <h1 class="page-title" style="margin:0">@_person.DisplayName.ToUpperInvariant()</h1>
                    <button type="button" class="btn btn--ghost btn--icon btn--xs ie-edit" aria-label="Edit name" title="Edit name"><Glyph Name="pencil" /></button>
                </div>
                <div class="ie-fields">
                    <input type="text" name="firstName" value="@_person.FirstName" aria-label="First name" required maxlength="80" class="ie-input--title" style="min-width:8rem" />
                    <input type="text" name="lastName" value="@_person.LastName" aria-label="Last name" required maxlength="80" class="ie-input--title" style="min-width:8rem" />
                    <button class="btn btn--icon btn--save btn--xs" type="submit" aria-label="Save name" title="Save name"><Glyph Name="save" /></button>
                    <button type="button" class="btn btn--icon btn--del btn--xs ie-cancel" aria-label="Cancel editing" title="Cancel editing" hidden><Glyph Name="x" /></button>
                </div>
            </form>
            <p class="cap" style="margin:0.25rem 0 0.625rem">
                @_person.Roles.ToString().ToUpperInvariant()
                @if (_ageGroup is not null)
                {
                    <text> · IBJJF: @_ageGroup.ToUpperInvariant() (DERIVED)</text>
                }
                · JOINED @_person.JoinedOn.ToString("MMM yyyy").ToUpperInvariant()
                @if (_person.UserId is null)
                {
                    <text> · NO LOGIN</text>
                }
                @if (_person.Visitor)
                {
                    <text> · VISITOR</text>
                }
                @if (_person.Archived)
                {
                    <text> · ARCHIVED</text>
                }
            </p>
            @* #191: post-hoc login link/unlink — create-time-only no more. *@
            @if (_person.UserId is null)
            {
                @if (!_person.Archived)
                {
                    <form method="post" action="/admin/actions/link-login" class="row-form" style="margin:0 0 0.625rem">
                        <AntiforgeryToken />
                        <input type="hidden" name="personId" value="@PersonId" />
                        <span class="cap">LINK LOGIN</span>
                        <input type="email" name="email" placeholder="registered email" aria-label="Link login by email" required style="width:13rem" />
                        <button class="btn btn--ghost btn--xs" type="submit">LINK</button>
                    </form>
                }
            }
            else
            {
                <div class="row-form" style="margin:0 0 0.625rem">
                    <span class="cap" style="margin:0">LOGIN: @(_loginEmail?.ToUpperInvariant() ?? "UNKNOWN")</span>
                    <form method="post" action="/admin/actions/unlink-login" style="margin:0">
                        <AntiforgeryToken />
                        <input type="hidden" name="personId" value="@PersonId" />
                        <button class="btn btn--ghost btn--xs" type="submit"
                                onclick="return confirm('Unlink this login? The account keeps its access and any guardianship — but if this person is a primary guardian, family billing stops until a roster record is linked again.')">UNLINK</button>
                    </form>
                </div>
            }
            @if (_current is not null)
            {
                <BeltBar Size="l" BandColorHex="@_current.Rank.BandColorHex" BarColorHex="@_current.Rank.BarColorHex"
                         Stripes="@_current.Stripes" Label="@($"{_current.Rank.Name}, {_current.Stripes} stripes")" />
                <p class="cap" style="margin-top:0.375rem">@_labels.GetValueOrDefault(_current.Rank.RankSystemId)?.ToUpperInvariant() · @_current.Rank.Name.ToUpperInvariant() · @_current.Stripes STRIPES · @RankProgress.FormatDuration(Today.ToDateTime(TimeOnly.MinValue) - _current.AtRankSince.ToDateTime(TimeOnly.MinValue)) AT RANK</p>
            }
            @if (_heldSystems.Count > 1)
            {
                <form method="post" action="/admin/actions/set-primary-discipline" class="row-form" style="margin-top:0.375rem">
                    <AntiforgeryToken />
                    <input type="hidden" name="personId" value="@PersonId" />
                    <select name="systemId" aria-label="Primary discipline" title="Primary discipline — which belt leads compact views">
                        <option value="">AUTOMATIC — LATEST PROMOTION</option>
                        @foreach (var systemId in _heldSystems)
                        {
                            <option value="@systemId" selected="@(_person.PrimaryRankSystemId == systemId)">@_labels.GetValueOrDefault(systemId)?.ToUpperInvariant()</option>
                        }
                    </select>
                    <button class="btn btn--icon btn--save btn--xs" type="submit" aria-label="Save primary discipline" title="Save primary discipline"><Glyph Name="save" /></button>
                </form>
            }
        </div>
    </header>

    <div style="margin:0.625rem 0 0.25rem">
        <MediaCropUpload Kind="portrait" Label="portrait" Aspect="1" OutWidth="512"
                         Action="/admin/actions/upload-portrait" InputId="portrait-file" Overlay="true"
                         Hint="@(_person.Roles.HasFlag(PersonRoles.Instructor) ? "SQUARE · 512×512 OR LARGER · INSTRUCTORS SHOW ON THE PUBLIC PAGE (ADR 0003)" : "SQUARE · 512×512 OR LARGER · STAFF-ONLY, NEVER PUBLIC")">
            <input type="hidden" name="personId" value="@_person.Id" />
        </MediaCropUpload>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.125rem;align-items:start" class="detail-cols">
        <section>
            <h2 class="section-h">Attendance — gym-verified</h2>
            <div class="form-card">
                <div class="filters" style="margin-bottom:0.5rem">
                    <span class="chip chip--on">@_avgPerWeek /WK · 12W</span>
                    <span class="chip">@_verifiedHours VERIFIED HRS</span>
                </div>
                <div style="display:flex;gap:0.1875rem;height:4.25rem" aria-label="Confirmed sessions per Sunday-start calendar week, last 12 weeks, oldest to newest">
                    @foreach (var week in _weeklyCounts)
                    {
                        <div style="flex:1;display:flex;flex-direction:column;justify-content:flex-end;gap:1px;height:100%">
                            <span style="font:600 0.4688rem/1 var(--font-mono);color:var(--ink-faint);text-align:center">@week.Count</span>
                            <i style="display:block;background:var(--tenant);opacity:.75;border-radius:2px 2px 0 0;height:@(_weeklyPeak == 0 ? 0 : Math.Max(week.Count > 0 ? 3 : 0, week.Count * 72 / _weeklyPeak))%"></i>
                            <b style="font:600 0.4375rem/1.5 var(--font-mono);color:var(--ink-faint);text-align:center">@week.WeekStart.ToString("M/d")</b>
                        </div>
                    }
                </div>
                <p class="cap">SESSIONS PER SUNDAY-START WEEK · OLDEST LEFT → THIS WEEK RIGHT · CONFIRMED ONLY — SELF-REPORTED TRAINING NEVER APPEARS HERE</p>
            </div>

            <h2 class="section-h">Rank history</h2>
            <div class="form-card tl">
                @if (_awards.Count == 0)
                {
                    <p class="cap">NO RANK AWARDS RECORDED YET.</p>
                }
                @foreach (var award in _awards)
                {
                    <div class="ev">
                        <span class="d">@award.AwardedOn.ToString("dd MMM yyyy").ToUpperInvariant()</span>
                        <div>
                            <BeltBar Size="s" BandColorHex="@award.Rank.BandColorHex" BarColorHex="@award.Rank.BarColorHex"
                                     Stripes="@award.Stripes" Label="@($"{award.Rank.Name}, {award.Stripes} stripes")" />
                            <div class="who">
                                @_labels.GetValueOrDefault(award.Rank.RankSystemId)?.ToUpperInvariant() ·
                                @(award.Stripes > 0 ? "STRIPE" : "PROMOTION") ·
                                @(award.SelfReported ? "SELF-REPORTED" : _names.GetValueOrDefault(award.AwardedByPersonId ?? Guid.Empty, "STAFF").ToUpperInvariant())
                            </div>
                        </div>
                        <span></span>
                    </div>
                }
            </div>

            <h2 class="section-h">Record rank award</h2>
            <EditForm class="form-card" FormName="record-award" Model="AwardForm" OnValidSubmit="RecordAwardAsync">
                <label for="rank">Rank</label>
                <InputSelect id="rank" @bind-Value="AwardForm!.RankId">
                    <option value="">— pick a rank —</option>
                    @foreach (var system in _systems)
                    {
                        <optgroup label="@(_labels.GetValueOrDefault(system.Id) == system.Name ? system.Name : $"{_labels.GetValueOrDefault(system.Id)} — {system.Name}")">
                            @foreach (var rank in system.Ranks)
                            {
                                <option value="@rank.Id">@rank.Name</option>
                            }
                        </optgroup>
                    }
                </InputSelect>
                <div class="form-grid">
                    <div>
                        <label for="stripes">Stripes at this award</label>
                        <InputNumber id="stripes" @bind-Value="AwardForm!.Stripes" />
                    </div>
                    <div>
                        <label for="on">Awarded on</label>
                        <InputDate id="on" @bind-Value="AwardForm!.AwardedOn" />
                    </div>
                </div>
                <div class="check-row" style="margin-top:0.625rem">
                    <label><InputCheckbox @bind-Value="AwardForm!.SelfReported" /> SELF-REPORTED (PRE-APP HISTORY)</label>
                </div>
                @if (_awardError is not null)
                {
                    <p class="validation-message">@_awardError</p>
                }
                <p style="margin-top:0.875rem"><button class="btn" type="submit">RECORD AWARD</button></p>
            </EditForm>
        </section>

        <section>
            @if ((_person.Roles & StaffishRoles) != 0)
            {
                <h2 class="section-h">Staff profile</h2>
                <EditForm class="form-card" FormName="staff-profile" Model="ProfileForm" OnValidSubmit="SaveProfileAsync">
                    <label for="exp">Experience summary</label>
                    <InputText id="exp" @bind-Value="ProfileForm!.ExperienceSummary" />
                    <label for="bio">Bio</label>
                    <InputTextArea id="bio" @bind-Value="ProfileForm!.Bio" rows="4" />
                    <p class="cap" style="margin-top:0.25rem">MARKDOWN: **BOLD** · _ITALIC_ · ++UNDERLINE++ · - LISTS</p>
                    <label for="hob">Hobbies (public instructor modal, when filled)</label>
                    <InputText id="hob" @bind-Value="ProfileForm!.Hobbies" />
                    <div class="form-grid">
                        <div>
                            <label for="rate">Pay rate (staff-only; never public)</label>
                            <InputNumber id="rate" @bind-Value="ProfileForm!.PayRate" />
                        </div>
                        <div>
                            <label for="unit">Rate unit</label>
                            <InputSelect id="unit" @bind-Value="ProfileForm!.PayRateUnit">
                                <option value="@PayRateUnit.PerClass">Per class</option>
                                <option value="@PayRateUnit.Hourly">Hourly</option>
                                <option value="@PayRateUnit.Monthly">Monthly</option>
                            </InputSelect>
                        </div>
                    </div>
                    <p style="margin-top:0.875rem"><button class="btn btn--icon btn--save" type="submit" aria-label="Save staff profile" title="Save staff profile"><Glyph Name="save" /></button></p>
                </EditForm>
            }

            @* Capability grants (#217): OWNER-ONLY controls; Owners themselves
               hold everything implicitly and never take grants. *@
            @if (_viewerIsOwner && (_person.Roles & StaffishRoles) != 0 && !_person.HasRole(PersonRoles.Owner))
            {
                <h2 class="section-h">Access</h2>
                <div class="form-card">
                    <form method="post" action="/admin/actions/set-permissions" style="margin:0">
                        <AntiforgeryToken />
                        <input type="hidden" name="personId" value="@PersonId" />
                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.25rem 1rem">
                            @foreach (var capability in Enum.GetValues<GymCapability>())
                            {
                                <label class="check-row" style="margin:0">
                                    <input type="checkbox" name="caps" value="@((int)capability)" checked="@(_grantedCaps.Contains(capability))" />
                                    @CapabilityLabel(capability)
                                </label>
                            }
                        </div>
                        <p style="margin-top:0.625rem"><button class="btn btn--icon btn--save btn--xs" type="submit" aria-label="Save access" title="Save access"><Glyph Name="save" /></button></p>
                    </form>
                    <div class="row-form" style="margin-top:0.375rem">
                        @foreach (var (preset, label) in new[] { ("full-admin", "FULL ADMIN"), ("front-desk", "FRONT DESK"), ("coach-plus", "COACH+") })
                        {
                            <form method="post" action="/admin/actions/apply-permission-preset" style="margin:0">
                                <AntiforgeryToken />
                                <input type="hidden" name="personId" value="@PersonId" />
                                <input type="hidden" name="preset" value="@preset" />
                                <button class="btn btn--ghost btn--xs" type="submit">@label</button>
                            </form>
                        }
                    </div>
                    <p class="cap" style="margin-top:0.375rem">WHAT THIS PERSON CAN OPEN AND CHANGE IN THE ADMIN SHELL · LINKS HIDE WITHOUT ACCESS AND DIRECT URLS ARE REFUSED · OWNERS ALWAYS HOLD EVERYTHING.</p>
                </div>
            }

            <h2 class="section-h">Membership &amp; ledger</h2>
            <div class="form-card">
                <form method="post" action="/admin/actions/assign-plan" class="row-form" style="margin:0 0 0.625rem">
                    <AntiforgeryToken />
                    <input type="hidden" name="personId" value="@PersonId" />
                    <select name="planId" aria-label="Membership plan">
                        <option value="">— no plan (no automatic charges) —</option>
                        @if (_dormantPlan is { } dormant)
                        {
                            @* #197: an archived pointer is DORMANT, not gone — say so
                               instead of masquerading as "— no plan —". *@
                            <option value="@dormant.Id" selected disabled>DORMANT — @dormant.Name (@(dormant.Archived ? "ARCHIVED" : "WRONG SCOPE"), RAISES NOTHING)</option>
                        }
                        @foreach (var plan in _plans)
                        {
                            <option value="@plan.Id" selected="@(plan.Id == _person.MembershipPlanId)">@plan.Name · $@plan.Price.ToString("N0")</option>
                        }
                    </select>
                    <button class="btn btn--ghost btn--xs" type="submit">SET PLAN</button>
                </form>
                @if (_coveringFamily is { } covering)
                {
                    @* #197: coverage was invisible — the cycle skips this person while
                       the family plan is active, and any personal plan lies dormant. *@
                    <p class="cap" style="margin:0 0 0.625rem">
                        COVERED BY <a href="/admin/families/@covering.Id">@covering.Name.ToUpperInvariant()</a> FAMILY PLAN —
                        @(_person.MembershipPlanId is null ? "NO PERSONAL CHARGES WHILE COVERED." : "THIS PERSONAL PLAN IS DORMANT WHILE COVERED (IT RESUMES IF THE FAMILY PLAN EVER CLEARS).")
                    </p>
                }
                @foreach (var line in _ledgerLines)
                {
                    <div class="head-row" style="border-bottom:1px dashed #2c3440;padding:0.3125rem 0;@(line.Voided ? "opacity:.55" : null)">
                        <span class="mono" style="@(line.Voided ? "text-decoration:line-through" : null)">@line.When.ToString("dd MMM").ToUpperInvariant() · @line.Label</span>
                        <span style="display:flex;gap:0.5rem;align-items:center">
                            @if (line.Voided)
                            {
                                <span class="stamp stamp--bad">VOID</span>
                            }
                            <span class="mono" style="color:@(line.IsCharge ? "var(--ink)" : "var(--ok)");@(line.Voided ? "text-decoration:line-through" : null)">@(line.IsCharge ? "+" : "−")$@line.Amount.ToString("N2")</span>
                            @if (line.PaymentId is { } paymentId && !line.Voided)
                            {
                                <form method="post" action="/admin/actions/void-payment" class="row-form" style="margin:0">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="paymentId" value="@paymentId" />
                                    <input type="hidden" name="personId" value="@PersonId" />
                                    <input type="text" name="reason" placeholder="reason" aria-label="Void reason" required maxlength="300" style="width:5.25rem" />
                                    <button class="btn btn--ghost btn--xs" type="submit" title="Void this payment — it stays in the audit trail">VOID</button>
                                </form>
                            }
                        </span>
                    </div>
                }
                <div class="head-row" style="padding:0.5rem 0">
                    <span class="cap">BALANCE · DERIVED, NEVER EDITED</span>
                    <b class="mono" style="color:@(_balance > 0 ? "var(--bad)" : "var(--ink)")">$@_balance.ToString("N2")</b>
                </div>
                <form method="post" action="/admin/actions/record-payment" class="row-form">
                    <AntiforgeryToken />
                    <input type="hidden" name="personId" value="@PersonId" />
                    <input type="hidden" name="back" value="person" />
                    <input type="number" name="amount" value="@(_balance > 0 ? _balance : null)" step="0.01" min="0.01" aria-label="Payment amount" style="width:6.875rem" />
                    <button class="btn btn--xs" type="submit">RECORD PAYMENT</button>
                </form>
            </div>

            <h2 class="section-h">Family</h2>
            <div class="form-card">
                @if (_family is null)
                {
                    <p class="cap">NOT IN A FAMILY. FAMILIES CARRY GUARDIANSHIP AND (SOON) FAMILY BILLING — MANAGE THEM UNDER <a href="/admin/families">FAMILIES</a>.</p>
                }
                else
                {
                    <p class="mono"><a href="/admin/families/@_family.Id">@_family.Name</a> · @(_familyMembership!.IsWard ? "WARD — GUARDIANS ACT FOR THEM" : "ADULT MEMBER")</p>
                    @foreach (var (email, isPrimary) in _guardianEmails)
                    {
                        <p class="mono" style="margin-top:0.25rem">@email @(isPrimary ? "· PRIMARY" : null)</p>
                    }
                }
            </div>

            <h2 class="section-h">Edit person</h2>
            <EditForm class="form-card" FormName="edit-person" Model="PersonForm" OnValidSubmit="SavePersonAsync">
                <label for="epdob">Date of birth — drives the derived IBJJF/Masters category above (names edit at the title)</label>
                <InputDate id="epdob" @bind-Value="PersonForm!.DateOfBirth" />
                <div class="check-row" style="margin-top:0.625rem">
                    <label><InputCheckbox @bind-Value="PersonForm!.IsMember" /> MEMBER</label>
                    <label><InputCheckbox @bind-Value="PersonForm!.IsInstructor" /> INSTRUCTOR</label>
                    <label><InputCheckbox @bind-Value="PersonForm!.IsAdmin" /> ADMIN</label>
                    <label><InputCheckbox @bind-Value="PersonForm!.IsOwner" /> OWNER</label>
                    <label><InputCheckbox @bind-Value="PersonForm!.IsStaff" /> STAFF (FRONT DESK/OPS — NO PORTAL ACCESS)</label>
                    <label><InputCheckbox @bind-Value="PersonForm!.IsVisitor" /> VISITOR — UNTICK & ASSIGN A PLAN TO CONVERT</label>
                </div>
                @* Contact lives inside the person edit now (#128) — the separate section is gone. *@
                <label for="ctphone">Phone number (leave empty to remove)</label>
                <InputText id="ctphone" @bind-Value="PersonForm!.PhoneNumber" maxlength="30" />
                <div class="check-row" style="margin-top:0.625rem">
                    <label><InputCheckbox @bind-Value="PersonForm!.SmsAllowed" /> TEXTING ALLOWED (STAFF-ENTERED NUMBERS DEFAULT TO NO)</label>
                </div>
                @if (_editError is not null)
                {
                    <p class="validation-message">@_editError</p>
                }
                <p style="margin-top:0.75rem"><button class="btn btn--icon btn--save" type="submit" aria-label="Save person" title="Save person"><Glyph Name="save" /></button></p>
            </EditForm>

            <EditForm class="form-card" FormName="archive-person" Model="ArchiveMarker" OnValidSubmit="ToggleArchiveAsync" style="margin-top:0.625rem">
                <p class="cap" style="margin:0 0 0.5rem">
                    @(_person.Archived
                        ? "ARCHIVED — HIDDEN FROM THE ROSTER AND ALL FILTERS. HISTORY AND LEDGER REMAIN."
                        : "ARCHIVING HIDES THIS PERSON FROM THE ROSTER; HISTORY AND LEDGER REMAIN.")
                </p>
                @if (_archiveError is not null)
                {
                    <p class="validation-message">@_archiveError</p>
                }
                <button class="btn btn--ghost" type="submit">@(_person.Archived ? "UNARCHIVE" : "ARCHIVE")</button>
            </EditForm>
        </section>
    </div>
}

@code {
    // The profile card renders for anyone the gym pays or fronts publicly.
    private const PersonRoles StaffishRoles =
        PersonRoles.Instructor | PersonRoles.Admin | PersonRoles.Owner | PersonRoles.Staff;

    [Parameter] public Guid PersonId { get; set; }

    [SupplyParameterFromQuery(Name = "failed")] public int? FailedFlag { get; set; }
    [SupplyParameterFromQuery(Name = "linkfailed")] public int? LinkFailed { get; set; }
    private bool Failed => FailedFlag == 1;

    [CascadingParameter] public HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm(FormName = "record-award")]
    public RecordAwardForm? AwardForm { get; set; }

    [SupplyParameterFromForm(FormName = "staff-profile")]
    public StaffProfileForm? ProfileForm { get; set; }

    [SupplyParameterFromForm(FormName = "edit-person")]
    public EditPersonForm? PersonForm { get; set; }

    [SupplyParameterFromForm(FormName = "archive-person")]
    public ArchiveModel? ArchiveMarker { get; set; }

    public class ArchiveModel;

    protected override void OnInitialized()
    {
        AwardForm ??= new();
        ProfileForm ??= new();
        PersonForm ??= new();
        ArchiveMarker ??= new();
    }

    private Person? _person;
    private string? _loginEmail;
    private CurrentRank? _current;
    private Dictionary<Guid, string> _labels = [];
    private List<Guid> _heldSystems = [];
    private bool _viewerIsOwner;
    private HashSet<GymCapability> _grantedCaps = [];

    private static string CapabilityLabel(GymCapability capability) => capability switch
    {
        GymCapability.ViewFinances => "VIEW FINANCES",
        GymCapability.ManageFinances => "MANAGE FINANCES",
        GymCapability.ViewReports => "VIEW REPORTS",
        GymCapability.ManageRoster => "MANAGE ROSTER",
        GymCapability.ManageRanks => "MANAGE RANKS",
        GymCapability.ManageSchedule => "MANAGE SCHEDULE",
        GymCapability.ManageEvents => "MANAGE EVENTS",
        GymCapability.ManageMessaging => "MANAGE MESSAGES",
        GymCapability.EditLanding => "EDIT LANDING",
        GymCapability.ManageSettings => "MANAGE SETTINGS",
        _ => capability.ToString().ToUpperInvariant(),
    };
    private List<RankAward> _awards = [];
    private List<RankSystem> _systems = [];
    private Dictionary<Guid, string> _names = [];
    private List<(string Email, bool IsPrimary)> _guardianEmails = [];
    private Family? _family;
    private FamilyMember? _familyMembership;
    private string? _ageGroup;
    private string? _awardError;
    private string? _editError;
    private string? _archiveError;
    private double _avgPerWeek;
    private int _verifiedHours;
    private List<GymStation.Domain.Attendance.WeekCount> _weeklyCounts = [];
    private int _weeklyPeak;
    private List<GymStation.Domain.Money.MembershipPlan> _plans = [];
    private GymStation.Domain.Money.MembershipPlan? _dormantPlan;
    private Family? _coveringFamily;
    private List<LedgerLine> _ledgerLines = [];
    private decimal _balance;

    private sealed record LedgerLine(DateOnly When, string Label, decimal Amount, bool IsCharge, Guid? PaymentId, bool Voided);

    // #181 breakdown rendering now lives on the shared member ledger (#199).
    private static string FamilyBreakdownSuffix(GymStation.Domain.Money.Charge c)
        => DuesLedgerPanel.FamilyBreakdownSuffix(c);
    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Today);

    public class RecordAwardForm
    {
        public Guid? RankId { get; set; }
        public int Stripes { get; set; }
        public DateOnly AwardedOn { get; set; } = DateOnly.FromDateTime(DateTime.Today);
        public bool SelfReported { get; set; }
    }

    public class StaffProfileForm
    {
        public string? ExperienceSummary { get; set; }
        public string? Bio { get; set; }
        public string? Hobbies { get; set; }
        public decimal? PayRate { get; set; }
        public PayRateUnit PayRateUnit { get; set; } = PayRateUnit.PerClass;
    }

    public class EditPersonForm
    {
        public DateOnly? DateOfBirth { get; set; }
        public bool IsMember { get; set; }
        public bool IsInstructor { get; set; }
        public bool IsAdmin { get; set; }
        public bool IsOwner { get; set; }
        public bool IsStaff { get; set; }
        public bool IsVisitor { get; set; }
        public string? PhoneNumber { get; set; }
        public bool SmsAllowed { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _person = await db.Persons.SingleOrDefaultAsync(p => p.Id == PersonId);
        if (_person is null)
        {
            return;
        }

        _loginEmail = _person.UserId is { } linkedUserId
            ? await db.Users.Where(u => u.Id == linkedUserId).Select(u => u.Email ?? u.UserName).FirstOrDefaultAsync()
            : null;

        _ageGroup = IbjjfAgeGroup.FromBirthDate(_person.DateOfBirth, Today);
        (_avgPerWeek, _verifiedHours, _weeklyCounts) = await Attendance.StatsAsync(PersonId, Today);
        _weeklyPeak = _weeklyCounts.Count == 0 ? 0 : _weeklyCounts.Max(w => w.Count);
        _systems = await Ranks.GetVisibleSystemsAsync();
        _labels = await Ranks.GetDisciplineLabelsAsync();
        _awards = await Ranks.GetAwardsForPersonAsync(PersonId);
        _heldSystems = _awards.Select(a => a.Rank.RankSystemId).Distinct().ToList();

        var viewerRaw = HttpContext?.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (Guid.TryParse(viewerRaw, out var viewerUserId))
        {
            await using var viewerDb = await DbFactory.CreateDbContextAsync();
            var viewer = await viewerDb.Persons.SingleOrDefaultAsync(p => p.UserId == viewerUserId && !p.Archived);
            _viewerIsOwner = viewer?.HasRole(PersonRoles.Owner) == true;
        }

        if (_viewerIsOwner)
        {
            _grantedCaps = await Permissions.GetForPersonAsync(PersonId);
        }
        _current = (await Ranks.GetPrimaryRanksAsync([PersonId])).GetValueOrDefault(PersonId);

        var awarderIds = _awards.Where(a => a.AwardedByPersonId is not null).Select(a => a.AwardedByPersonId!.Value).Distinct().ToList();
        _names = await db.Persons.Where(p => awarderIds.Contains(p.Id))
            .ToDictionaryAsync(p => p.Id, p => p.DisplayName);

        // #196: per-person plans only — family-scope plans attach to a Family.
        _plans = await db.MembershipPlans
            .Where(p => !p.Archived && p.Scope == GymStation.Domain.Money.PlanScope.PerPerson)
            .OrderBy(p => p.Price)
            .ToListAsync();

        // #197: a pointer at a plan the filtered list can't show (archived, or a
        // legacy family-scope assignment) is DORMANT — load it for honest rendering.
        _dormantPlan = _person.MembershipPlanId is { } pointedPlanId && _plans.All(p => p.Id != pointedPlanId)
            ? await db.MembershipPlans.SingleOrDefaultAsync(p => p.Id == pointedPlanId)
            : null;

        var charges = await db.Charges.Where(c => c.PersonId == PersonId).ToListAsync();
        var payments = await db.Payments.Where(p => p.PersonId == PersonId).ToListAsync();
        _balance = GymStation.Domain.Money.LedgerMath.Balance(charges, payments);
        _ledgerLines = charges
            .Select(c => new LedgerLine(c.RaisedOn, "CHARGE · " + c.Description.ToUpperInvariant() + FamilyBreakdownSuffix(c), c.Amount, true, null, false))
            .Concat(payments.Select(p => new LedgerLine(
                p.ReceivedOn,
                p.Voided ? $"PAYMENT · VOID: {p.VoidReason?.ToUpperInvariant()}" : "PAYMENT",
                p.Amount, false, p.Id, p.Voided)))
            .OrderByDescending(l => l.When)
            .Take(8)
            .ToList();

        // The person's family, if any: guardians shown by email, primacy marked (#89).
        _familyMembership = await db.FamilyMembers.SingleOrDefaultAsync(m => m.PersonId == PersonId);
        if (_familyMembership is not null)
        {
            _family = await db.Families.SingleOrDefaultAsync(f => f.Id == _familyMembership.FamilyId);

            // #197: covered = the family points at an ACTIVE family-scope plan
            // (the #91 covered-set predicate, person-shaped).
            if (_family?.MembershipPlanId is { } familyPlanId
                && await db.MembershipPlans.AnyAsync(p => p.Id == familyPlanId && !p.Archived && p.Scope == GymStation.Domain.Money.PlanScope.Family))
            {
                _coveringFamily = _family;
            }
            var guardians = await db.FamilyGuardians
                .Where(g => g.FamilyId == _familyMembership.FamilyId)
                .OrderByDescending(g => g.IsPrimary)
                .ToListAsync();
            var guardianUserIds = guardians.Select(g => g.GuardianUserId).ToList();
            var emails = await db.Users.Where(u => guardianUserIds.Contains(u.Id))
                .ToDictionaryAsync(u => u.Id, u => u.Email ?? u.UserName ?? "unknown");
            _guardianEmails = guardians
                .Select(g => (emails.GetValueOrDefault(g.GuardianUserId, "unknown"), g.IsPrimary))
                .ToList();
        }

        var profile = await db.StaffProfiles.SingleOrDefaultAsync(p => p.PersonId == PersonId);
        if (profile is not null && HttpContext?.Request.Method != "POST")
        {
            ProfileForm = new StaffProfileForm
            {
                ExperienceSummary = profile.ExperienceSummary,
                Bio = profile.Bio,
                Hobbies = profile.Hobbies,
                PayRate = profile.PayRate,
                PayRateUnit = profile.PayRateUnit,
            };
        }

        // Prefill unless THIS form was the one posted (another form's POST must not
        // blank the edit fields — and a posted-blank name must reach validation,
        // so the check is the posted form's identity, not the field values).
        var postedHandler = HttpContext?.Request.Method == "POST"
            ? HttpContext.Request.Form["_handler"].ToString()
            : null;
        if (postedHandler != "edit-person")
        {
            PersonForm!.DateOfBirth = _person.DateOfBirth;
            PersonForm.IsMember = _person.Roles.HasFlag(PersonRoles.Member);
            PersonForm.IsInstructor = _person.Roles.HasFlag(PersonRoles.Instructor);
            PersonForm.IsAdmin = _person.Roles.HasFlag(PersonRoles.Admin);
            PersonForm.IsOwner = _person.Roles.HasFlag(PersonRoles.Owner);
            PersonForm.IsStaff = _person.Roles.HasFlag(PersonRoles.Staff);
            PersonForm.IsVisitor = _person.Visitor;
            PersonForm.PhoneNumber = _person.PhoneNumber;
            PersonForm.SmsAllowed = _person.SmsAllowed;
        }
    }

    private async Task SavePersonAsync()
    {
        var form = PersonForm!;
        var roles = PersonRoles.None;
        if (form.IsMember) roles |= PersonRoles.Member;
        if (form.IsInstructor) roles |= PersonRoles.Instructor;
        if (form.IsAdmin) roles |= PersonRoles.Admin;
        if (form.IsOwner) roles |= PersonRoles.Owner;
        if (form.IsStaff) roles |= PersonRoles.Staff;

        try
        {
            // Names moved to the inline title edit (#128) — this form updates
            // everything else, contact included, atomically in one submit.
            await People.UpdateWithContactAsync(PersonId, form.DateOfBirth, roles, form.IsVisitor, form.PhoneNumber, form.SmsAllowed);
            Nav.NavigateTo($"/admin/people/{PersonId}");
        }
        catch (InvalidOperationException ex)
        {
            _editError = ex.Message;
        }
    }

    private async Task ToggleArchiveAsync()
    {
        try
        {
            await People.SetArchivedAsync(PersonId, !_person!.Archived);
            Nav.NavigateTo($"/admin/people/{PersonId}");
        }
        catch (InvalidOperationException ex)
        {
            _archiveError = ex.Message;
        }
    }

    private async Task RecordAwardAsync()
    {
        var form = AwardForm!;
        if (form.RankId is not { } rankId)
        {
            _awardError = "Pick a rank.";
            return;
        }

        try
        {
            var raw = HttpContext?.User.FindFirstValue(ClaimTypes.NameIdentifier);
            Guid? awardedBy = null;
            if (!form.SelfReported && Guid.TryParse(raw, out var userId))
            {
                await using var db = await DbFactory.CreateDbContextAsync();
                awardedBy = (await db.Persons.SingleOrDefaultAsync(p => p.UserId == userId))?.Id;
            }

            await Ranks.RecordAwardAsync(PersonId, rankId, form.Stripes, form.AwardedOn, awardedBy, form.SelfReported, null);
            Nav.NavigateTo($"/admin/people/{PersonId}");
        }
        catch (InvalidOperationException ex)
        {
            _awardError = ex.Message;
        }
    }

    private async Task SaveProfileAsync()
    {
        var form = ProfileForm!;
        await using var db = await DbFactory.CreateDbContextAsync();
        var profile = await db.StaffProfiles.SingleOrDefaultAsync(p => p.PersonId == PersonId);
        if (profile is null)
        {
            profile = new StaffProfile { PersonId = PersonId };
            db.StaffProfiles.Add(profile);
        }

        profile.ExperienceSummary = form.ExperienceSummary;
        profile.Bio = form.Bio;
        profile.Hobbies = form.Hobbies;
        profile.PayRate = form.PayRate;
        profile.PayRateUnit = form.PayRateUnit;
        await db.SaveChangesAsync();

        Nav.NavigateTo($"/admin/people/{PersonId}");
    }
}
