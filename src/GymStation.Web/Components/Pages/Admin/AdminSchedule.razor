@page "/admin/schedule"
@attribute [Authorize(Policy = "GymStaff")]
@layout AdminLayout
@using GymStation.Domain.Scheduling
@using GymStation.Domain.Tenancy
@using GymStation.Infrastructure.Scheduling
@inject IDbContextFactory<GymStationDbContext> DbFactory
@inject ScheduleService Schedule
@inject NavigationManager Nav

<PageTitle>Schedule · GymStation</PageTitle>

<div class="head-row">
    <h1 class="page-title">SCHEDULE</h1>
    <div class="mono">
        WK OF @_weekStart.ToString("dd MMM yyyy").ToUpperInvariant() ·
        <a href="@($"/admin/schedule?start={_weekStart.AddDays(-7):yyyy-MM-dd}")">◀ PREV</a> ·
        <a href="@($"/admin/schedule?start={_weekStart.AddDays(7):yyyy-MM-dd}")">NEXT ▶</a>
    </div>
</div>
<p class="page-sub">
    SWAPS: @(_settings?.SubstitutionMode == SubstitutionMode.AdminGate ? "ADMIN-GATE" : "AUTO-APPLY")
    · OPEN CLAIMS: @(_settings?.OpenClaimsEnabled == true ? "ON" : "OFF")
</p>

@if (DeleteFailed == 1)
{
    <p class="auth-error" role="alert">Delete refused — that class already has check-in or cover history, and history stays. Cancel the session instead.</p>
}

@if (DuplicateFailed == 1)
{
    <p class="auth-error" role="alert">Duplicate refused — the start time must be HH:mm and the source class must still exist.</p>
}

@if (TemplateDuplicateFailed == 1)
{
    <p class="auth-error" role="alert">Template duplicate refused — the start time must be HH:mm and the source template must still exist.</p>
}

<ScheduleRailIsland WeekStartIso="@_weekStart.ToString("yyyy-MM-dd")" @rendermode="InteractiveServer" />
<p class="cap" style="margin-top:0.375rem">
    MAT HOURS @_open.ToString("HH\\:mm")–@_close.ToString("HH\\:mm") (SET IN SETTINGS) ·
    CLICK A CLASS TO EDIT · DRAG IT TO MOVE THE TIME (30-MIN SNAP) · DRAG THE BOTTOM EDGE TO RESIZE —
    OCCURRENCES ONLY; TEMPLATES CHANGE IN THE EDITOR
</p>

@if (_editSession is { } editing)
{
    <div class="modal-wrap" role="dialog" aria-modal="true" aria-label="Edit class">
        <a class="modal-scrim" href="/admin/schedule?start=@_weekStart.ToString("yyyy-MM-dd")" aria-label="Close editor"></a>
        <div class="modal-card">
            <div class="head-row">
                <h2 class="section-h" style="margin:0">@editing.Name.ToUpperInvariant() · @editing.Date.ToString("ddd dd MMM").ToUpperInvariant()</h2>
                <a class="btn btn--ghost btn--xs" href="/admin/schedule?start=@_weekStart.ToString("yyyy-MM-dd")">✕ CLOSE</a>
            </div>

            <EditForm class="form-card" FormName="edit-session" Model="SessionForm" OnValidSubmit="SaveSessionAsync" style="margin-top:0.625rem">
                <label for="esname">Name</label>
                <InputText id="esname" @bind-Value="SessionForm!.Name" />
                <div class="form-grid">
                    <div>
                        <label for="esdate">Date — moves this occurrence to another day (#131)</label>
                        <InputDate id="esdate" @bind-Value="SessionForm!.Date" />
                    </div>
                    <div>
                        <label for="esstart">Start (HH:mm)</label>
                        <InputText id="esstart" @bind-Value="SessionForm!.Start" />
                    </div>
                    <div>
                        <label for="esdur">Duration (min)</label>
                        <InputNumber id="esdur" @bind-Value="SessionForm!.DurationMinutes" />
                    </div>
                </div>
                <label for="esinst">Instructor</label>
                <InputSelect id="esinst" @bind-Value="SessionForm!.InstructorPersonId">
                    <option value="">— unassigned —</option>
                    @foreach (var (id, name) in _instructors)
                    {
                        <option value="@id">@name</option>
                    }
                </InputSelect>
                @if (_editTemplate is not null)
                {
                    @* #170: the calendar-standard scope choice, template classes only. *@
                    <label style="margin-top:0.5rem">Apply to</label>
                    <div class="check-row" role="radiogroup" aria-label="Apply changes to">
                        <InputRadioGroup @bind-Value="SessionForm!.Scope">
                            <label><InputRadio Value="@("one")" /> JUST THIS CLASS</label>
                            <label><InputRadio Value="@("series")" /> THIS AND FOLLOWING CLASSES</label>
                        </InputRadioGroup>
                    </div>
                }
                @if (_sessionError is not null)
                {
                    <p class="validation-message">@_sessionError</p>
                }
                <p style="margin-top:0.75rem;display:flex;gap:0.5rem;align-items:center">
                    <button class="btn btn--icon btn--save" type="submit" aria-label="Save this session" title="Save this session"><Glyph Name="save" /></button>
                    @* form= submits the SIBLING delete form — forms can't nest (#169). *@
                    <button class="btn btn--icon btn--del" type="submit" form="delete-session-form"
                            aria-label="Delete this class" title="Delete this class (refused once check-in or cover history exists)"
                            onclick="return confirm('Delete this class from the schedule? Classes with check-in or cover history refuse — cancel those instead.')"><Glyph Name="trash" /></button>
                </p>
                <p class="cap" style="margin:0.375rem 0 0">
                    @(_editTemplate is null
                        ? "CHANGES THIS OCCURRENCE ONLY"
                        : "JUST THIS CLASS = THIS OCCURRENCE ONLY · THIS-AND-FOLLOWING ALSO MOVES EVERY LATER CLASS AND THE WEEKLY TEMPLATE — PAST WEEKS NEVER CHANGE")
                    · TIME OR DATE CHANGES NOTIFY STAFF AND CHECKED-IN MEMBERS
                </p>
            </EditForm>

            <form id="delete-session-form" method="post" action="/admin/actions/delete-session" style="display:none">
                <AntiforgeryToken />
                <input type="hidden" name="sessionId" value="@editing.Id" />
                <input type="hidden" name="week" value="@_weekStart.ToString("yyyy-MM-dd")" />
            </form>

            <div class="form-card" style="margin-top:0.625rem">
                @if (editing.Status == SessionStatus.Cancelled)
                {
                    <span class="stamp stamp--bad">CANCELLED@(editing.CancelledReason is { Length: > 0 } why ? $" · {why.ToUpperInvariant()}" : null)</span>
                    <form method="post" action="/admin/actions/reopen-session" class="row-form">
                        <AntiforgeryToken />
                        <input type="hidden" name="sessionId" value="@editing.Id" />
                        <button type="submit" class="btn btn--ghost btn--xs">RE-OPEN</button>
                    </form>
                }
                else
                {
                    <form method="post" action="/admin/actions/cancel-session" class="row-form" style="margin:0">
                        <AntiforgeryToken />
                        <input type="hidden" name="sessionId" value="@editing.Id" />
                        <input type="text" name="reason" placeholder="reason" aria-label="Cancellation reason" />
                        <button type="submit" class="btn btn--ghost btn--xs">CANCEL SESSION</button>
                    </form>
                }

                @* #171: copy this class to another day/time — the finance-row idiom. *@
                <form method="post" action="/admin/actions/duplicate-session" class="row-form" style="margin-top:0.625rem">
                    <AntiforgeryToken />
                    <input type="hidden" name="sessionId" value="@editing.Id" />
                    <span class="cap">DUPLICATE TO</span>
                    <input type="date" name="date" value="@editing.Date.ToString("yyyy-MM-dd")" aria-label="Duplicate to date" required />
                    <input type="text" name="start" value="@editing.StartTime.ToString("HH\\:mm")" aria-label="Duplicate to start time (HH:mm)" style="width:4.5rem" required />
                    <button class="btn btn--icon btn--copy btn--xs" type="submit" aria-label="Duplicate this class to the chosen day and time" title="Duplicate this class — the copy is a one-off"><Glyph Name="copy" /></button>
                </form>
                <p class="cap" style="margin:0.375rem 0 0">THE COPY IS A ONE-OFF — IT NEVER FOLLOWS THE WEEKLY TEMPLATE.</p>
            </div>

            @if (_editTemplate is { } template)
            {
                <h2 class="section-h">Weekly template — every @template.Day.ToString().ToUpperInvariant()</h2>
                <EditForm class="form-card" FormName="edit-template" Model="TemplateEdit" OnValidSubmit="SaveTemplateAsync">
                    <label for="etname">Name</label>
                    <InputText id="etname" @bind-Value="TemplateEdit!.Name" />
                    <div class="form-grid">
                        <div>
                            <label for="etday">Day</label>
                            <InputSelect id="etday" @bind-Value="TemplateEdit!.Day">
                                @foreach (var day in Enum.GetValues<DayOfWeek>())
                                {
                                    <option value="@day">@day</option>
                                }
                            </InputSelect>
                        </div>
                        <div>
                            <label for="etstart">Start (HH:mm)</label>
                            <InputText id="etstart" @bind-Value="TemplateEdit!.Start" />
                        </div>
                        <div>
                            <label for="etdur">Duration (min)</label>
                            <InputNumber id="etdur" @bind-Value="TemplateEdit!.DurationMinutes" />
                        </div>
                        <div>
                            <label for="etinst">Default instructor</label>
                            <InputSelect id="etinst" @bind-Value="TemplateEdit!.InstructorPersonId">
                                <option value="">— unassigned —</option>
                                @foreach (var (id, name) in _instructors)
                                {
                                    <option value="@id">@name</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                    <label>Class types</label>
                    <div class="check-row">
                        @foreach (var type in _types)
                        {
                            <label><input type="checkbox" name="TemplateEdit.TypeIds" value="@type.Id" checked="@TemplateEdit!.TypeIds.Contains(type.Id)" /> @type.Name</label>
                        }
                    </div>
                    @if (_templateEditError is not null)
                    {
                        <p class="validation-message">@_templateEditError</p>
                    }
                    <p style="margin-top:0.75rem"><button class="btn btn--icon btn--save" type="submit" aria-label="Save template" title="Save template"><Glyph Name="save" /></button></p>
                    <p class="cap" style="margin:0.375rem 0 0">APPLIES TO WEEKS NOT YET ON THE CALENDAR · OCCURRENCES ALREADY MATERIALIZED (INCLUDING THIS ONE) KEEP THEIR OWN VALUES</p>
                </EditForm>

                <EditForm FormName="pause-template" Model="PauseMarker" OnValidSubmit="PauseTemplateAsync" style="margin-top:0.625rem">
                    <button class="btn btn--ghost btn--xs" type="submit" style="color:var(--bad)"
                            onclick="return confirm('Pause this weekly class? It stops appearing on future weeks; existing occurrences stay.')">PAUSE WEEKLY TEMPLATE</button>
                </EditForm>

                @* #179: copy this weekly template to another day/time — the #171 row idiom. *@
                <form method="post" action="/admin/actions/duplicate-template" class="row-form" style="margin-top:0.625rem">
                    <AntiforgeryToken />
                    <input type="hidden" name="templateId" value="@template.Id" />
                    <input type="hidden" name="week" value="@_weekStart.ToString("yyyy-MM-dd")" />
                    <span class="cap">DUPLICATE TO</span>
                    <select name="day" aria-label="Duplicate this weekly template to weekday">
                        @foreach (var day in Enum.GetValues<DayOfWeek>())
                        {
                            <option value="@day" selected="@(day == template.Day)">@day</option>
                        }
                    </select>
                    <input type="text" name="start" value="@template.StartTime.ToString("HH\\:mm")" aria-label="Duplicate this weekly template start time (HH:mm)" style="width:4.5rem" required />
                    <button class="btn btn--icon btn--copy btn--xs" type="submit" aria-label="Duplicate this weekly template to the chosen day and time" title="Duplicate this weekly template — the copy is its own weekly class"><Glyph Name="copy" /></button>
                </form>
                <p class="cap" style="margin:0.375rem 0 0">THE COPY IS ITS OWN WEEKLY CLASS — IT STARTS THIS WEEK AND NEVER FILLS EARLIER WEEKS.</p>
            }
        </div>
    </div>
}

<div class="detail-cols" style="display:grid;grid-template-columns:1fr 1fr;gap:1.125rem;align-items:start;margin-top:1.25rem">
    <section>
        <h2 class="section-h">Substitutions</h2>
        @if (_requests.Count == 0)
        {
            <p class="cap">NO OPEN SUBSTITUTION REQUESTS.</p>
        }
        @foreach (var request in _requests)
        {
            <div class="form-card" style="margin-bottom:0.625rem">
                <b>@request.Session.Name · @request.Session.Date.ToString("ddd dd MMM").ToUpperInvariant() @request.Session.StartTime.ToString("HH\\:mm")</b>
                <p class="cap" style="margin:0.25rem 0 0.5rem">
                    @_personNames.GetValueOrDefault(request.RequestedByPersonId, "?").ToUpperInvariant() OUT ·
                    @(request.ProposedSubPersonId is { } p ? "PROPOSED: " + _personNames.GetValueOrDefault(p, "?").ToUpperInvariant() : "OPEN REQUEST")
                    @(request.EscalatedUtc is not null ? " · ESCALATED" : null)
                </p>
                <span class="stamp @(request.Status == SubstitutionStatus.PendingApproval ? "stamp--warn" : "stamp--dim")">@request.Status.ToString().ToUpperInvariant()</span>
                @if (request.Status == SubstitutionStatus.PendingApproval)
                {
                    <form method="post" action="/admin/actions/approve-sub" class="row-form">
                        <AntiforgeryToken />
                        <input type="hidden" name="requestId" value="@request.Id" />
                        <button type="submit" class="btn btn--xs">APPROVE — @_personNames.GetValueOrDefault(request.AcceptedByPersonId ?? Guid.Empty, "?").ToUpperInvariant()</button>
                    </form>
                    <form method="post" action="/admin/actions/decline-sub" class="row-form">
                        <AntiforgeryToken />
                        <input type="hidden" name="requestId" value="@request.Id" />
                        <button type="submit" class="btn btn--ghost btn--xs">DECLINE</button>
                    </form>
                }
            </div>
        }

        <p class="cap">SWAP MODE AND OPEN CLAIMS ARE GYM SETTINGS — CHANGE THEM IN <a href="/admin/settings">SETTINGS</a>.</p>
    </section>

    <section>
        <h2 class="section-h">Add weekly class (template)</h2>
        <EditForm class="form-card" FormName="add-template" Model="TemplateForm" OnValidSubmit="AddTemplateAsync">
            <label for="tname">Name</label>
            <InputText id="tname" @bind-Value="TemplateForm!.Name" />
            <div class="form-grid">
                <div>
                    <label for="tday">Day</label>
                    <InputSelect id="tday" @bind-Value="TemplateForm!.Day">
                        @foreach (var day in Enum.GetValues<DayOfWeek>())
                        {
                            <option value="@day">@day</option>
                        }
                    </InputSelect>
                </div>
                <div>
                    <label for="tstart">Start (HH:mm)</label>
                    <InputText id="tstart" @bind-Value="TemplateForm!.Start" />
                </div>
                <div>
                    <label for="tdur">Duration (min)</label>
                    <InputNumber id="tdur" @bind-Value="TemplateForm!.DurationMinutes" />
                </div>
                <div>
                    <label for="tinst">Default instructor</label>
                    <InputSelect id="tinst" @bind-Value="TemplateForm!.InstructorPersonId">
                        <option value="">— unassigned —</option>
                        @foreach (var (id, name) in _instructors)
                        {
                            <option value="@id">@name</option>
                        }
                    </InputSelect>
                </div>
            </div>
            <label>Class types</label>
            <div class="check-row">
                @foreach (var type in _types)
                {
                    @* Static SSR: multiple same-named checkboxes bind the List<Guid> on post —
                       the name must carry the full parameter path. *@
                    <label><input type="checkbox" name="TemplateForm.TypeIds" value="@type.Id" checked="@TemplateForm!.TypeIds.Contains(type.Id)" /> @type.Name</label>
                }
            </div>
            @if (_templateError is not null)
            {
                <p class="validation-message">@_templateError</p>
            }
            <p style="margin-top:0.875rem"><button class="btn btn--icon btn--save" type="submit" aria-label="Add class template" title="Add class template"><Glyph Name="save" /></button></p>
        </EditForm>

        @if (_pausedTemplates.Count > 0)
        {
            <h2 class="section-h">Paused templates</h2>
            <EditForm class="form-card" FormName="restore-template" Model="RestoreForm" OnValidSubmit="RestoreTemplateAsync">
                <label for="rtid">These no longer appear on future weeks</label>
                <InputSelect id="rtid" @bind-Value="RestoreForm!.TemplateId">
                    @foreach (var paused in _pausedTemplates)
                    {
                        <option value="@paused.Id">@paused.Name · @paused.Day @paused.StartTime.ToString("HH\\:mm")</option>
                    }
                </InputSelect>
                <p style="margin-top:0.625rem"><button class="btn btn--ghost btn--xs" type="submit">RESTORE TO SCHEDULE</button></p>
            </EditForm>
        }

        <h2 class="section-h">Class tags</h2>
        <EditForm class="form-card" FormName="add-type" Model="TypeForm" OnValidSubmit="AddTypeAsync">
            <div class="form-grid">
                <div>
                    <label for="ctname">Tag name</label>
                    <InputText id="ctname" @bind-Value="TypeForm!.Name" />
                </div>
                <div>
                    <label for="ctcolor">Color</label>
                    <InputText id="ctcolor" @bind-Value="TypeForm!.ColorHex" />
                </div>
            </div>
            <p style="margin-top:0.875rem"><button class="btn btn--icon btn--save" type="submit" aria-label="Add class type" title="Add class type"><Glyph Name="save" /></button></p>
        </EditForm>
    </section>
</div>

@code {
    [SupplyParameterFromQuery(Name = "start")] public string? StartRaw { get; set; }
    [SupplyParameterFromQuery(Name = "edit")] public string? EditRaw { get; set; }
    [SupplyParameterFromQuery(Name = "delfailed")] public int? DeleteFailed { get; set; }
    [SupplyParameterFromQuery(Name = "dupfailed")] public int? DuplicateFailed { get; set; }
    [SupplyParameterFromQuery(Name = "tdupfailed")] public int? TemplateDuplicateFailed { get; set; }

    [CascadingParameter] public HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm(FormName = "add-template")]
    public AddTemplateForm? TemplateForm { get; set; }

    [SupplyParameterFromForm(FormName = "add-type")]
    public AddTypeForm? TypeForm { get; set; }

    [SupplyParameterFromForm(FormName = "edit-session")]
    public EditSessionForm? SessionForm { get; set; }

    [SupplyParameterFromForm(FormName = "edit-template")]
    public EditTemplateForm? TemplateEdit { get; set; }

    [SupplyParameterFromForm(FormName = "pause-template")]
    public MarkerModel? PauseMarker { get; set; }

    [SupplyParameterFromForm(FormName = "restore-template")]
    public RestoreTemplateForm? RestoreForm { get; set; }

    public class MarkerModel;

    protected override void OnInitialized()
    {
        TemplateForm ??= new();
        TypeForm ??= new();
        SessionForm ??= new();
        TemplateEdit ??= new();
        PauseMarker ??= new();
        RestoreForm ??= new();

        // The form binder nulls collections that arrive with no posted fields
        // (zero checked checkboxes posts nothing for TypeIds).
        TemplateForm.TypeIds ??= [];
        TemplateEdit.TypeIds ??= [];
    }

    private DateOnly _weekStart;
    private List<ClassSession> _sessions = [];
    private List<SubstitutionRequest> _requests = [];
    private List<ClassType> _types = [];
    private List<ClassTemplate> _pausedTemplates = [];
    private List<(Guid Id, string Name)> _instructors = [];
    private Dictionary<Guid, string> _personNames = [];
    private GymSettings? _settings;
    private string? _templateError;
    private string? _sessionError;
    private string? _templateEditError;

    private ClassSession? _editSession;
    private ClassTemplate? _editTemplate;


    private TimeOnly _open = new(6, 0);
    private TimeOnly _close = new(22, 0);

    public class AddTemplateForm
    {
        public string Name { get; set; } = "";
        public DayOfWeek Day { get; set; } = DayOfWeek.Monday;
        public string Start { get; set; } = "18:00";
        public int DurationMinutes { get; set; } = 60;
        public Guid? InstructorPersonId { get; set; }
        public List<Guid> TypeIds { get; set; } = [];
    }

    public class AddTypeForm
    {
        public string Name { get; set; } = "";
        public string ColorHex { get; set; } = "#707886";
    }

    public class EditSessionForm
    {
        public string Name { get; set; } = "";
        public DateOnly Date { get; set; } = DateOnly.FromDateTime(DateTime.Today);
        public string Start { get; set; } = "18:00";
        public int DurationMinutes { get; set; } = 60;
        public Guid? InstructorPersonId { get; set; }

        /// <summary>"one" | "series" — the #170 scope choice (template classes only).</summary>
        public string Scope { get; set; } = "one";
    }

    public class EditTemplateForm
    {
        public string Name { get; set; } = "";
        public DayOfWeek Day { get; set; } = DayOfWeek.Monday;
        public string Start { get; set; } = "18:00";
        public int DurationMinutes { get; set; } = 60;
        public Guid? InstructorPersonId { get; set; }
        public List<Guid> TypeIds { get; set; } = [];
    }

    public class RestoreTemplateForm
    {
        public Guid? TemplateId { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        _weekStart = Weeks.WeekOf(DateOnly.TryParse(StartRaw, out var parsed) ? parsed : DateOnly.FromDateTime(DateTime.Today));
        await using var db = await DbFactory.CreateDbContextAsync();
        _settings = await db.GymSettings.SingleOrDefaultAsync();
        _sessions = await Schedule.GetWeekAsync(_weekStart);
        _types = await db.ClassTypes.Where(t => !t.Archived).OrderBy(t => t.Name).ToListAsync();
        _requests = await db.SubstitutionRequests
            .Include(r => r.Session)
            .Where(r => r.Status == SubstitutionStatus.Requested || r.Status == SubstitutionStatus.PendingApproval)
            .OrderBy(r => r.Session.Date)
            .ToListAsync();

        var instructorPersons = await db.Persons
            .Where(p => !p.Archived && p.Roles.HasFlag(PersonRoles.Instructor))
            .OrderBy(p => p.FirstName)
            .ToListAsync();
        _instructors = instructorPersons.Select(p => (p.Id, p.DisplayName)).ToList();

        var nameIds = _sessions.Where(s => s.InstructorPersonId != null).Select(s => s.InstructorPersonId!.Value)
            .Concat(_requests.SelectMany(r => new[] { r.RequestedByPersonId, r.ProposedSubPersonId ?? Guid.Empty, r.AcceptedByPersonId ?? Guid.Empty }))
            .Where(id => id != Guid.Empty)
            .Distinct().ToList();
        _personNames = await db.Persons.Where(p => nameIds.Contains(p.Id)).ToDictionaryAsync(p => p.Id, p => p.DisplayName);

        _pausedTemplates = await db.ClassTemplates.Where(t => !t.Active).OrderBy(t => t.Name).ToListAsync();
        RestoreForm!.TemplateId ??= _pausedTemplates.FirstOrDefault()?.Id;

        LoadOpenClose();

        if (Guid.TryParse(EditRaw, out var editId))
        {
            _editSession = _sessions.FirstOrDefault(s => s.Id == editId);
            if (_editSession?.TemplateId is { } templateId)
            {
                _editTemplate = await db.ClassTemplates
                    .Include(t => t.ClassTypes)
                    .SingleOrDefaultAsync(t => t.Id == templateId);
            }

            // Prefill unless THIS form was the one posted (a failed submit keeps
            // the binder's values so validation messages match what's on screen).
            var postedHandler = HttpContext?.Request.Method == "POST"
                ? HttpContext.Request.Form["_handler"].ToString()
                : null;

            if (_editSession is { } session && postedHandler != "edit-session")
            {
                SessionForm!.Name = session.Name;
                SessionForm.Date = session.Date;
                SessionForm.Start = session.StartTime.ToString("HH\\:mm");
                SessionForm.DurationMinutes = session.DurationMinutes;
                SessionForm.InstructorPersonId = session.InstructorPersonId;
            }

            if (_editTemplate is { } template && postedHandler != "edit-template")
            {
                TemplateEdit!.Name = template.Name;
                TemplateEdit.Day = template.Day;
                TemplateEdit.Start = template.StartTime.ToString("HH\\:mm");
                TemplateEdit.DurationMinutes = template.DurationMinutes;
                TemplateEdit.InstructorPersonId = template.DefaultInstructorPersonId;
                TemplateEdit.TypeIds = template.ClassTypes.Select(t => t.Id).ToList();
            }
        }
    }

    private static int MinutesOf(TimeOnly time) => (int)time.ToTimeSpan().TotalMinutes;

    private void LoadOpenClose()
    {
        (_open, _close) = _settings is null ? (new TimeOnly(6, 0), new TimeOnly(22, 0)) : (_settings.OpenTime, _settings.CloseTime);
        if (_close <= _open)
        {
            (_open, _close) = (new TimeOnly(6, 0), new TimeOnly(22, 0));
        }
    }

    private async Task AddTemplateAsync()
    {
        var form = TemplateForm!;
        if (string.IsNullOrWhiteSpace(form.Name) || !TimeOnly.TryParse(form.Start, out var start))
        {
            _templateError = "A name and a valid HH:mm start time are required.";
            return;
        }

        // #179: creation goes through the service — same shape/instructor/type
        // validation as template edits, and StartDate lands so the new pattern
        // never retro-fills past weeks (ADR 0004).
        try
        {
            await Schedule.CreateTemplateAsync(form.Name, form.Day, start, form.DurationMinutes, form.InstructorPersonId, form.TypeIds);
        }
        catch (InvalidOperationException ex)
        {
            _templateError = ex.Message;
            return;
        }

        Nav.NavigateTo($"/admin/schedule?start={_weekStart:yyyy-MM-dd}");
    }

    private string WeekUrl => $"/admin/schedule?start={_weekStart:yyyy-MM-dd}";

    private async Task SaveSessionAsync()
    {
        var form = SessionForm!;
        if (_editSession is null)
        {
            return;
        }

        if (!TimeOnly.TryParseExact(form.Start, "HH\\:mm", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var start))
        {
            _sessionError = "Start must be a valid HH:mm time.";
            return;
        }

        try
        {
            if (form.Scope == "series" && _editSession.TemplateId is not null)
            {
                await Schedule.UpdateSeriesAsync(_editSession.Id, form.Name, form.Date, start, form.DurationMinutes, form.InstructorPersonId);
            }
            else
            {
                await Schedule.UpdateSessionAsync(_editSession.Id, form.Name, form.Date, start, form.DurationMinutes, form.InstructorPersonId);
            }

            // Follow the session to wherever it landed — its (possibly new) week.
            Nav.NavigateTo($"/admin/schedule?start={GymStation.Domain.Scheduling.Weeks.WeekOf(form.Date):yyyy-MM-dd}");
        }
        catch (InvalidOperationException ex)
        {
            _sessionError = ex.Message;
        }
    }

    private async Task SaveTemplateAsync()
    {
        var form = TemplateEdit!;
        if (_editTemplate is null || _editSession is null)
        {
            return;
        }

        if (!TimeOnly.TryParseExact(form.Start, "HH\\:mm", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var start))
        {
            _templateEditError = "Start must be a valid HH:mm time.";
            return;
        }

        try
        {
            await Schedule.UpdateTemplateAsync(
                _editTemplate.Id, form.Name, form.Day, start, form.DurationMinutes, form.InstructorPersonId, form.TypeIds);
            Nav.NavigateTo($"{WeekUrl}&edit={_editSession.Id}");
        }
        catch (InvalidOperationException ex)
        {
            _templateEditError = ex.Message;
        }
    }

    private async Task PauseTemplateAsync()
    {
        if (_editTemplate is null)
        {
            return;
        }

        await Schedule.SetTemplateActiveAsync(_editTemplate.Id, false);
        Nav.NavigateTo(WeekUrl);
    }

    private async Task RestoreTemplateAsync()
    {
        if (RestoreForm!.TemplateId is { } templateId)
        {
            await Schedule.SetTemplateActiveAsync(templateId, true);
        }

        Nav.NavigateTo(WeekUrl);
    }

    private async Task AddTypeAsync()
    {
        var form = TypeForm!;

        // Rendered into style attributes later — only a strict hex color is stored.
        var color = System.Text.RegularExpressions.Regex.IsMatch(form.ColorHex, "^#[0-9a-fA-F]{6}$")
            ? form.ColorHex
            : "#707886";

        if (!string.IsNullOrWhiteSpace(form.Name))
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            db.ClassTypes.Add(new ClassType { Id = Guid.NewGuid(), Name = form.Name.Trim().ToLowerInvariant(), ColorHex = color });
            await db.SaveChangesAsync();
        }

        Nav.NavigateTo($"/admin/schedule?start={_weekStart:yyyy-MM-dd}");
    }
}
