@page "/admin/events"
@attribute [Authorize(Policy = "GymStaff")]
@layout AdminLayout
@using System.Security.Claims
@using GymStation.Domain.Events
@using GymStation.Domain.Notifications
@using GymStation.Infrastructure.Notifications
@* Deliberately the scoped context, not IDbContextFactory: Notifications.Notify adds
   outbox rows to the scoped context and relies on THIS page's SaveChanges to commit
   them atomically with the event. Safe because the layout no longer shares it. *@
@inject GymStationDbContext Db
@inject NotificationService Notifications
@inject NavigationManager Nav

<PageTitle>Events · GymStation</PageTitle>

<h1 class="page-title">EVENTS</h1>
<p class="page-sub">TOURNAMENTS · SEMINARS · GRADINGS — PUBLISHED TO EVERY MEMBER'S FEED</p>

@if (FailedFlag == 1)
{
    <p class="auth-error" role="alert">That flyer was rejected — PNG/JPG/WEBP, 2 MB max. Try again.</p>
}

<div class="detail-cols" style="display:grid;grid-template-columns:1fr 1fr;gap:1.125rem;align-items:start">
    <section>
        <h2 class="section-h">Upcoming</h2>
        @foreach (var gymEvent in _events)
        {
            <div class="form-card" style="margin-bottom:0.5rem">
                <div class="head-row">
                    <a href="/events/@gymEvent.Id" style="text-decoration:none"><b>@gymEvent.Title</b></a>
                    <span class="chip">@gymEvent.Kind.ToString().ToUpperInvariant()</span>
                </div>
                <p class="cap" style="margin:0.25rem 0">
                    @gymEvent.StartsOn.ToString("ddd dd MMM yyyy").ToUpperInvariant()
                    · @_counts.GetValueOrDefault((gymEvent.Id, RsvpStatus.Going)) GOING
                    · @_counts.GetValueOrDefault((gymEvent.Id, RsvpStatus.Interested)) INTERESTED
                </p>
                @* Flyer tile (#130) — the image is the picker, same as every image. *@
                <div class="row-form" style="margin-top:0.375rem;align-items:center">
                    <label class="media-edit@(gymEvent.ImagePath is null ? " media-edit--empty" : null)" for="evimg-@gymEvent.Id"
                           title="Click to set the event flyer" style="@(gymEvent.ImagePath is null ? "width:3.5rem;height:3.5rem" : null)">
                        @if (gymEvent.ImagePath is not null)
                        {
                            <img src="/media/event/@gymEvent.Id" alt="Flyer for @gymEvent.Title" style="width:3.5rem;height:3.5rem;border-radius:0.5rem;object-fit:cover" />
                        }
                        else
                        {
                            <span class="cap" style="margin:0;line-height:1.2">FLYER</span>
                        }
                        <span class="media-edit-veil" aria-hidden="true"><Glyph Name="pencil" /></span>
                    </label>
                    <MediaCropUpload Kind="event" Label="flyer" Aspect="1" OutWidth="1024"
                                     Action="/admin/actions/upload-event-image" InputId="@($"evimg-{gymEvent.Id}")" Overlay="true"
                                     Hint="SQUARE FLYER · IG-POST FORMAT">
                        <input type="hidden" name="eventId" value="@gymEvent.Id" />
                    </MediaCropUpload>
                </div>
            </div>
        }
        @if (_events.Count == 0)
        {
            <p class="cap">NO UPCOMING EVENTS.</p>
        }

        <h2 class="section-h">Past — last 12 months</h2>
        @foreach (var gymEvent in _past)
        {
            <div class="form-card" style="margin-bottom:0.5rem;opacity:.75">
                <div class="head-row">
                    <a href="/events/@gymEvent.Id" style="text-decoration:none"><b>@gymEvent.Title</b></a>
                    <span class="chip">@gymEvent.Kind.ToString().ToUpperInvariant()</span>
                </div>
                <p class="cap" style="margin:0.25rem 0">
                    @gymEvent.StartsOn.ToString("ddd dd MMM yyyy").ToUpperInvariant()
                    · @_counts.GetValueOrDefault((gymEvent.Id, RsvpStatus.Going)) GOING
                    · @_counts.GetValueOrDefault((gymEvent.Id, RsvpStatus.Interested)) INTERESTED
                </p>
            </div>
        }
        @if (_past.Count == 0)
        {
            <p class="cap">NO PAST EVENTS IN THE LAST YEAR.</p>
        }
    </section>

    <section>
        <h2 class="section-h">Publish event</h2>
        <EditForm class="form-card" FormName="add-event" Model="Form" OnValidSubmit="PublishAsync">
            <label for="etitle">Title</label>
            <InputText id="etitle" @bind-Value="Form!.Title" />
            @* Forms can't nest (#130): the flyer attaches right after publishing,
               via the new card's image tile in the Upcoming list. *@
            <p class="cap" style="margin:0.375rem 0 0">FLYER: PUBLISH FIRST, THEN CLICK THE NEW CARD'S IMAGE TILE (SQUARE, IG-POST FORMAT).</p>
            <div class="form-grid">
                <div>
                    <label for="ekind">Kind</label>
                    <InputSelect id="ekind" @bind-Value="Form!.Kind">
                        @foreach (var kind in Enum.GetValues<GymEventKind>())
                        {
                            <option value="@kind">@kind</option>
                        }
                    </InputSelect>
                </div>
                <div>
                    <label for="eon">Date</label>
                    <InputDate id="eon" @bind-Value="Form!.StartsOn" />
                </div>
                <div>
                    <label for="etime">Time info</label>
                    <InputText id="etime" @bind-Value="Form!.TimeInfo" placeholder="after comp class" />
                </div>
                <div>
                    <label for="estart">Start (HH:mm — positions it on both schedules; empty = all-day banner)</label>
                    <InputText id="estart" @bind-Value="Form!.Start" placeholder="11:00" />
                </div>
                <div>
                    <label for="edur">Duration (minutes)</label>
                    <InputNumber id="edur" @bind-Value="Form!.DurationMinutes" />
                </div>
                <div>
                    <label for="eloc">Location</label>
                    <InputText id="eloc" @bind-Value="Form!.Location" />
                </div>
            </div>
            <label for="edet">Details</label>
            <InputTextArea id="edet" @bind-Value="Form!.Details" rows="3" />
            <p class="cap" style="margin-top:0.25rem">MARKDOWN: **BOLD** · _ITALIC_ · ++UNDERLINE++ · - LISTS</p>
            @if (_error is not null)
            {
                <p class="validation-message">@_error</p>
            }
            <p style="margin-top:0.75rem"><button class="btn" type="submit">PUBLISH — NOTIFIES MEMBERS</button></p>
        </EditForm>
    </section>
</div>

@code {
    [CascadingParameter] public HttpContext? HttpContext { get; set; }

    [SupplyParameterFromQuery(Name = "failed")] public int? FailedFlag { get; set; }

    // Parameter name MUST match the identifier bound in markup: SSR form inputs render
    // names from the bind expression ("Form.Title"), and the binder matches them against
    // the parameter's name. An alias property here silently breaks every submit.
    [SupplyParameterFromForm(FormName = "add-event")]
    public EventForm? Form { get; set; }

    protected override void OnInitialized() => Form ??= new();

    private List<GymEvent> _events = [];
    private List<GymEvent> _past = [];
    private Dictionary<(Guid, RsvpStatus), int> _counts = [];
    private string? _error;

    public class EventForm
    {
        public string Title { get; set; } = "";
        public GymEventKind Kind { get; set; } = GymEventKind.Tournament;
        public DateOnly StartsOn { get; set; } = DateOnly.FromDateTime(DateTime.Today).AddDays(14);
        public string? TimeInfo { get; set; }
        public string? Start { get; set; }
        public int? DurationMinutes { get; set; }
        public string? Location { get; set; }
        public string? Details { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        _events = await Db.GymEvents.Where(e => e.StartsOn >= today.AddDays(-1)).OrderBy(e => e.StartsOn).ToListAsync();
        _past = await Db.GymEvents
            .Where(e => e.StartsOn < today.AddDays(-1) && e.StartsOn >= today.AddYears(-1))
            .OrderByDescending(e => e.StartsOn)
            .ToListAsync();
        var ids = _events.Concat(_past).Select(e => e.Id).ToList();
        var rsvps = await Db.EventRsvps.Where(r => ids.Contains(r.EventId)).ToListAsync();
        _counts = rsvps.GroupBy(r => (r.EventId, r.Status)).ToDictionary(g => g.Key, g => g.Count());
    }

    private async Task PublishAsync()
    {
        var form = Form!;
        if (string.IsNullOrWhiteSpace(form.Title))
        {
            _error = "A title is required.";
            return;
        }

        var raw = HttpContext?.User.FindFirstValue(ClaimTypes.NameIdentifier);
        TimeOnly? startTime = null;
        if (!string.IsNullOrWhiteSpace(form.Start))
        {
            if (!TimeOnly.TryParseExact(form.Start.Trim(), "HH\\:mm", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var parsed))
            {
                _error = "Start must be HH:mm (24h), or empty for an all-day banner.";
                return;
            }

            if (form.DurationMinutes is not null and (< 15 or > 720))
            {
                _error = "Duration must be 15–720 minutes (or empty).";
                return;
            }

            startTime = parsed;
        }

        Guid publisherPersonId = Guid.Empty;
        if (Guid.TryParse(raw, out var userId))
        {
            publisherPersonId = (await Db.Persons.SingleOrDefaultAsync(p => p.UserId == userId))?.Id ?? Guid.Empty;
        }

        var title = form.Title.Trim();
        Db.GymEvents.Add(new GymEvent
        {
            Id = Guid.NewGuid(),
            Title = title,
            Kind = form.Kind,
            StartsOn = form.StartsOn,
            TimeInfo = form.TimeInfo,
            StartTime = startTime,
            DurationMinutes = startTime is null ? null : form.DurationMinutes,
            Location = form.Location,
            Details = form.Details,
            PublishedByPersonId = publisherPersonId,
        });

        var memberUserIds = await Db.Persons
            .Where(p => !p.Archived && p.UserId != null && p.Roles.HasFlag(PersonRoles.Member))
            .Select(p => p.UserId!.Value)
            .Distinct()
            .ToListAsync();
        Notifications.Notify(
            memberUserIds,
            NotificationCategory.SessionChanged,
            $"New event: {title}",
            $"{form.Kind} on {form.StartsOn:dddd dd MMMM}. RSVP from the Events tab.",
            "/events",
            email: false);

        await Db.SaveChangesAsync();
        Nav.NavigateTo("/admin/events");
    }
}
