@page "/admin/settings"
@attribute [Authorize(Policy = "GymStaff")]
@layout AdminLayout
@using GymStation.Domain.Tenancy
@inject IDbContextFactory<GymStationDbContext> DbFactory
@inject NavigationManager Nav

<PageTitle>Settings · GymStation</PageTitle>

<h1 class="page-title">SETTINGS</h1>
<p class="page-sub">WORKFLOW · THEME · MEDIA — SWAP MODE AND CLASS TAGS LIVE ON THE SCHEDULE PAGE</p>

@if (Failed)
{
    <p class="auth-error" role="alert">That change was rejected — check the file type/size or the values and try again.</p>
}

<div class="detail-cols" style="display:grid;grid-template-columns:1fr 1fr;gap:18px;align-items:start">
    <section>
        <h2 class="section-h">Gym settings</h2>
        <EditForm class="form-card" FormName="gym-settings" Model="Form" OnValidSubmit="SaveAsync">
            <div class="form-grid">
                <div>
                    <label for="swin">Self check-in window (minutes before start)</label>
                    <InputNumber id="swin" @bind-Value="Form!.CheckInWindowMinutes" />
                </div>
                <div>
                    <label for="stz">Timezone (offsets are standard/winter time)</label>
                    <InputSelect id="stz" @bind-Value="Form!.TimeZoneId">
                        @foreach (var (id, label) in _timeZones)
                        {
                            <option value="@id">@label</option>
                        }
                    </InputSelect>
                </div>
                <div>
                    <label for="sopen">Mat opens (HH:mm — the schedule's time rail starts here)</label>
                    <InputText id="sopen" @bind-Value="Form!.Open" />
                </div>
                <div>
                    <label for="sclose">Mat closes (HH:mm)</label>
                    <InputText id="sclose" @bind-Value="Form!.Close" />
                </div>
            </div>
            <label for="sacc">Tenant accent — your gym's color on buttons, links, tags, stamps, and the public page (#rrggbb, WCAG-checked against both modes)</label>
            <InputText id="sacc" @bind-Value="Form!.AccentColorHex" />
            <div class="check-row" style="margin-top:10px">
                <label><InputCheckbox @bind-Value="Form!.DefaultThemeDark" /> DARK (MAT) AS THE GYM'S DEFAULT MODE — UNCHECK FOR PAPER LEDGER</label>
            </div>
            @if (_error is not null)
            {
                <p class="validation-message">@_error</p>
            }
            <p style="margin-top:12px"><button class="btn" type="submit">SAVE SETTINGS</button></p>
            <p class="cap">BELT COLORS ARE NOT THEMEABLE — RANK RENDERING IS IDENTICAL IN EVERY GYM.</p>
        </EditForm>
    </section>

    <section>
        <h2 class="section-h">Logo &amp; hero image</h2>
        <div class="form-card">
            <div class="row-form" style="align-items:center">
                @if (_settings?.LogoPath is { } logo)
                {
                    <img src="/media/@logo" alt="Gym logo" style="width:44px;height:44px;border-radius:8px;object-fit:cover" />
                }
                else
                {
                    <span class="crest" style="width:44px;height:44px;border-radius:8px;background:var(--tenant);display:inline-block"></span>
                }
                <MediaCropUpload Kind="logo" Label="logo" Aspect="1" OutWidth="512"
                                 Hint="SQUARE — RENDERS AT ~44PX ON THE RAIL AND TOP BAR" />
            </div>
            <div class="row-form" style="align-items:center;margin-top:14px">
                @if (_settings?.HeroPath is { } hero)
                {
                    <img src="/media/@hero" alt="Public page hero" style="width:96px;height:44px;border-radius:8px;object-fit:cover" />
                }
                else
                {
                    <span class="cap" style="margin:0">HERO: MAT-TEXTURE GRADIENT (NO IMAGE YET)</span>
                }
                <MediaCropUpload Kind="hero" Label="hero" Aspect="@(8 / 3.0)" OutWidth="1600"
                                 Hint="WIDE STRIP — DARKENED BEHIND THE PUBLIC-PAGE TEXT" />
            </div>
            <p class="cap">
                PNG/JPG/WEBP · MAX 2 MB · LOGO: SQUARE, 512×512 OR LARGER (EXPORTED AT 512PX) ·
                HERO: WIDE, 1600×600 OR LARGER (DARKENED BEHIND THE PUBLIC-PAGE TEXT) ·
                SHOWN ON THE RAIL, MEMBER TOP BAR, AND /@_gymSlug
            </p>
        </div>
    </section>
</div>

@code {
    [SupplyParameterFromQuery(Name = "failed")] public int? FailedFlag { get; set; }
    private bool Failed => FailedFlag == 1;

    [SupplyParameterFromForm(FormName = "gym-settings")]
    public SettingsForm? Form { get; set; }

    protected override void OnInitialized() => Form ??= new();

    private GymSettings? _settings;
    private string? _gymSlug;
    private string? _error;
    private List<(string Id, string Label)> _timeZones = [];

    private static readonly string[] CommonZoneIds =
    [
        "America/New_York", "America/Detroit", "America/Chicago", "America/Denver",
        "America/Phoenix", "America/Los_Angeles", "America/Anchorage", "Pacific/Honolulu",
        "America/Toronto", "Europe/London", "Europe/Lisbon", "Europe/Paris", "Europe/Berlin",
        "Asia/Tokyo", "Australia/Sydney", "Pacific/Auckland",
    ];

    public class SettingsForm
    {
        public int CheckInWindowMinutes { get; set; } = 60;
        public string TimeZoneId { get; set; } = "America/Chicago";
        public string AccentColorHex { get; set; } = "#C9503B";
        public bool DefaultThemeDark { get; set; } = true;
        public string Open { get; set; } = "06:00";
        public string Close { get; set; } = "22:00";
    }

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _settings = await db.GymSettings.SingleOrDefaultAsync();
        var gym = await db.Gyms.SingleOrDefaultAsync(g => g.Id == db.CurrentGymId);
        _gymSlug = gym?.Slug;

        if (_settings is not null && HttpContext?.Request.Method != "POST")
        {
            Form!.CheckInWindowMinutes = _settings.CheckInWindowMinutes;
            Form.TimeZoneId = gym?.TimeZoneId ?? "America/Chicago";
            Form.AccentColorHex = _settings.AccentColorHex;
            Form.DefaultThemeDark = _settings.DefaultThemeDark;
            Form.Open = _settings.OpenTime.ToString("HH\\:mm");
            Form.Close = _settings.CloseTime.ToString("HH\\:mm");
        }

        BuildTimeZones();
    }

    private void BuildTimeZones()
    {
        var ids = CommonZoneIds.ToList();

        // The gym's saved zone always appears, even when it isn't in the curated list.
        if (Form?.TimeZoneId is { Length: > 0 } current && !ids.Contains(current))
        {
            ids.Insert(0, current);
        }

        _timeZones = ids
            .Where(id => TimeZoneInfo.TryFindSystemTimeZoneById(id, out _))
            .Select(id =>
            {
                var offset = TimeZoneInfo.FindSystemTimeZoneById(id).BaseUtcOffset;
                var sign = offset < TimeSpan.Zero ? "−" : "+";
                return (id, $"{id} (UTC{sign}{offset.Duration():hh\\:mm})");
            })
            .ToList();
    }

    [CascadingParameter] public HttpContext? HttpContext { get; set; }

    private async Task SaveAsync()
    {
        var form = Form!;
        if (!ThemeMath.IsAccessibleAccent(form.AccentColorHex))
        {
            _error = $"'{form.AccentColorHex}' fails the 3:1 contrast check against {ThemeMath.DarkBackground} (mat) or {ThemeMath.LightBackground} (paper). Pick a stronger mid-tone.";
            return;
        }

        if (form.CheckInWindowMinutes is < 0 or > 24 * 60)
        {
            _error = "Check-in window must be between 0 and 1440 minutes.";
            return;
        }

        if (!TimeZoneInfo.TryFindSystemTimeZoneById(form.TimeZoneId, out _))
        {
            _error = $"Unknown timezone '{form.TimeZoneId}'. Use an IANA id like America/Chicago.";
            return;
        }

        if (!TimeOnly.TryParse(form.Open, out var open) || !TimeOnly.TryParse(form.Close, out var close) || close <= open
            || open.Minute % 30 != 0 || close.Minute % 30 != 0 || (close - open).TotalMinutes < 30)
        {
            _error = "Mat hours need HH:00 or HH:30 times, close after open, spanning at least 30 minutes.";
            return;
        }

        // Entities loaded during OnInitializedAsync belong to a context that is already
        // disposed — re-load inside this handler's own context so the changes track.
        await using var db = await DbFactory.CreateDbContextAsync();
        var settings = await db.GymSettings.SingleOrDefaultAsync();
        if (settings is null)
        {
            return;
        }

        settings.CheckInWindowMinutes = form.CheckInWindowMinutes;
        settings.AccentColorHex = form.AccentColorHex;
        settings.DefaultThemeDark = form.DefaultThemeDark;
        settings.OpenTime = open;
        settings.CloseTime = close;

        var gym = await db.Gyms.SingleAsync(g => g.Id == db.CurrentGymId);
        gym.TimeZoneId = form.TimeZoneId;

        await db.SaveChangesAsync();
        Nav.NavigateTo("/admin/settings");
    }
}
