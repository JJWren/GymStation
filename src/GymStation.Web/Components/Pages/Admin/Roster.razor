@page "/admin/roster"
@attribute [Authorize(Policy = "Cap:ManageRoster")]
@layout AdminLayout
@using GymStation.Infrastructure.Identity
@using Microsoft.AspNetCore.Identity
@inject IDbContextFactory<GymStationDbContext> DbFactory
@inject RankService Ranks
@inject UserManager<AppUser> Users
@inject NavigationManager Nav

<PageTitle>Roster · GymStation</PageTitle>

<div class="head-row">
    <h1 class="page-title">ROSTER</h1>
</div>
<p class="page-sub">@(_people.Count == 0 ? "0" : $"{_pageFrom}–{_pageTo}") OF @_people.Count SHOWN</p>

<div class="filters">
    <form method="get" style="display:contents">
        <input type="search" name="q" value="@Q" placeholder="SEARCH NAME…" aria-label="Search name" />
        <button class="btn btn--ghost" type="submit">SEARCH</button>
    </form>
    @* Grouped filter panel (#219) replaces the chip row: types multi-select,
       age, and a rank facet scoped to a chosen discipline. Plain <details> +
       GET form — SSR, shareable URLs, filters applied before paging. *@
    <details class="filter-panel" open="@(ActiveFilterCount > 0)">
        <summary class="chip">FILTERS@(ActiveFilterCount > 0 ? $" ({ActiveFilterCount})" : null)</summary>
        <form method="get" class="filter-panel-body">
            @if (!string.IsNullOrEmpty(Q))
            {
                <input type="hidden" name="q" value="@Q" />
            }
            <input type="hidden" name="size" value="@_size" />
            <fieldset>
                <legend>PERSON TYPE — ANY CHECKED</legend>
                <label><input type="checkbox" name="tm" value="1" checked="@(TypeMember == 1)" /> MEMBERS</label>
                <label><input type="checkbox" name="tv" value="1" checked="@(TypeVisitor == 1)" /> VISITORS</label>
                <label><input type="checkbox" name="ti" value="1" checked="@(TypeInstructor == 1)" /> INSTRUCTORS</label>
                <label><input type="checkbox" name="ts" value="1" checked="@(TypeStaff == 1)" /> STAFF</label>
            </fieldset>
            <fieldset>
                <legend>AGE GROUP</legend>
                <label><input type="radio" name="age" value="" checked="@(string.IsNullOrEmpty(Age))" /> ALL</label>
                <label><input type="radio" name="age" value="kids" checked="@(Age == "kids")" /> KIDS</label>
                <label><input type="radio" name="age" value="adults" checked="@(Age == "adults")" /> ADULTS</label>
            </fieldset>
            <fieldset>
                <legend>DISCIPLINE &amp; RANK</legend>
                <select name="system" aria-label="Discipline">
                    <option value="">— ANY DISCIPLINE —</option>
                    @foreach (var system in _systems)
                    {
                        <option value="@system.Id" selected="@(SystemFilter == system.Id)">@_labels.GetValueOrDefault(system.Id)?.ToUpperInvariant()</option>
                    }
                </select>
                @* FirstOrDefault, twice over: the first synchronous SSR render
                   happens BEFORE OnInitializedAsync fills _systems, and a stale
                   URL can carry an unknown system id — .First() would 500. *@
                @if (SystemFilter is { } chosenSystem && _systems.FirstOrDefault(s => s.Id == chosenSystem) is { } chosenLadder)
                {
                    @* The rank facet exists only inside a discipline — ranks are
                       meaningless unscoped. Empty = anyone ranked in it. *@
                    <select name="rank" aria-label="Rank within discipline">
                        <option value="">RANKED — ANY BELT</option>
                        <option value="none" selected="@(RankRaw == "none")">NO BELT IN THIS DISCIPLINE</option>
                        @foreach (var rank in chosenLadder.Ranks.OrderBy(r => r.Order))
                        {
                            <option value="@rank.Id" selected="@(RankFilter == rank.Id)">@rank.Name</option>
                        }
                    </select>
                }
                else
                {
                    <span class="cap">PICK A DISCIPLINE, APPLY, THEN PICK A RANK.</span>
                }
            </fieldset>
            <button class="btn btn--ghost" type="submit">APPLY</button>
        </form>
    </details>
    @foreach (var (label, href) in AppliedPills)
    {
        <a class="chip active" href="@href" title="Remove this filter">@label ✕</a>
    }
</div>

<table class="ledger-table">
    <thead>
        <tr>
            <th><a href="@SortHref("first")">First @Arrow("first")</a> / <a href="@SortHref("last")">Last @Arrow("last")</a></th>
            <th><a href="@SortHref("rank")">Rank @Arrow("rank")</a></th>
            <th><a href="@SortHref("tenure")">At rank @Arrow("tenure")</a></th>
            <th>Roles</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var person in _view)
    {
        var rank = _ranks.GetValueOrDefault(person.Id);
        <tr>
            <td class="nm">
                <a href="/admin/people/@person.Id">@person.DisplayName</a>
                <i>
                    @RoleLine(person)
                    @if (person.UserId is null)
                    {
                        <text> · NO LOGIN</text>
                    }
                </i>
            </td>
            <td>
                @if (rank is not null)
                {
                    <BeltBar Size="s" BandColorHex="@rank.Rank.BandColorHex" BarColorHex="@rank.Rank.BarColorHex"
                             Stripes="@rank.Stripes" Label="@($"{rank.Rank.Name}, {rank.Stripes} stripes — {_labels.GetValueOrDefault(rank.Rank.RankSystemId)}")" />
                    <span class="cap">@_labels.GetValueOrDefault(rank.Rank.RankSystemId)?.ToUpperInvariant()</span>
                }
                else
                {
                    <span class="mono">—</span>
                }
            </td>
            <td class="mono">@(rank is null ? "—" : RankProgress.FormatDuration(Today.ToDateTime(TimeOnly.MinValue) - rank.AtRankSince.ToDateTime(TimeOnly.MinValue)))</td>
            <td class="mono">@person.Roles.ToString().ToUpperInvariant()</td>
        </tr>
    }
    </tbody>
</table>

<Pager Path="/admin/roster" Page="@_page" PageCount="@_pageCount" Size="@_size" Preserve="@PreservedQuery" />

<h2 class="section-h">Add person</h2>
<EditForm class="form-card" FormName="add-person" Model="Form" OnValidSubmit="AddPersonAsync">
    <div class="form-grid">
        <div>
            <label for="first">First name</label>
            <InputText id="first" @bind-Value="Form!.FirstName" />
        </div>
        <div>
            <label for="last">Last name</label>
            <InputText id="last" @bind-Value="Form!.LastName" />
        </div>
        <div>
            <label for="dob">Date of birth (age groups, kids ladders)</label>
            <InputDate id="dob" @bind-Value="Form!.DateOfBirth" />
        </div>
        <div>
            <label for="email">Link login by email (optional — leave empty for kids / no-device members)</label>
            <InputText id="email" @bind-Value="Form!.LinkEmail" type="email" />
        </div>
    </div>
    <div class="check-row">
        <label><InputCheckbox @bind-Value="Form!.IsMember" /> MEMBER</label>
        <label><InputCheckbox @bind-Value="Form!.IsInstructor" /> INSTRUCTOR</label>
        <label><InputCheckbox @bind-Value="Form!.IsAdmin" /> ADMIN</label>
        <label><InputCheckbox @bind-Value="Form!.IsStaff" /> STAFF (FRONT DESK/OPS)</label>
        <label><InputCheckbox @bind-Value="Form!.IsVisitor" /> VISITOR (DROP-IN, NO PLAN)</label>
    </div>
    @if (_formError is not null)
    {
        <p class="validation-message">@_formError</p>
    }
    <p style="margin-top:0.875rem"><button class="btn btn--icon btn--save" type="submit" aria-label="Add to roster" title="Add to roster"><Glyph Name="save" /></button></p>
</EditForm>

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }
    [SupplyParameterFromQuery(Name = "tm")] public int? TypeMember { get; set; }
    [SupplyParameterFromQuery(Name = "tv")] public int? TypeVisitor { get; set; }
    [SupplyParameterFromQuery(Name = "ti")] public int? TypeInstructor { get; set; }
    [SupplyParameterFromQuery(Name = "ts")] public int? TypeStaff { get; set; }
    [SupplyParameterFromQuery(Name = "age")] public string? Age { get; set; }
    [SupplyParameterFromQuery(Name = "system")] public string? SystemRaw { get; set; }
    [SupplyParameterFromQuery(Name = "rank")] public string? RankRaw { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? Sort { get; set; }
    [SupplyParameterFromQuery(Name = "dir")] public string? Dir { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public int? PageRaw { get; set; }
    [SupplyParameterFromQuery(Name = "size")] public int? SizeRaw { get; set; }

    private Guid? SystemFilter => Guid.TryParse(SystemRaw, out var id) ? id : null;

    private int ActiveFilterCount =>
        (TypeMember == 1 ? 1 : 0) + (TypeVisitor == 1 ? 1 : 0) + (TypeInstructor == 1 ? 1 : 0) + (TypeStaff == 1 ? 1 : 0)
        + (string.IsNullOrEmpty(Age) ? 0 : 1)
        + (SystemFilter is null ? 0 : 1)
        + (string.IsNullOrEmpty(RankRaw) ? 0 : 1);

    /// <summary>One removable pill per applied filter: the link is the same URL
    /// minus that filter (rank rides along with its discipline).</summary>
    private IEnumerable<(string Label, string Href)> AppliedPills
    {
        get
        {
            if (TypeMember == 1) { yield return ("MEMBERS", Without("tm")); }
            if (TypeVisitor == 1) { yield return ("VISITORS", Without("tv")); }
            if (TypeInstructor == 1) { yield return ("INSTRUCTORS", Without("ti")); }
            if (TypeStaff == 1) { yield return ("STAFF", Without("ts")); }
            if (Age is "kids" or "adults") { yield return (Age.ToUpperInvariant(), Without("age")); }
            if (SystemFilter is { } systemId)
            {
                yield return ((_labels.GetValueOrDefault(systemId) ?? "DISCIPLINE").ToUpperInvariant(), Without("system", "rank"));
                if (RankRaw == "none")
                {
                    yield return ("NO BELT", Without("rank"));
                }
                else if (RankFilter is { } rankId)
                {
                    var rankName = _systems.FirstOrDefault(s => s.Id == systemId)?.Ranks.FirstOrDefault(r => r.Id == rankId)?.Name;
                    yield return ((rankName ?? "RANK").ToUpperInvariant(), Without("rank"));
                }
            }
        }
    }

    private string Without(params string[] dropKeys)
    {
        var kept = PreservedQuery
            .Where(kv => !string.IsNullOrEmpty(kv.Value) && !dropKeys.Contains(kv.Key))
            .Select(kv => $"{kv.Key}={Uri.EscapeDataString(kv.Value!)}")
            .ToList();
        kept.Add($"size={_size}");
        return $"/admin/roster?{string.Join('&', kept)}";
    }

    private int _page = 1;
    private int _pageCount = 1;
    private int _size = Pager.DefaultSize;
    private int _pageFrom;
    private int _pageTo;
    private List<Person> _view = [];

    private Dictionary<string, string?> PreservedQuery => new()
    {
        ["q"] = Q,
        ["tm"] = TypeMember == 1 ? "1" : null,
        ["tv"] = TypeVisitor == 1 ? "1" : null,
        ["ti"] = TypeInstructor == 1 ? "1" : null,
        ["ts"] = TypeStaff == 1 ? "1" : null,
        ["age"] = string.IsNullOrEmpty(Age) ? null : Age,
        ["system"] = SystemFilter?.ToString(),
        ["rank"] = RankRaw,
        ["sort"] = Sort,
        ["dir"] = Dir,
    };

    private Guid? RankFilter => Guid.TryParse(RankRaw, out var id) ? id : null;

    [SupplyParameterFromForm(FormName = "add-person")]
    public AddPersonForm? Form { get; set; }

    protected override void OnInitialized() => Form ??= new();

    private List<Person> _people = [];
    private Dictionary<Guid, CurrentRank> _ranks = [];
    private List<RankSystem> _systems = [];
    private Dictionary<Guid, string> _labels = [];
    private string? _formError;
    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Today);

    public class AddPersonForm
    {
        public string FirstName { get; set; } = "";
        public string LastName { get; set; } = "";
        public DateOnly? DateOfBirth { get; set; }
        public string? LinkEmail { get; set; }
        // No silent default: adding someone requires an explicit choice (#81).
        public bool IsMember { get; set; }
        public bool IsInstructor { get; set; }
        public bool IsAdmin { get; set; }
        public bool IsStaff { get; set; }
        public bool IsVisitor { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var query = db.Persons.Where(p => !p.Archived);

        if (!string.IsNullOrWhiteSpace(Q))
        {
            // Postgres ILIKE: culture-safe case-insensitivity; escape LIKE wildcards
            // in user input. The escape char must be declared — the two-arg ILike
            // translation applies NO escape, leaving backslashes literal (#182 find).
            var pattern = "%" + Q.Trim()
                .Replace(@"\", @"\\")
                .Replace("%", @"\%")
                .Replace("_", @"\_") + "%";
            query = query.Where(p => EF.Functions.ILike(p.FirstName + " " + p.LastName, pattern, @"\"));
        }

        // Person types union WITHIN the group (#219), then AND with the rest.
        // Visitors carry the Member role for portal purposes but are not members
        // of record — MEMBERS excludes them so the filter means something (#29).
        var anyType = TypeMember == 1 || TypeVisitor == 1 || TypeInstructor == 1 || TypeStaff == 1;
        if (anyType)
        {
            var wantMember = TypeMember == 1;
            var wantVisitor = TypeVisitor == 1;
            var wantInstructor = TypeInstructor == 1;
            var wantStaff = TypeStaff == 1;
            query = query.Where(p =>
                (wantMember && p.Roles.HasFlag(PersonRoles.Member) && !p.Visitor)
                || (wantVisitor && p.Visitor)
                || (wantInstructor && p.Roles.HasFlag(PersonRoles.Instructor))
                || (wantStaff && p.Roles.HasFlag(PersonRoles.Staff)));
        }

        query = Age switch
        {
            "kids" => query.Where(p => p.DateOfBirth != null && p.DateOfBirth > Today.AddYears(-16)),
            "adults" => query.Where(p => p.DateOfBirth == null || p.DateOfBirth <= Today.AddYears(-16)),
            _ => query,
        };

        _people = await query.OrderBy(p => p.FirstName).ThenBy(p => p.LastName).ToListAsync();
        _ranks = await Ranks.GetPrimaryRanksAsync(_people.Select(p => p.Id).ToList());
        _systems = await Ranks.GetVisibleSystemsAsync();
        _labels = await Ranks.GetDisciplineLabelsAsync();

        // Discipline facet: rank columns and the rank filter both speak the
        // CHOSEN system's current ranks; without one, the primary rank leads.
        // An unknown system id (stale URL) is ignored, never an empty page.
        if (SystemFilter is { } chosenSystemId && _systems.Any(s => s.Id == chosenSystemId))
        {
            var inSystem = await Ranks.GetCurrentRanksInSystemAsync(_people.Select(p => p.Id).ToList(), chosenSystemId);
            _people = RankRaw switch
            {
                "none" => [.. _people.Where(p => !inSystem.ContainsKey(p.Id))],
                _ when RankFilter is { } rankId => [.. _people.Where(p => inSystem.GetValueOrDefault(p.Id)?.Rank.Id == rankId)],
                _ => [.. _people.Where(p => inSystem.ContainsKey(p.Id))],
            };
            _ranks = inSystem;
        }

        ApplySort();

        // Page AFTER filter + sort; a too-high page request clamps to the last page.
        _size = Pager.ResolveSize(SizeRaw);
        (_page, _pageCount) = Pager.Resolve(PageRaw, _people.Count, _size);
        _view = _people.Skip((_page - 1) * _size).Take(_size).ToList();
        _pageFrom = _people.Count == 0 ? 0 : (_page - 1) * _size + 1;
        _pageTo = _pageFrom + _view.Count - 1;
    }

    private void ApplySort()
    {
        var desc = Dir == "desc";
        _people = Sort switch
        {
            "first" when desc => [.. _people.OrderByDescending(p => p.FirstName).ThenByDescending(p => p.LastName)],
            "last" => desc
                ? [.. _people.OrderByDescending(p => p.LastName).ThenByDescending(p => p.FirstName)]
                : [.. _people.OrderBy(p => p.LastName).ThenBy(p => p.FirstName)],
            "rank" => desc
                ? [.. _people.OrderByDescending(p => RankOrdering.Key(_ranks.GetValueOrDefault(p.Id))).ThenBy(p => p.FirstName).ThenBy(p => p.LastName)]
                : [.. _people.OrderBy(p => RankOrdering.Key(_ranks.GetValueOrDefault(p.Id))).ThenBy(p => p.FirstName).ThenBy(p => p.LastName)],
            "tenure" => desc
                ? [.. _people.OrderByDescending(TenureDays).ThenBy(p => p.FirstName).ThenBy(p => p.LastName)]
                : [.. _people.OrderBy(p => TenureDays(p) < 0 ? int.MaxValue : TenureDays(p)).ThenBy(p => p.FirstName).ThenBy(p => p.LastName)],
            _ => _people, // default: first-name ascending straight from the query
        };
    }

    private int TenureDays(Person person)
        => _ranks.GetValueOrDefault(person.Id) is { } rank ? Today.DayNumber - rank.AtRankSince.DayNumber : -1;

    private string SortHref(string key)
    {
        var dir = Sort == key && Dir != "desc" ? "desc" : "asc";
        var parts = new List<string> { $"sort={key}", $"dir={dir}" };
        foreach (var (paramKey, value) in PreservedQuery)
        {
            if (paramKey is not ("sort" or "dir") && !string.IsNullOrEmpty(value))
            {
                parts.Add($"{paramKey}={Uri.EscapeDataString(value)}");
            }
        }

        // Re-sorting resets to page 1 on purpose but keeps the chosen page size.
        parts.Add($"size={_size}");

        return "/admin/roster?" + string.Join("&", parts);
    }

    private string Arrow(string key) => Sort == key ? (Dir == "desc" ? "▼" : "▲") : "";

    private static string RoleLine(Person p)
    {
        var joined = $"JOINED {p.JoinedOn.Year}";
        var line = p.DateOfBirth is { } dob
            ? $"{IbjjfAgeGroup.FromBirthDate(dob, Today)?.ToUpperInvariant() ?? "—"} · {joined}"
            : joined;
        return p.Visitor ? $"VISITOR · {line}" : line;
    }

    private async Task AddPersonAsync()
    {
        var form = Form!;
        if (string.IsNullOrWhiteSpace(form.FirstName) || string.IsNullOrWhiteSpace(form.LastName))
        {
            _formError = "First and last name are required.";
            return;
        }

        var roles = PersonRoles.None;
        if (form.IsMember) roles |= PersonRoles.Member;
        if (form.IsInstructor) roles |= PersonRoles.Instructor;
        if (form.IsAdmin) roles |= PersonRoles.Admin;
        if (form.IsStaff) roles |= PersonRoles.Staff;

        // Nothing checked used to silently create a Member — now the choice is
        // mandatory. A visitor-only tick gets the standard visitor shape (#29):
        // Member role for portal purposes plus the Visitor flag.
        if (roles == PersonRoles.None && !form.IsVisitor)
        {
            _formError = "Pick at least one: member, instructor, admin, staff, or visitor.";
            return;
        }

        // The #29 visitor shape always carries the Member role for portal purposes —
        // whether visitor was ticked alone or alongside staff roles.
        if (form.IsVisitor)
        {
            roles |= PersonRoles.Member;
        }

        Guid? userId = null;
        if (!string.IsNullOrWhiteSpace(form.LinkEmail) && roles == PersonRoles.Staff)
        {
            _formError = "Staff-only grants no portal — skip the login link, or add MEMBER alongside STAFF.";
            return;
        }

        if (!string.IsNullOrWhiteSpace(form.LinkEmail))
        {
            var user = await Users.FindByEmailAsync(form.LinkEmail.Trim());
            if (user is null)
            {
                _formError = $"No login exists for {form.LinkEmail}. Leave it empty, or have them register first.";
                return;
            }
            userId = user.Id;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        db.Persons.Add(new Person
        {
            Id = Guid.NewGuid(),
            FirstName = form.FirstName.Trim(),
            LastName = form.LastName.Trim(),
            DateOfBirth = form.DateOfBirth,
            UserId = userId,
            Roles = roles,
            Visitor = form.IsVisitor,
            JoinedOn = Today,
        });
        await db.SaveChangesAsync();

        Nav.NavigateTo("/admin/roster");
    }
}
