@page "/admin/landing"
@attribute [Authorize(Policy = "GymStaff")]
@layout AdminLayout
@using GymStation.Domain.Tenancy
@inject IDbContextFactory<GymStationDbContext> DbFactory
@inject NavigationManager Nav

<PageTitle>Landing · GymStation</PageTitle>

<h1 class="page-title">LANDING</h1>
<p class="page-sub">YOUR PUBLIC PAGE'S CONTENT — STRIP ANCHORS · VISIT BLOCK · LOGO &amp; HERO@(_gymSlug is null ? null : " · ")@if (_gymSlug is not null)
    {
        <a href="/@_gymSlug">VIEW IT LIVE ▸</a>
    }</p>

@if (Failed)
{
    <p class="auth-error" role="alert">That change was rejected — check the file type/size or the values and try again.</p>
}

<div class="detail-cols" style="display:grid;grid-template-columns:1fr 1fr;gap:1.125rem;align-items:start">
    <section>
        <h2 class="section-h">Strip &amp; visit</h2>
        <EditForm class="form-card" FormName="landing-content" Model="Form" OnValidSubmit="SaveAsync">
            <p class="cap" style="margin:0 0 0.5rem">
                THE STRIP UNDER YOUR GYM NAME — EACH LABEL IS A REAL ANCHOR THAT SCROLLS TO ITS SECTION.
            </p>
            <div class="form-grid">
                <div>
                    <label for="lts">Schedule label</label>
                    <InputText id="lts" @bind-Value="Form!.TaglineSchedule" />
                </div>
                <div>
                    <label for="lti">Instructors label</label>
                    <InputText id="lti" @bind-Value="Form!.TaglineInstructors" />
                </div>
                <div>
                    <label for="ltv">Visit label</label>
                    <InputText id="ltv" @bind-Value="Form!.TaglineVisit" />
                </div>
            </div>

            <p class="cap" style="margin:0.875rem 0 0.5rem">
                THE VISIT BLOCK — HOW A WALK-IN ACTUALLY FINDS YOU. EMPTY FIELDS SIMPLY DON'T RENDER.
            </p>
            <label for="lva">Address</label>
            <InputText id="lva" @bind-Value="Form!.VisitAddress" />
            <div class="form-grid" style="margin-top:0.5rem">
                <div>
                    <label for="lvp">Phone</label>
                    <InputText id="lvp" @bind-Value="Form!.VisitPhone" />
                </div>
                <div>
                    <label for="lve">Email</label>
                    <InputText id="lve" @bind-Value="Form!.VisitEmail" type="email" />
                </div>
                <div>
                    <label for="lsi">Instagram URL</label>
                    <InputText id="lsi" @bind-Value="Form!.SocialInstagram" />
                </div>
                <div>
                    <label for="lsf">Facebook URL</label>
                    <InputText id="lsf" @bind-Value="Form!.SocialFacebook" />
                </div>
                <div>
                    <label for="lsy">YouTube URL</label>
                    <InputText id="lsy" @bind-Value="Form!.SocialYouTube" />
                </div>
                <div>
                    <label for="lst">TikTok URL</label>
                    <InputText id="lst" @bind-Value="Form!.SocialTikTok" />
                </div>
                <div>
                    <label for="lsx">X URL</label>
                    <InputText id="lsx" @bind-Value="Form!.SocialX" />
                </div>
            </div>
            @if (_error is not null)
            {
                <p class="validation-message">@_error</p>
            }
            <p style="margin-top:0.75rem"><button class="btn btn--icon btn--save" type="submit" aria-label="Save landing" title="Save landing"><Glyph Name="save" /></button></p>
        </EditForm>

        <h2 class="section-h">About</h2>
        <EditForm class="form-card" FormName="about-content" Model="AboutForm" OnValidSubmit="SaveAboutAsync">
            <label for="abt">Section title (also the strip anchor)</label>
            <InputText id="abt" @bind-Value="AboutForm!.Title" />
            <label for="abx">About the gym — empty hides the section</label>
            <InputTextArea id="abx" @bind-Value="AboutForm!.Text" rows="6" />
            <p class="cap" style="margin-top:0.25rem">MARKDOWN: **BOLD** · _ITALIC_ · ++UNDERLINE++ · - LISTS</p>
            @if (_aboutError is not null)
            {
                <p class="validation-message">@_aboutError</p>
            }
            <p style="margin-top:0.75rem"><button class="btn btn--icon btn--save" type="submit" aria-label="Save about" title="Save about"><Glyph Name="save" /></button></p>
        </EditForm>
    </section>

    <section>
        <h2 class="section-h">Logo &amp; hero image</h2>
        <div class="form-card">
            @* The image tile IS the picker (#129) — hover dims it under a pencil. *@
            <div class="row-form" style="align-items:center">
                <label class="media-edit@(_settings?.LogoPath is null ? " media-edit--empty" : null)" for="logo-file"
                       title="Click to change the logo" style="@(_settings?.LogoPath is null ? "width:2.75rem;height:2.75rem" : null)">
                    @if (_settings?.LogoPath is { } logo)
                    {
                        <img src="/media/@logo" alt="Gym logo" style="width:2.75rem;height:2.75rem;border-radius:0.5rem;object-fit:cover" />
                    }
                    else
                    {
                        <BrandMark Size="2rem" />
                    }
                    <span class="media-edit-veil" aria-hidden="true"><Glyph Name="pencil" /></span>
                </label>
                <MediaCropUpload Kind="logo" Label="logo" Aspect="1" OutWidth="512" InputId="logo-file" Overlay="true"
                                 Hint="SQUARE — RENDERS AT ~44PX ON THE RAIL AND TOP BAR" />
            </div>
            <div class="row-form" style="align-items:center;margin-top:0.875rem">
                <label class="media-edit@(_settings?.HeroPath is null ? " media-edit--empty" : null)" for="hero-file"
                       title="Click to change the hero image" style="@(_settings?.HeroPath is null ? "width:6rem;height:2.75rem" : null)">
                    @if (_settings?.HeroPath is { } hero)
                    {
                        <img src="/media/@hero" alt="Public page hero" style="width:6rem;height:2.75rem;border-radius:0.5rem;object-fit:cover" />
                    }
                    else
                    {
                        <span class="cap" style="margin:0;line-height:1.2">HERO</span>
                    }
                    <span class="media-edit-veil" aria-hidden="true"><Glyph Name="pencil" /></span>
                </label>
                <MediaCropUpload Kind="hero" Label="hero" Aspect="@(8 / 3.0)" OutWidth="1600" InputId="hero-file" Overlay="true"
                                 Hint="WIDE STRIP — DARKENED BEHIND THE PUBLIC-PAGE TEXT" />
            </div>
            <p class="cap">
                PNG/JPG/WEBP · MAX 2 MB · LOGO: SQUARE, 512×512 OR LARGER (EXPORTED AT 512PX) ·
                HERO: WIDE, 1600×600 OR LARGER (DARKENED BEHIND THE PUBLIC-PAGE TEXT) ·
                SHOWN ON THE RAIL, MEMBER TOP BAR, AND /@_gymSlug
            </p>
        </div>

        <h2 class="section-h">Section order</h2>
        <div class="form-card">
            <p class="cap" style="margin:0 0 0.5rem">TOP TO BOTTOM ON YOUR PUBLIC PAGE · EMPTY SECTIONS HIDE THEMSELVES · PROGRAMS AND STORIES APPEAR ONCE THEY HAVE CONTENT.</p>
            @foreach (var key in _sectionOrder)
            {
                <div class="head-row" style="padding:0.25rem 0">
                    <span class="mono">@SectionLabel(key)</span>
                    <span class="row-form" style="margin:0">
                        <form method="post" action="/admin/actions/landing-section-move" style="margin:0">
                            <AntiforgeryToken />
                            <input type="hidden" name="key" value="@key" />
                            <input type="hidden" name="direction" value="-1" />
                            <button class="btn btn--ghost btn--xs" type="submit" aria-label="Move @SectionLabel(key) up" title="Move up">▲</button>
                        </form>
                        <form method="post" action="/admin/actions/landing-section-move" style="margin:0">
                            <AntiforgeryToken />
                            <input type="hidden" name="key" value="@key" />
                            <input type="hidden" name="direction" value="1" />
                            <button class="btn btn--ghost btn--xs" type="submit" aria-label="Move @SectionLabel(key) down" title="Move down">▼</button>
                        </form>
                    </span>
                </div>
            }
        </div>
    </section>
</div>

@code {
    [CascadingParameter] public HttpContext? HttpContext { get; set; }
    [SupplyParameterFromQuery(Name = "failed")] public int? FailedFlag { get; set; }
    private bool Failed => FailedFlag == 1;

    [SupplyParameterFromForm(FormName = "landing-content")]
    public LandingForm? Form { get; set; }

    [SupplyParameterFromForm(FormName = "about-content")]
    public AboutFormModel? AboutForm { get; set; }

    protected override void OnInitialized()
    {
        Form ??= new();
        AboutForm ??= new();
    }

    private GymSettings? _settings;
    private string? _gymSlug;
    private string? _error;
    private string? _aboutError;
    private List<string> _sectionOrder = [.. LandingSections.Default];

    public class AboutFormModel
    {
        public string Title { get; set; } = "ABOUT";
        public string? Text { get; set; }
    }

    private string SectionLabel(string key) => key switch
    {
        LandingSections.About => _settings?.AboutTitle ?? "ABOUT",
        LandingSections.Programs => _settings?.ProgramsTitle ?? "PROGRAMS",
        LandingSections.Schedule => _settings?.TaglineSchedule ?? "SCHEDULE",
        LandingSections.Instructors => _settings?.TaglineInstructors ?? "INSTRUCTORS",
        LandingSections.Stories => _settings?.StoriesTitle ?? "SUCCESS STORIES",
        LandingSections.Visit => _settings?.TaglineVisit ?? "VISIT",
        _ => key.ToUpperInvariant(),
    };

    public class LandingForm
    {
        public string TaglineSchedule { get; set; } = "SCHEDULE";
        public string TaglineInstructors { get; set; } = "INSTRUCTORS";
        public string TaglineVisit { get; set; } = "VISIT";
        public string? VisitAddress { get; set; }
        public string? VisitPhone { get; set; }
        public string? VisitEmail { get; set; }
        public string? SocialInstagram { get; set; }
        public string? SocialFacebook { get; set; }
        public string? SocialYouTube { get; set; }
        public string? SocialTikTok { get; set; }
        public string? SocialX { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _settings = await db.GymSettings.SingleOrDefaultAsync();
        _gymSlug = (await db.Gyms.SingleOrDefaultAsync(g => g.Id == db.CurrentGymId))?.Slug;

        _sectionOrder = LandingSections.Normalize(_settings?.SectionOrder);

        // Two forms share this page now — prefill by posted-form identity so one
        // form's POST can't blank the other's fields (the PersonDetail idiom).
        var postedHandler = HttpContext?.Request.Method == "POST"
            ? HttpContext.Request.Form["_handler"].ToString()
            : null;

        if (_settings is not null && postedHandler != "about-content")
        {
            AboutForm!.Title = _settings.AboutTitle;
            AboutForm.Text = _settings.AboutText;
        }

        if (_settings is not null && postedHandler != "landing-content")
        {
            Form!.TaglineSchedule = _settings.TaglineSchedule;
            Form.TaglineInstructors = _settings.TaglineInstructors;
            Form.TaglineVisit = _settings.TaglineVisit;
            Form.VisitAddress = _settings.VisitAddress;
            Form.VisitPhone = _settings.VisitPhone;
            Form.VisitEmail = _settings.VisitEmail;
            Form.SocialInstagram = _settings.SocialInstagram;
            Form.SocialFacebook = _settings.SocialFacebook;
            Form.SocialYouTube = _settings.SocialYouTube;
            Form.SocialTikTok = _settings.SocialTikTok;
            Form.SocialX = _settings.SocialX;
        }
    }

    private async Task SaveAsync()
    {
        var form = Form!;
        string Label(string? raw, string fallback)
        {
            var trimmed = raw?.Trim().ToUpperInvariant() ?? "";
            return trimmed.Length == 0 ? fallback : trimmed;
        }

        if (new[] { form.TaglineSchedule, form.TaglineInstructors, form.TaglineVisit }.Any(t => t is { Length: > 30 }))
        {
            _error = "Keep strip labels under 30 characters.";
            return;
        }

        static string? Clean(string? raw, int max)
        {
            var trimmed = raw?.Trim();
            return string.IsNullOrEmpty(trimmed) ? null : trimmed[..Math.Min(trimmed.Length, max)];
        }

        // Socials render as clickable hrefs on the PUBLIC page — only absolute
        // http(s) may persist, or a javascript: value becomes stored XSS.
        static (string? Url, bool Ok) CleanUrl(string? raw, int max)
        {
            var cleaned = Clean(raw, max);
            if (cleaned is null)
            {
                return (null, true);
            }

            return Uri.TryCreate(cleaned, UriKind.Absolute, out var uri)
                && (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps)
                ? (cleaned, true)
                : (null, false);
        }

        var (instagram, igOk) = CleanUrl(form.SocialInstagram, 200);
        var (facebook, fbOk) = CleanUrl(form.SocialFacebook, 200);
        var (youtube, ytOk) = CleanUrl(form.SocialYouTube, 200);
        var (tiktok, ttOk) = CleanUrl(form.SocialTikTok, 200);
        var (xUrl, xOk) = CleanUrl(form.SocialX, 200);
        if (!igOk || !fbOk || !ytOk || !ttOk || !xOk)
        {
            _error = "Social links must be full http(s) URLs (https://…).";
            return;
        }

        // Handlers reload in their own context (the v1.0.1 convention).
        await using var db = await DbFactory.CreateDbContextAsync();
        var settings = await db.GymSettings.SingleOrDefaultAsync();
        if (settings is null)
        {
            _error = "No gym settings row — pick a gym first.";
            return;
        }

        settings.TaglineSchedule = Label(form.TaglineSchedule, "SCHEDULE");
        settings.TaglineInstructors = Label(form.TaglineInstructors, "INSTRUCTORS");
        settings.TaglineVisit = Label(form.TaglineVisit, "VISIT");
        settings.VisitAddress = Clean(form.VisitAddress, 300);
        settings.VisitPhone = Clean(form.VisitPhone, 30);
        settings.VisitEmail = Clean(form.VisitEmail, 200);
        settings.SocialInstagram = instagram;
        settings.SocialFacebook = facebook;
        settings.SocialYouTube = youtube;
        settings.SocialTikTok = tiktok;
        settings.SocialX = xUrl;
        await db.SaveChangesAsync();
        Nav.NavigateTo("/admin/landing");
    }

    private async Task SaveAboutAsync()
    {
        var form = AboutForm!;
        var title = (form.Title ?? "").Trim().ToUpperInvariant();
        if (title.Length == 0)
        {
            title = "ABOUT";
        }

        if (title.Length > 60)
        {
            _aboutError = "Keep the section title under 60 characters.";
            return;
        }

        // Handlers reload in their own context (the v1.0.1 convention).
        await using var db = await DbFactory.CreateDbContextAsync();
        var settings = await db.GymSettings.SingleOrDefaultAsync();
        if (settings is null)
        {
            _aboutError = "No gym settings row — pick a gym first.";
            return;
        }

        settings.AboutTitle = title;
        settings.AboutText = string.IsNullOrWhiteSpace(form.Text) ? null : form.Text.Trim();
        await db.SaveChangesAsync();
        Nav.NavigateTo("/admin/landing");
    }
}
