@page "/events"
@attribute [Authorize]
@layout MemberLayout
@using System.Security.Claims
@using GymStation.Domain.Events
@inject IDbContextFactory<GymStationDbContext> DbFactory

<PageTitle>Events · GymStation</PageTitle>

<main class="member-shell" style="padding-top:6px">
    <h1 class="page-title" style="font-size:20px">EVENTS</h1>

    @foreach (var gymEvent in _events)
    {
        var mine = _myRsvps.GetValueOrDefault(gymEvent.Id);
        var going = _counts.GetValueOrDefault((gymEvent.Id, RsvpStatus.Going));
        var interested = _counts.GetValueOrDefault((gymEvent.Id, RsvpStatus.Interested));
        <div class="form-card" style="margin-top:12px">
            <span class="chip @(gymEvent.Kind == GymEventKind.Tournament ? "chip--on" : null)">@gymEvent.Kind.ToString().ToUpperInvariant()</span>
            <h3 style="font:700 16px/1.25 var(--font-body);margin:8px 0 2px"><a href="/events/@gymEvent.Id" style="text-decoration:none">@gymEvent.Title</a></h3>
            <p class="cap">
                @gymEvent.StartsOn.ToString("ddd dd MMM yyyy").ToUpperInvariant()
                @(gymEvent.TimeInfo is null ? null : $" · {gymEvent.TimeInfo.ToUpperInvariant()}")
                @(gymEvent.Location is null ? null : $" · {gymEvent.Location.ToUpperInvariant()}")
            </p>
            @if (!string.IsNullOrWhiteSpace(gymEvent.Details))
            {
                <p style="margin:6px 0;color:var(--ink-dim)">@gymEvent.Details</p>
            }
            <div class="row-form">
                <form method="post" action="/member/actions/rsvp">
                    <AntiforgeryToken />
                    <input type="hidden" name="eventId" value="@gymEvent.Id" />
                    <input type="hidden" name="status" value="going" />
                    <button class="btn btn--xs @(mine == RsvpStatus.Going ? null : "btn--ghost")" type="submit">@(mine == RsvpStatus.Going ? "✓ GOING" : "GOING")</button>
                </form>
                <form method="post" action="/member/actions/rsvp">
                    <AntiforgeryToken />
                    <input type="hidden" name="eventId" value="@gymEvent.Id" />
                    <input type="hidden" name="status" value="interested" />
                    <button class="btn btn--xs @(mine == RsvpStatus.Interested ? null : "btn--ghost")" type="submit">@(mine == RsvpStatus.Interested ? "✓ INTERESTED" : "INTERESTED")</button>
                </form>
            </div>
            <p class="cap" style="margin-top:8px">@going GOING · @interested INTERESTED</p>
        </div>
    }
    @if (_events.Count == 0)
    {
        <p class="cap" style="margin-top:12px">NO UPCOMING EVENTS. YOUR GYM WILL PUSH TOURNAMENTS, SEMINARS, AND GRADINGS HERE.</p>
    }

    <h2 class="section-h">Past</h2>
    @foreach (var gymEvent in _past)
    {
        <div class="form-card" style="margin-bottom:8px;opacity:.75">
            <div class="head-row">
                <a href="/events/@gymEvent.Id" style="text-decoration:none"><b>@gymEvent.Title</b></a>
                <span class="chip">@gymEvent.Kind.ToString().ToUpperInvariant()</span>
            </div>
            <p class="cap" style="margin:4px 0 0">@gymEvent.StartsOn.ToString("ddd dd MMM yyyy").ToUpperInvariant()</p>
        </div>
    }
    @if (_past.Count == 0)
    {
        <p class="cap">NO PAST EVENTS IN THIS WINDOW.</p>
    }
    @if (_hasOlder)
    {
        <p class="cap" style="margin-top:8px"><a href="@($"/events?before={_windowStart:yyyy-MM-dd}")">OLDER →</a></p>
    }
</main>

@code {
    [CascadingParameter] public HttpContext? HttpContext { get; set; }

    [SupplyParameterFromQuery(Name = "before")] public string? BeforeRaw { get; set; }

    private List<GymEvent> _events = [];
    private List<GymEvent> _past = [];
    private bool _hasOlder;
    private DateOnly _windowStart;
    private Dictionary<Guid, RsvpStatus?> _myRsvps = [];
    private Dictionary<(Guid, RsvpStatus), int> _counts = [];

    protected override async Task OnInitializedAsync()
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        await using var db = await DbFactory.CreateDbContextAsync();
        _events = await db.GymEvents
            .Where(e => e.StartsOn >= today.AddDays(-1))
            .OrderBy(e => e.StartsOn)
            .ToListAsync();

        // Past window: 12 months at a time, older pages via ?before=cursor.
        // Strict format + clamps: a future cursor would leak upcoming events into
        // Past, and a near-MinValue cursor would underflow the window math.
        var floor = new DateOnly(1900, 1, 1);
        var hasCursor = DateOnly.TryParseExact(BeforeRaw, "yyyy-MM-dd", out var before);
        var windowEnd = !hasCursor ? today : before > today ? today : before < floor ? floor : before;
        _windowStart = windowEnd.AddMonths(-12);
        var cutoff = hasCursor ? windowEnd : windowEnd.AddDays(-1);
        _past = await db.GymEvents
            .Where(e => e.StartsOn < cutoff && e.StartsOn >= _windowStart)
            .OrderByDescending(e => e.StartsOn)
            .ToListAsync();
        _hasOlder = await db.GymEvents.AnyAsync(e => e.StartsOn < _windowStart);

        var eventIds = _events.Select(e => e.Id).ToList();
        var rsvps = await db.EventRsvps.Where(r => eventIds.Contains(r.EventId)).ToListAsync();
        _counts = rsvps.GroupBy(r => (r.EventId, r.Status)).ToDictionary(g => g.Key, g => g.Count());

        var raw = HttpContext?.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (Guid.TryParse(raw, out var userId))
        {
            var me = await db.Persons.SingleOrDefaultAsync(p => p.UserId == userId && !p.Archived);
            if (me is not null)
            {
                _myRsvps = rsvps.Where(r => r.PersonId == me.Id)
                    .ToDictionary(r => r.EventId, r => (RsvpStatus?)r.Status);
            }
        }
    }
}
