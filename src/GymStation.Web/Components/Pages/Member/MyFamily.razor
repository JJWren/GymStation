@page "/family"
@attribute [Authorize]
@layout MemberLayout
@using System.Security.Claims
@using GymStation.Domain.People
@inject IDbContextFactory<GymStationDbContext> DbFactory
@inject GymStation.Infrastructure.People.FamilyService Families
@inject GymStation.Infrastructure.Money.LedgerService Ledger
@inject Microsoft.AspNetCore.Identity.UserManager<GymStation.Infrastructure.Identity.AppUser> Users

<PageTitle>My family · GymStation</PageTitle>

<main class="member-shell" style="padding-top:0.375rem">
    <h1 class="page-title" style="font-size:1.25rem">MY FAMILY</h1>

    @if (FailedFlag == 2)
    {
        <p class="auth-error" role="alert">No login exists for that email — have them register first.</p>
    }
    else if (FailedFlag is not null)
    {
        <p class="auth-error" role="alert">That change was refused — you may not have the permission for it.</p>
    }

    @if (_families.Count == 0)
    {
        <p class="cap" style="margin-top:0.625rem">YOU'RE NOT A GUARDIAN OF ANY FAMILY HERE. YOUR GYM'S STAFF SET FAMILIES UP.</p>
    }

    @if (_gradResult is { } grad)
    {
        <div class="form-card" style="margin-top:0.75rem;border:1.5px solid var(--ok)">
            <b>@grad.PersonName.ToUpperInvariant() IS GRADUATED.</b>
            <p class="cap" style="margin:0.375rem 0 0">
                LOGIN: @grad.Email.ToUpperInvariant()
                @if (grad.TempPassword is { } pw)
                {
                    <br /><text>ONE-TIME PASSWORD (SHOWN ONLY NOW — HAND IT OVER AND HAVE THEM CHANGE IT): </text><b class="mono">@pw</b>
                }
                <br /><text>THEIR ENTIRE DIARY IS NOW PRIVATE TO THEM; IF THE FAMILY HAS A FAMILY PLAN, IT KEEPS COVERING THEM AS AN ADULT MEMBER.</text>
            </p>
        </div>
    }

    @foreach (var view in _families)
    {
        <div class="form-card" style="margin-top:0.75rem">
            <div class="head-row">
                @if (view.MyGuardian.IsPrimary || view.MyGuardian.ManageMembers)
                {
                    @* Name edits inline via the pencil (#127); the RENAME row is gone. *@
                    <form method="post" action="/family-actions/rename" class="ie" data-inline-edit style="margin:0">
                        <AntiforgeryToken />
                        <input type="hidden" name="familyId" value="@view.Family.Id" />
                        <div class="ie-view" hidden>
                            <b>@view.Family.Name</b>
                            <button type="button" class="btn btn--ghost btn--icon btn--xs ie-edit" aria-label="Edit family name" title="Edit family name"><Glyph Name="pencil" /></button>
                        </div>
                        <div class="ie-fields">
                            <input type="text" name="name" value="@view.Family.Name" aria-label="Family name" required maxlength="80" style="min-width:9rem" />
                            <button class="btn btn--icon btn--save btn--xs" type="submit" aria-label="Save family name" title="Save family name"><Glyph Name="save" /></button>
                            <button type="button" class="btn btn--icon btn--del btn--xs ie-cancel" aria-label="Cancel editing" title="Cancel editing" hidden><Glyph Name="x" /></button>
                        </div>
                    </form>
                }
                else
                {
                    <b>@view.Family.Name</b>
                }
                @if (view.MyGuardian.IsPrimary)
                {
                    <span class="stamp stamp--ok">YOU'RE PRIMARY</span>
                }
            </div>

            @foreach (var adultWard in view.AdultAgedWards)
            {
                <p class="auth-error" role="status" style="margin-top:0.5rem">
                    @adultWard.FirstName.ToUpperInvariant() IS 18+ — CONSIDER GRADUATING THEM TO THEIR OWN ACCOUNT BELOW.
                </p>
            }

            <h2 class="section-h">Members</h2>
            @foreach (var member in view.Members)
            {
                <div class="head-row" style="padding:0.25rem 0">
                    <span class="mono">
                        @member.Person.DisplayName
                        @if (member.Membership.IsWard)
                        {
                            <text> · WARD</text>
                        }
                    </span>
                    <span class="row-form" style="margin:0">
                        @* #198: per-member dues, billing eyes only — the ward-dues
                           blind spot (a member's individual plan bills even when the
                           family card shows nothing). *@
                        @if (view.MemberBalances is { } balances && balances.TryGetValue(member.Person.Id, out var owed))
                        {
                            <span class="stamp @(owed > 0 ? "stamp--bad" : "stamp--ok")">@(owed > 0 ? $"DUE ${owed:N0}" : "PAID UP")</span>
                        }
                        @if (member.Membership.IsWard && view.MyGuardian.ActForWards)
                        {
                            <a class="btn btn--ghost btn--xs" href="/diary/child/@member.Person.Id">DIARY</a>
                            <a class="btn btn--ghost btn--xs" href="/progress/child/@member.Person.Id">PROGRESS</a>
                        }
                    </span>
                </div>
            }

            @if ((view.MyGuardian.IsPrimary || view.MyGuardian.ViewBilling) && view.Billing is { } billing)
            {
                <h2 class="section-h">Billing</h2>
                <div class="head-row" style="padding:0.25rem 0">
                    <span class="mono">@billing.PlanName · $@billing.Total.ToString("N0")/MO ON @billing.PrimaryName.ToUpperInvariant()</span>
                    @if (billing.Balance > 0)
                    {
                        <span class="stamp stamp--bad">DUE $@billing.Balance.ToString("N0")</span>
                    }
                    else
                    {
                        <span class="stamp stamp--ok">PAID UP</span>
                    }
                </div>
                @if (billing.Extra > 0)
                {
                    @* #181: size-priced plan — show the math for today's roster. *@
                    <p class="cap" style="margin:0.125rem 0 0">
                        BASE $@billing.Price.ToString("N0") + $@billing.Extra.ToString("N0") EXTRAS ·
                        @billing.Adults ADULT@(billing.Adults == 1 ? "" : "S") + @billing.Kids WARD@(billing.Kids == 1 ? "" : "S") · RE-COUNTED EACH CYCLE
                    </p>
                }
            }

            <h2 class="section-h">Guardians</h2>
            @foreach (var guardian in view.Guardians)
            {
                <div style="padding:0.25rem 0;border-bottom:1px dashed #2c3440">
                    <div class="head-row">
                        <span class="mono">@guardian.Email</span>
                        @if (guardian.Row.IsPrimary)
                        {
                            <span class="stamp stamp--ok">PRIMARY</span>
                        }
                    </div>
                    @if (!guardian.Row.IsPrimary)
                    {
                        <p class="cap" style="margin:0.25rem 0 0">
                            @(guardian.Row.ActForWards ? "ACTS FOR WARDS" : "—")
                            @(guardian.Row.ManageGuardians ? " · MANAGES GUARDIANS" : null)
                            @(guardian.Row.ManageMembers ? " · MANAGES MEMBERS" : null)
                            @(guardian.Row.ViewBilling ? " · SEES BILLING" : null)
                        </p>
                        @if (view.MyGuardian.IsPrimary || view.MyGuardian.ManageGuardians)
                        {
                            <form method="post" action="/family-actions/set-flags" class="check-row" style="margin-top:0.25rem;flex-wrap:wrap">
                                <AntiforgeryToken />
                                <input type="hidden" name="familyId" value="@view.Family.Id" />
                                <input type="hidden" name="guardianId" value="@guardian.Row.Id" />
                                <label><input type="checkbox" name="actForWards" value="true" checked="@guardian.Row.ActForWards" /> ACT FOR WARDS</label>
                                <label><input type="checkbox" name="manageGuardians" value="true" checked="@guardian.Row.ManageGuardians" /> MANAGE GUARDIANS</label>
                                <label><input type="checkbox" name="manageMembers" value="true" checked="@guardian.Row.ManageMembers" /> MANAGE MEMBERS</label>
                                <label><input type="checkbox" name="viewBilling" value="true" checked="@guardian.Row.ViewBilling" /> VIEW BILLING</label>
                                <button class="btn btn--icon btn--save btn--xs" type="submit" aria-label="Save guardian flags" title="Save guardian flags"><Glyph Name="save" /></button>
                            </form>
                            <div class="row-form" style="margin-top:0.25rem">
                                @if (view.MyGuardian.IsPrimary)
                                {
                                    <form method="post" action="/family-actions/transfer-primary" style="margin:0">
                                        <AntiforgeryToken />
                                        <input type="hidden" name="familyId" value="@view.Family.Id" />
                                        <input type="hidden" name="guardianId" value="@guardian.Row.Id" />
                                        <button class="btn btn--ghost btn--xs" type="submit" title="Hand the family over — they gain every permission">MAKE PRIMARY</button>
                                    </form>
                                }
                                <form method="post" action="/family-actions/remove-guardian" style="margin:0">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="familyId" value="@view.Family.Id" />
                                    <input type="hidden" name="guardianId" value="@guardian.Row.Id" />
                                    <button class="btn btn--ghost btn--xs" type="submit">REMOVE</button>
                                </form>
                            </div>
                        }
                    }
                </div>
            }

            @if (view.MyGuardian.IsPrimary || view.MyGuardian.ManageGuardians)
            {
                <form method="post" action="/family-actions/add-guardian" style="margin-top:0.5rem">
                    <AntiforgeryToken />
                    <input type="hidden" name="familyId" value="@view.Family.Id" />
                    <label class="cap" for="ag-@view.Family.Id" style="display:block;margin:0 0 0.25rem">ADD A GUARDIAN BY LOGIN EMAIL</label>
                    <div class="row-form">
                        <input id="ag-@view.Family.Id" type="email" name="email" required style="flex:1;min-width:9rem" />
                        <label class="cap" style="margin:0"><input type="checkbox" name="actForWards" value="true" checked /> ACTS FOR WARDS</label>
                        <button class="btn btn--icon btn--save btn--xs" type="submit" aria-label="Add guardian" title="Add guardian"><Glyph Name="save" /></button>
                    </div>
                </form>
            }
        </div>
    }
    @if (_graduatable.Count > 0)
    {
        <h2 class="section-h">Graduate a ward</h2>
        <EditForm class="form-card" FormName="graduate" Model="GradForm" OnValidSubmit="GraduateAsync">
            <p class="cap" style="margin:0 0 0.5rem">
                GRADUATION MAKES A WARD THEIR OWN ADULT ACCOUNT: THEIR WHOLE DIARY GOES PRIVATE TO THEM,
                AND THE FAMILY PLAN CAN KEEP COVERING THEM. ONLY THE PRIMARY CAN DO THIS.
            </p>
            <label for="gw">Ward</label>
            <InputSelect id="gw" @bind-Value="GradForm!.Key">
                <option value="">— pick —</option>
                @foreach (var (key, label, hasLogin) in _graduatable)
                {
                    <option value="@key">@label@(hasLogin ? " (HAS A LOGIN ALREADY)" : null)</option>
                }
            </InputSelect>
            <label for="ge">Email for their new login (skip if they already have one)</label>
            <InputText id="ge" @bind-Value="GradForm!.Email" type="email" />
            @if (_gradError is not null)
            {
                <p class="validation-message">@_gradError</p>
            }
            <p style="margin-top:0.75rem"><button class="btn" type="submit">GRADUATE</button></p>
        </EditForm>
    }
</main>

@code {
    [CascadingParameter] public HttpContext? HttpContext { get; set; }
    [SupplyParameterFromQuery(Name = "failed")] public int? FailedFlag { get; set; }

    private sealed record BillingView(
        string PlanName, decimal Price, decimal Total, decimal Extra, int Adults, int Kids,
        string PrimaryName, decimal Balance);

    private sealed record FamilyView(
        Family Family,
        FamilyGuardian MyGuardian,
        List<(FamilyMember Membership, Person Person)> Members,
        List<(FamilyGuardian Row, string Email)> Guardians,
        BillingView? Billing,
        List<Person> AdultAgedWards,
        Dictionary<Guid, decimal>? MemberBalances);

    private List<FamilyView> _families = [];
    private List<(string Key, string Label, bool HasLogin)> _graduatable = [];
    private GymStation.Infrastructure.People.GraduationResult? _gradResult;
    private string? _gradError;
    private Guid _meUserId;

    [SupplyParameterFromForm(FormName = "graduate")]
    public GraduateForm? GradForm { get; set; }

    public class GraduateForm
    {
        public string? Key { get; set; }
        public string? Email { get; set; }
    }

    protected override void OnInitialized() => GradForm ??= new();

    private async Task GraduateAsync()
    {
        var key = GradForm!.Key;
        if (string.IsNullOrWhiteSpace(key) || key.Split(':') is not [var familyRaw, var personRaw]
            || !Guid.TryParse(familyRaw, out var familyId) || !Guid.TryParse(personRaw, out var personId))
        {
            _gradError = "Pick a ward.";
            return;
        }

        try
        {
            _gradResult = await Families.GraduateAsync(
                GymStation.Infrastructure.People.FamilyActor.User(_meUserId), familyId, personId, GradForm.Email, Users);
            _gradError = null;
            await OnInitializedAsync();
        }
        catch (InvalidOperationException ex)
        {
            _gradError = ex.Message;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var raw = HttpContext?.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (!Guid.TryParse(raw, out var userId))
        {
            return;
        }

        _meUserId = userId;

        var families = await Families.FamiliesForGuardianAsync(userId);
        if (families.Count == 0)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        _families = [];
        _graduatable = [];
        var userIds = families.SelectMany(f => f.Guardians).Select(g => g.GuardianUserId).Distinct().ToList();
        var emails = await db.Users.Where(u => userIds.Contains(u.Id))
            .ToDictionaryAsync(u => u.Id, u => u.Email ?? u.UserName ?? "unknown");

        foreach (var f in families)
        {
            var mine = f.Guardians.Single(g => g.GuardianUserId == userId);

            // The billing card loads only for eyes the matrix allows (#91).
            BillingView? billing = null;
            if ((mine.IsPrimary || mine.ViewBilling) && f.MembershipPlanId is { } planId)
            {
                var plan = await db.MembershipPlans.SingleOrDefaultAsync(pl => pl.Id == planId);
                var primary = f.Guardians.SingleOrDefault(g => g.IsPrimary);
                var primaryPerson = primary is null
                    ? null
                    : await db.Persons.SingleOrDefaultAsync(p => p.UserId == primary.GuardianUserId && !p.Archived);
                if (plan is not null && primaryPerson is not null)
                {
                    var arrears = await Ledger.ArrearsForAsync(primaryPerson.Id);
                    // #181: computed for today's roster — the cycle re-counts monthly.
                    var adults = f.Members.Count(m => m.Person is { Archived: false } && !m.IsWard);
                    var kids = f.Members.Count(m => m.Person is { Archived: false } && m.IsWard);
                    var (total, extra) = GymStation.Domain.Money.FamilyPlanMath.Compute(plan, adults, kids);
                    billing = new BillingView(plan.Name, plan.Price, total, extra, adults, kids, primaryPerson.DisplayName, arrears.Balance);
                }
            }

            var members = f.Members
                .Where(m => m.Person is { Archived: false })
                .OrderByDescending(m => m.IsWard).ThenBy(m => m.Person.FirstName)
                .Select(m => (m, m.Person))
                .ToList();

            // 18+ nudge (#92) — computed from what's loaded; graduation stays manual.
            var cutoff = DateOnly.FromDateTime(DateTime.Today).AddYears(-18);
            var adultAged = members
                .Where(x => x.m.IsWard && x.Person.DateOfBirth is { } dob && dob <= cutoff)
                .Select(x => x.Person)
                .ToList();

            if (mine.IsPrimary)
            {
                _graduatable.AddRange(members
                    .Where(x => x.m.IsWard)
                    .Select(x => ($"{f.Id}:{x.Person.Id}", $"{x.Person.DisplayName} — {f.Name}", x.Person.UserId is not null)));
            }

            // #198: per-member balances load only for billing eyes — batched,
            // never N+1 (review round 1).
            Dictionary<Guid, decimal>? memberBalances = null;
            if (mine.IsPrimary || mine.ViewBilling)
            {
                memberBalances = await Ledger.BalancesForAsync(members.Select(x => x.Person.Id).ToList());
            }

            _families.Add(new FamilyView(f, mine, members,
                f.Guardians
                    .OrderByDescending(g => g.IsPrimary)
                    .Select(g => (g, emails.GetValueOrDefault(g.GuardianUserId, "unknown")))
                    .ToList(),
                billing,
                adultAged,
                memberBalances));
        }
    }
}
