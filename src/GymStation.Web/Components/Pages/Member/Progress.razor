@page "/progress"
@attribute [Authorize]
@layout MemberLayout
@using System.Globalization
@using System.Security.Claims
@using GymStation.Domain.Attendance
@using GymStation.Infrastructure.Attendance
@using GymStation.Infrastructure.Ranks
@using GymStation.Infrastructure.Training
@inject IDbContextFactory<GymStationDbContext> DbFactory
@inject RankService Ranks
@inject AttendanceService Attendance
@inject TrainingDiaryService Diary
@inject GymStation.Infrastructure.People.PersonService People
@inject GymStation.Infrastructure.People.FamilyService Families
@inject NavigationManager Nav

<PageTitle>Progress · GymStation</PageTitle>

<main class="member-shell" style="padding-top:0.375rem">
    <h1 class="page-title" style="font-size:1.25rem">PROGRESS</h1>

    @if (_current is not null)
    {
        <div class="form-card" style="margin-top:0.75rem">
            <BeltBar Size="l" BandColorHex="@_current.Rank.BandColorHex" BarColorHex="@_current.Rank.BarColorHex"
                     Stripes="@_current.Stripes" Label="@($"{_current.Rank.Name}, {_current.Stripes} stripes")" />
            <p class="cap" style="margin-top:0.5rem">
                @_labels.GetValueOrDefault(_current.Rank.RankSystemId)?.ToUpperInvariant() · @_current.Rank.Name.ToUpperInvariant() · @_current.Stripes STRIPES ·
                @RankProgress.FormatDuration(Today.ToDateTime(TimeOnly.MinValue) - _current.AtRankSince.ToDateTime(TimeOnly.MinValue)) AT BELT
                @(_ageGroup is null ? null : $" · IBJJF: {_ageGroup.ToUpperInvariant()}")
            </p>
            @if (_heldSystems.Count > 1)
            {
                <form method="post" action="/member/actions/primary-discipline" class="row-form" style="margin-top:0.5rem">
                    <AntiforgeryToken />
                    <select name="systemId" aria-label="Primary discipline" title="Primary discipline — which belt leads your views">
                        <option value="">AUTOMATIC — LATEST PROMOTION</option>
                        @foreach (var systemId in _heldSystems)
                        {
                            <option value="@systemId" selected="@(_primarySystemId == systemId)">@_labels.GetValueOrDefault(systemId)?.ToUpperInvariant()</option>
                        }
                    </select>
                    <button class="btn btn--icon btn--save btn--xs" type="submit" aria-label="Save primary discipline" title="Save primary discipline"><Glyph Name="save" /></button>
                </form>
                <p class="cap" style="margin-top:0.25rem">PRIMARY DISCIPLINE — WHICH BELT LEADS YOUR CARD AND THE ROSTER.</p>
            }
        </div>
    }

    <h2 class="section-h">Mat hours — two tiers</h2>
    <div class="filters">
        <span class="chip chip--on">@_hours.VerifiedHours GYM-VERIFIED</span>
        <span class="chip" style="border-color:var(--ok);color:var(--ok)">@_hours.SelfReportedHours SELF-REPORTED</span>
        <span class="chip">@_hours.TotalHours TOTAL</span>
    </div>
    <p class="cap">VERIFIED = CONFIRMED CHECK-INS · SELF-REPORTED = YOUR DIARY · OWNER STATS USE VERIFIED ONLY</p>

    <h2 class="section-h">Sessions / week — last 12</h2>
    <div class="form-card">
        <div style="display:flex;gap:0.1875rem;height:4.5rem" aria-label="Confirmed sessions per Sunday-start calendar week, last 12 weeks, oldest to newest">
            @foreach (var week in _weekly)
            {
                <div style="flex:1;display:flex;flex-direction:column;justify-content:flex-end;gap:1px;height:100%">
                    <span style="font:600 0.4688rem/1 var(--font-mono);color:var(--ink-faint);text-align:center">@week.Count</span>
                    <i style="display:block;background:var(--tenant);opacity:.75;border-radius:2px 2px 0 0;height:@(_weeklyPeak == 0 ? 0 : Math.Max(week.Count > 0 ? 3 : 0, week.Count * 72 / _weeklyPeak))%"></i>
                    <b style="font:600 0.4375rem/1.5 var(--font-mono);color:var(--ink-faint);text-align:center">@week.WeekStart.ToString("M/d")</b>
                </div>
            }
        </div>
        <p class="cap" style="margin-top:0.375rem">YOUR CONFIRMED CHECK-INS PER SUNDAY-START WEEK · OLDEST LEFT → THIS WEEK RIGHT · AVG @_avg /WK</p>
    </div>

    <h2 class="section-h">Check-ins</h2>
    <div class="filters">
        @foreach (var (key, label) in RangeChips)
        {
            <a class="chip @(_range == key ? "chip--on" : null)" href="/progress?range=@key">@label</a>
        }
        @if (_range == "custom")
        {
            <span class="chip chip--on">CUSTOM</span>
        }
    </div>
    <div class="form-card" style="margin-top:0.625rem">
        <form method="get" action="/progress" class="row-form" style="margin:0 0 0.625rem">
            <input type="date" name="from" value="@_from.ToString("yyyy-MM-dd")" aria-label="From date" />
            <input type="date" name="to" value="@_to.ToString("yyyy-MM-dd")" aria-label="To date" />
            <button class="btn btn--ghost btn--xs" type="submit">APPLY RANGE</button>
        </form>
        <p class="cap" style="margin:0">
            @_ciTotal CHECK-IN@(_ciTotal == 1 ? null : "S") · @_ciConfirmed CONFIRMED · @_ciPending PENDING ·
            @_from.ToString("dd MMM yyyy").ToUpperInvariant() → @_to.ToString("dd MMM yyyy").ToUpperInvariant()
        </p>
        @foreach (var record in _checkIns)
        {
            <div class="head-row" style="border-top:1px dashed #2c3440;padding:0.4375rem 0">
                <span class="mono" style="color:var(--ink)">
                    @record.Session.Date.ToString("ddd dd MMM yy").ToUpperInvariant() ·
                    @record.Session.StartTime.ToString("HH:mm") · @record.Session.Name.ToUpperInvariant() ·
                    @(record.Session.DurationMinutes)MIN
                </span>
                <span class="stamp @(record.Status == AttendanceStatus.Confirmed ? "stamp--ok" : "stamp--warn")">
                    @(record.Status == AttendanceStatus.Confirmed ? "CONFIRMED" : "PENDING")
                </span>
            </div>
        }
        @if (_checkIns.Count == 0)
        {
            <p class="cap" style="margin-top:0.5rem">NO CHECK-INS IN THIS RANGE.</p>
        }
        @if (_ciPage > 1 || _ciPage * CheckInPageSize < _ciTotal)
        {
            <div class="head-row" style="margin-top:0.625rem">
                @if (_ciPage > 1)
                {
                    <a class="chip" href="@PageUrl(_ciPage - 1)">‹ NEWER</a>
                }
                else
                {
                    <span></span>
                }
                <span class="cap" style="margin:0">PAGE @_ciPage OF @(((_ciTotal - 1) / CheckInPageSize) + 1)</span>
                @if (_ciPage * CheckInPageSize < _ciTotal)
                {
                    <a class="chip" href="@PageUrl(_ciPage + 1)">OLDER ›</a>
                }
                else
                {
                    <span></span>
                }
            </div>
        }
    </div>

    @if (_mePersonId is not null)
    {
        <h2 class="section-h">My contact</h2>
        <EditForm class="form-card" FormName="my-contact" Model="ContactForm" OnValidSubmit="SaveContactAsync">
            <label for="cphone">Phone number (leave empty to remove)</label>
            <InputText id="cphone" @bind-Value="ContactForm!.PhoneNumber" maxlength="30" />
            <div class="check-row" style="margin-top:0.625rem">
                <label><InputCheckbox @bind-Value="ContactForm!.SmsAllowed" /> TEXTING THIS NUMBER IS OK</label>
            </div>
            @if (_contactError is not null)
            {
                <p class="validation-message">@_contactError</p>
            }
            <p style="margin-top:0.75rem"><button class="btn btn--icon btn--save btn--xs" type="submit" aria-label="Save contact" title="Save contact"><Glyph Name="save" /></button></p>
        </EditForm>
    }

    <h2 class="section-h">Promotion history</h2>
    <div class="form-card tl">
        @foreach (var award in _awards)
        {
            <div class="ev">
                <span class="d">@award.AwardedOn.ToString("dd MMM yy").ToUpperInvariant()</span>
                <div>
                    <BeltBar Size="s" BandColorHex="@award.Rank.BandColorHex" BarColorHex="@award.Rank.BarColorHex"
                             Stripes="@award.Stripes" Label="@($"{award.Rank.Name}, {award.Stripes} stripes")" />
                    <div class="who">@_labels.GetValueOrDefault(award.Rank.RankSystemId)?.ToUpperInvariant() · @(award.Stripes > 0 ? "STRIPE" : "PROMOTION")@(award.SelfReported ? " · SELF-REPORTED" : null)</div>
                </div>
                <span></span>
            </div>
        }
        @if (_awards.Count == 0)
        {
            <p class="cap">NO RANK HISTORY YET.</p>
        }
    </div>

    @if (_children.Count > 0)
    {
        <div class="head-row" style="margin:1.25rem 0 0.625rem">
            <h2 class="section-h" style="margin:0">My people</h2>
            <a class="btn btn--ghost btn--xs" href="/family">MANAGE FAMILY ▸</a>
        </div>
        @foreach (var child in _children)
        {
            var rank = _childRanks.GetValueOrDefault(child.Id);
            <a class="form-card" href="/progress/child/@child.Id" style="display:block;margin-bottom:0.5rem;text-decoration:none">
                <div class="head-row">
                    <b>@child.DisplayName</b>
                    @if (rank is not null)
                    {
                        <BeltBar Size="s" BandColorHex="@rank.Rank.BandColorHex" BarColorHex="@rank.Rank.BarColorHex"
                                 Stripes="@rank.Stripes" Label="@($"{rank.Rank.Name}, {rank.Stripes} stripes")" />
                    }
                </div>
                <p class="cap" style="margin:0.25rem 0 0">ATTENDANCE · RANK · PROMOTIONS →</p>
            </a>
        }
    }
</main>

@code {
    [CascadingParameter] public HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm(FormName = "my-contact")]
    public ContactFormModel? ContactForm { get; set; }

    public class ContactFormModel
    {
        public string? PhoneNumber { get; set; }
        public bool SmsAllowed { get; set; }
    }

    private Guid? _mePersonId;
    private Guid? _primarySystemId;
    private List<Guid> _heldSystems = [];
    private string? _contactError;

    [SupplyParameterFromQuery(Name = "range")] public string? RangeRaw { get; set; }
    [SupplyParameterFromQuery(Name = "from")] public string? FromRaw { get; set; }
    [SupplyParameterFromQuery(Name = "to")] public string? ToRaw { get; set; }
    [SupplyParameterFromQuery(Name = "cpage")] public int? CheckInPageRaw { get; set; }

    private static readonly (string Key, string Label)[] RangeChips =
    [
        ("7d", "7D"), ("2w", "2W"), ("30d", "30D"), ("ytd", "YTD"), ("12mo", "12MO"),
    ];

    private const int CheckInPageSize = 100;
    private string _range = "7d";
    private DateOnly _from;
    private DateOnly _to;
    private int _ciPage = 1;
    private int _ciTotal;
    private int _ciConfirmed;
    private int _ciPending;
    private List<AttendanceRecord> _checkIns = [];

    private CurrentRank? _current;
    private List<RankAward> _awards = [];
    private TwoTierHours _hours = new(0, 0);
    private double _avg;
    private List<GymStation.Domain.Attendance.WeekCount> _weekly = [];
    private int _weeklyPeak;
    private string? _ageGroup;
    private List<Person> _children = [];
    private Dictionary<Guid, CurrentRank> _childRanks = [];
    private Dictionary<Guid, string> _labels = [];
    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Today);

    protected override void OnInitialized() => ContactForm ??= new();

    protected override async Task OnInitializedAsync()
    {
        var raw = HttpContext?.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (!Guid.TryParse(raw, out var userId))
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        // Wards render for acting guardians even when the guardian has no roster
        // record of their own (Sarah's account is exactly this shape) — the matrix
        // stays in FamilyService (#89).
        _children = await Families.WardsForAsync(userId);
        if (_children.Count > 0)
        {
            _childRanks = await Ranks.GetPrimaryRanksAsync(_children.Select(c => c.Id).ToList());
        }

        var me = await db.Persons.SingleOrDefaultAsync(p => p.UserId == userId && !p.Archived);
        if (me is null)
        {
            return;
        }

        _mePersonId = me.Id;
        _primarySystemId = me.PrimaryRankSystemId;

        // Prefill unless THIS form posted (a failed submit keeps the binder's values).
        var postedHandler = HttpContext?.Request.Method == "POST"
            ? HttpContext.Request.Form["_handler"].ToString()
            : null;
        if (postedHandler != "my-contact")
        {
            ContactForm!.PhoneNumber = me.PhoneNumber;
            ContactForm.SmsAllowed = me.SmsAllowed;
        }

        _ageGroup = GymStation.Domain.People.IbjjfAgeGroup.FromBirthDate(me.DateOfBirth, Today);
        _current = (await Ranks.GetPrimaryRanksAsync([me.Id])).GetValueOrDefault(me.Id);
        _awards = await Ranks.GetAwardsForPersonAsync(me.Id);
        _labels = await Ranks.GetDisciplineLabelsAsync();
        _heldSystems = _awards.Select(a => a.Rank.RankSystemId).Distinct().ToList();
        _hours = await Diary.HoursAsync(userId);
        (_avg, _, _weekly) = await Attendance.StatsAsync(me.Id, Today);
        _weeklyPeak = _weekly.Count == 0 ? 0 : _weekly.Max(w => w.Count);

        ResolveCheckInRange();

        var scope = db.AttendanceRecords.Where(a =>
            a.PersonId == me.Id && a.Status != AttendanceStatus.Removed
            && a.Session.Date >= _from && a.Session.Date <= _to);

        // One grouped scan covers all three totals (Removed is already excluded).
        var statusCounts = await scope
            .GroupBy(a => a.Status)
            .Select(g => new { g.Key, Count = g.Count() })
            .ToListAsync();
        _ciConfirmed = statusCounts.Where(x => x.Key == AttendanceStatus.Confirmed).Sum(x => x.Count);
        _ciPending = statusCounts.Where(x => x.Key == AttendanceStatus.Pending).Sum(x => x.Count);
        _ciTotal = _ciConfirmed + _ciPending;

        // A too-high page clamps to the LAST page (matches the roster pager spec),
        // so the label can never claim an impossible "PAGE 2 OF 1".
        var lastPage = Math.Max(1, (_ciTotal + CheckInPageSize - 1) / CheckInPageSize);
        _ciPage = Math.Clamp(CheckInPageRaw ?? 1, 1, lastPage);

        _checkIns = await scope
            .Include(a => a.Session)
            .OrderByDescending(a => a.Session.Date).ThenByDescending(a => a.Session.StartTime)
            .Skip((_ciPage - 1) * CheckInPageSize)
            .Take(CheckInPageSize)
            .AsNoTracking()
            .ToListAsync();
    }

    private void ResolveCheckInRange()
    {
        var hasFrom = DateOnly.TryParseExact(FromRaw, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var from);
        var hasTo = DateOnly.TryParseExact(ToRaw, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var to);

        if (hasFrom && hasTo)
        {
            if (to < from)
            {
                (from, to) = (to, from);
            }

            var min = new DateOnly(2000, 1, 1);
            _from = from < min ? min : from > Today ? Today : from;
            _to = to < min ? min : to > Today ? Today : to;
            _range = "custom";
            return;
        }

        _range = RangeRaw switch { "2w" or "30d" or "ytd" or "12mo" => RangeRaw, _ => "7d" };
        _to = Today;
        _from = _range switch
        {
            "2w" => Today.AddDays(-13),
            "30d" => Today.AddDays(-29),
            "ytd" => new DateOnly(Today.Year, 1, 1),
            "12mo" => Today.AddMonths(-12).AddDays(1),
            _ => Today.AddDays(-6),
        };
    }

    private string PageUrl(int page)
    {
        return _range == "custom"
            ? $"/progress?from={_from:yyyy-MM-dd}&to={_to:yyyy-MM-dd}&cpage={page}"
            : $"/progress?range={_range}&cpage={page}";
    }

    private async Task SaveContactAsync()
    {
        if (_mePersonId is not { } personId)
        {
            return;
        }

        try
        {
            await People.SetContactAsync(personId, ContactForm!.PhoneNumber, ContactForm.SmsAllowed);
            Nav.NavigateTo("/progress");
        }
        catch (InvalidOperationException ex)
        {
            _contactError = ex.Message;
        }
    }
}
