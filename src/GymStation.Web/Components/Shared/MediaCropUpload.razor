@using System.Globalization

@* Progressive crop-and-upload: without JS this is the plain file form; with JS
   (wwwroot/js/media-crop.js) picking a file opens a drag/zoom crop preview and
   APPLY posts the cropped image to the same endpoint. *@
<form method="post" action="@Action" enctype="multipart/form-data"
      class="media-crop" data-media-crop data-kind="@Kind"
      data-aspect="@Aspect.ToString(CultureInfo.InvariantCulture)" data-out-width="@OutWidth">
    <AntiforgeryToken />
    <input type="hidden" name="kind" value="@Kind" />
    <div class="row-form" style="margin:0">
        <input type="file" name="file" accept=".png,.jpg,.jpeg,.webp" aria-label="@Label file" />
        <button class="btn btn--ghost btn--xs plain-submit" type="submit">UPLOAD @Label.ToUpperInvariant()</button>
    </div>
    <div class="crop-ui" hidden>
        <canvas class="crop-canvas" aria-label="Crop preview — drag to position"></canvas>
        <div class="row-form" style="margin-top:6px">
            <input type="range" class="crop-zoom" min="0" max="2" step="0.01" value="0" aria-label="Zoom" style="flex:1" />
            <button type="button" class="btn btn--xs crop-apply">APPLY</button>
            <button type="button" class="btn btn--ghost btn--xs crop-cancel">CANCEL</button>
        </div>
        <p class="cap" style="margin-top:4px">DRAG TO POSITION · SLIDE TO ZOOM · @Hint</p>
    </div>
</form>

@code {
    /// <summary>Endpoint the form posts to; override for non-settings uploads.</summary>
    [Parameter] public string Action { get; set; } = "/admin/actions/upload-media";

    /// <summary>Upload kind understood by the media endpoint ("logo", "hero").</summary>
    [Parameter, EditorRequired] public string Kind { get; set; } = "";

    /// <summary>Human label for buttons/aria ("logo", "hero").</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = "";

    /// <summary>Target width ÷ height (1 = square, 8/3.0 = hero strip).</summary>
    [Parameter] public double Aspect { get; set; } = 1;

    /// <summary>Exported image width in pixels; height follows the aspect.</summary>
    [Parameter] public int OutWidth { get; set; } = 1024;

    /// <summary>Dimension guidance shown under the crop UI.</summary>
    [Parameter] public string Hint { get; set; } = "";
}
