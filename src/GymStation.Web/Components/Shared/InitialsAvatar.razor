@* Deterministic initials tile for people without a portrait (#216). Inline SVG
   fills whatever .avatar frame wraps it — no stored files, no upload surface,
   and the same name always renders the same tile (nightly resets included).
   The hash is a fixed polynomial, NEVER string.GetHashCode (randomized per
   process, which would reshuffle colors every restart). Decorative by design:
   every call site's wrapper (or adjacent text) already carries the person's
   name, so the SVG hides from the accessibility tree instead of announcing
   a duplicate. *@

<svg viewBox="0 0 64 64" aria-hidden="true" focusable="false"
     style="display:block;width:100%;height:100%">
    <rect width="64" height="64" fill="@Tile.Background" />
    <text x="32" y="33" text-anchor="middle" dominant-baseline="central"
          font-family="var(--font-mono, monospace)" font-size="24" font-weight="600"
          fill="@Tile.Ink" letter-spacing="1">@Initials</text>
</svg>

@code {
    // The house discipline hues (class-tag palette) — belts stay sacred, so the
    // avatar range deliberately avoids reading as any belt color band. Each
    // background pairs with an ink chosen for WCAG large-text contrast (the
    // gold is too light for paper ink; everything else is not).
    private static readonly (string Background, string Ink)[] Palette =
    [
        ("#C9503B", "#F4F1E8"), ("#3E8E9E", "#F4F1E8"), ("#C9A227", "#17181A"), ("#707886", "#F4F1E8"),
        ("#3E8E5A", "#F4F1E8"), ("#4A6FA5", "#F4F1E8"), ("#2456A6", "#F4F1E8"), ("#B0622F", "#F4F1E8"),
    ];

    [Parameter, EditorRequired] public required string Name { get; set; }

    private string Initials
    {
        get
        {
            var parts = Name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            return parts.Length switch
            {
                0 => "?",
                1 => char.ToUpperInvariant(parts[0][0]).ToString(),
                _ => $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[^1][0])}",
            };
        }
    }

    private (string Background, string Ink) Tile
    {
        get
        {
            var hash = 0;
            foreach (var ch in Name)
            {
                hash = unchecked(hash * 31 + ch);
            }

            return Palette[(int)((uint)hash % (uint)Palette.Length)];
        }
    }
}
