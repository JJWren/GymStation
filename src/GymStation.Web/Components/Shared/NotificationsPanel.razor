@using System.Security.Claims
@using GymStation.Domain.Notifications
@inject IDbContextFactory<GymStationDbContext> DbFactory
@inject NavigationManager Nav

<div class="head-row">
    <h1 class="page-title" style="font-size:1.25rem">NOTIFICATIONS</h1>
    @if (_items.Any(n => n.ReadUtc == null))
    {
        <EditForm FormName="mark-read" Model="Marker" OnValidSubmit="MarkAllReadAsync">
            <button class="btn btn--ghost btn--xs" type="submit">MARK ALL READ</button>
        </EditForm>
    }
</div>

@if (_items.Count == 0)
{
    <p class="cap">NOTHING YET. CANCELLATIONS, SUBSTITUTIONS, AND PROMOTIONS LAND HERE (AND IN EMAIL).</p>
}
@foreach (var item in _items)
{
    <div class="form-card" style="margin-bottom:0.5rem;@(item.ReadUtc == null ? "border-left:0.1875rem solid var(--tenant)" : "opacity:.72")">
        <b>@item.Title</b>
        <p style="margin:0.25rem 0">@item.Body</p>
        <p class="cap">
            @item.CreatedUtc.ToLocalTime().ToString("ddd dd MMM HH:mm").ToUpperInvariant()
            @if (item.LinkPath is not null)
            {
                <text> · </text><a href="@item.LinkPath">OPEN</a>
            }
        </p>
    </div>
}

@code {
    [CascadingParameter] public HttpContext? HttpContext { get; set; }

    /// <summary>Where mark-all-read returns to — the member and admin inboxes share this panel.</summary>
    [Parameter] public string ReturnPath { get; set; } = "/notifications";

    [SupplyParameterFromForm(FormName = "mark-read")]
    public MarkerModel? Marker { get; set; }

    protected override void OnInitialized() => Marker ??= new();

    public class MarkerModel;

    private List<Notification> _items = [];

    protected override async Task OnInitializedAsync()
    {
        var raw = HttpContext?.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (!Guid.TryParse(raw, out var userId))
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        _items = await db.Notifications
            .Where(n => n.RecipientUserId == userId)
            .OrderByDescending(n => n.CreatedUtc)
            .Take(50)
            .ToListAsync();
    }

    private async Task MarkAllReadAsync()
    {
        var raw = HttpContext?.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (Guid.TryParse(raw, out var userId))
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var unread = await db.Notifications.Where(n => n.RecipientUserId == userId && n.ReadUtc == null).ToListAsync();
            foreach (var notification in unread)
            {
                notification.ReadUtc = DateTimeOffset.UtcNow;
            }
            await db.SaveChangesAsync();
        }

        Nav.NavigateTo(ReturnPath);
    }
}
