@inherits LayoutComponentBase
@using GymStation.Infrastructure
@using GymStation.Infrastructure.Tenancy
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@inject IDbContextFactory<GymStationDbContext> DbFactory
@inject ITenantContext Tenant
@inject NavigationManager Nav

<div class="app-frame @(_dark ? null : "theme-light")" style="--tenant:@_accent" data-idle-minutes="@(_idleMinutes?.ToString(System.Globalization.CultureInfo.InvariantCulture))">
    <nav class="rail" aria-label="Admin sections">
        <div class="brand">
            <a class="brand-link" href="@(_gymSlug is null ? "/" : $"/{_gymSlug}")" title="Open your public gym page">
                @if (_logoPath is { } logo)
                {
                    <img class="crest" src="/media/@logo" alt="" style="object-fit:cover" />
                }
                else
                {
                    <div class="crest" style="background:transparent"><BrandMark Size="1.625rem" /></div>
                }
                <div><b>@(_gymName ?? "GYMSTATION")</b><i>GYMSTATION</i></div>
            </a>
        </div>
        @* Narrow screens collapse the rail to a top bar; this summary is the
           hamburger. Pure <details> — no JS, works under static SSR. *@
        <details class="rail-menu">
            <summary aria-label="Open navigation">☰</summary>
        </details>
        @* Grouped rail (#218), links per capability (#217) — hiding is UX; the
           page/endpoint policies remain the security boundary. *@
        <div class="rail-tabs">
            <NavLink class="tab" href="/" Match="NavLinkMatch.All">TODAY</NavLink>
            @if (Can(GymCapability.ManageRoster) || Can(GymCapability.ManageRanks))
            {
                <span class="rail-group">PEOPLE</span>
                @if (Can(GymCapability.ManageRoster))
                {
                    <NavLink class="tab" href="/admin/roster">ROSTER</NavLink>
                    <NavLink class="tab" href="/admin/families">FAMILIES</NavLink>
                }
                @if (Can(GymCapability.ManageRanks))
                {
                    <NavLink class="tab" href="/admin/ranks">RANKS</NavLink>
                }
            }
            @if (Can(GymCapability.ManageSchedule) || Can(GymCapability.ManageEvents))
            {
                <span class="rail-group">OPERATIONS</span>
                @if (Can(GymCapability.ManageSchedule))
                {
                    <NavLink class="tab" href="/admin/schedule">SCHEDULE</NavLink>
                }
                @if (Can(GymCapability.ManageEvents))
                {
                    <NavLink class="tab" href="/admin/events">EVENTS</NavLink>
                }
                @if (Can(GymCapability.ManageSchedule))
                {
                    <NavLink class="tab" href="/instructor/swaps">SWAPS</NavLink>
                }
            }
            <span class="rail-group">MESSAGES</span>
            <NavLink class="tab" href="/admin/inbox">INBOX@(_unreadNotifications > 0 ? $" ({_unreadNotifications})" : null)</NavLink>
            @if (Can(GymCapability.ManageMessaging))
            {
                <NavLink class="tab tab--msg" href="/admin/messages"><Glyph Name="envelope" /> MESSAGES@(_unreadMessages > 0 ? $" ({_unreadMessages})" : null)</NavLink>
            }
            @if (Can(GymCapability.ViewFinances) || Can(GymCapability.ViewReports))
            {
                <span class="rail-group">BUSINESS</span>
                @if (Can(GymCapability.ViewFinances))
                {
                    <NavLink class="tab" href="/admin/finance">FINANCE</NavLink>
                }
                @if (Can(GymCapability.ViewReports))
                {
                    <NavLink class="tab" href="/admin/reports">REPORTS</NavLink>
                }
            }
            @if (Can(GymCapability.EditLanding) || Can(GymCapability.ManageSettings))
            {
                <span class="rail-group">SITE</span>
                @if (Can(GymCapability.EditLanding))
                {
                    <NavLink class="tab" href="/admin/landing">LANDING</NavLink>
                }
                @if (Can(GymCapability.ManageSettings))
                {
                    <NavLink class="tab" href="/admin/settings">SETTINGS</NavLink>
                }
            }
            <a class="tab tab--cross" href="/schedule" title="Your own member portal">MEMBER VIEW ▸</a>
            @if (_isInstructor)
            {
                <a class="tab tab--cross" href="/teach" title="Your sessions and covers">TEACH VIEW ▸</a>
            }
            <a class="tab tab--cross" href="@(_gymSlug is null ? "/" : $"/{_gymSlug}")" title="Your public landing page">VIEW LANDING ▸</a>
            <a class="tab tab--cross" href="/choose-view" title="Pick your default sign-in view">SWITCH VIEW ▸</a>
            <div class="foot">
                GYMSTATION · V1
                <form method="post" action="/auth/theme">
                    <AntiforgeryToken />
                    <input type="hidden" name="dark" value="@((!_dark).ToString())" />
                    <input type="hidden" name="back" value="@(new Uri(Nav.Uri).PathAndQuery)" />
                    <button type="submit">@(_dark ? "PAPER MODE" : "MAT MODE")</button>
                </form>
                <form method="post" action="/auth/logout">
                    <AntiforgeryToken />
                    <button type="submit">SIGN OUT</button>
                </form>
                @if (_email is not null)
                {
                    <span class="signed-in-as">SIGNED IN AS @_email</span>
                }
                <PlatformFooter />
            </div>
        </div>
    </nav>
    <main class="main">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [CascadingParameter] public HttpContext? HttpContext { get; set; }

    private string? _gymName;
    private string? _gymSlug;
    private string _accent = "#C9503B";
    private bool _dark = true;
    private string? _logoPath;
    private string? _email;
    private int _unreadMessages;
    private int _unreadNotifications;
    private int? _idleMinutes;
    private bool _isInstructor;
    private HashSet<GymStation.Domain.People.GymCapability> _caps = [];

    private bool Can(GymStation.Domain.People.GymCapability capability) => _caps.Contains(capability);

    protected override async Task OnInitializedAsync()
    {
        // UserName is the email throughout this app; the claim wins when present.
        // Whitespace normalizes to null so no blank "SIGNED IN AS" line renders.
        var accountName = HttpContext?.User.FindFirstValue(ClaimTypes.Email) ?? HttpContext?.User.Identity?.Name;
        _email = string.IsNullOrWhiteSpace(accountName) ? null : accountName;

        if (Tenant.CurrentGymId is { } gymId)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
        _unreadMessages = await db.ContactMessages.CountAsync(m => m.ReadUtc == null);
            var gym = await db.Gyms.SingleOrDefaultAsync(g => g.Id == gymId);
            _gymName = gym?.Name.ToUpperInvariant();
            _gymSlug = gym?.Slug;

            var settings = await db.GymSettings.SingleOrDefaultAsync();
            if (settings is not null)
            {
                if (GymStation.Domain.Tenancy.ThemeMath.TryParseHexColor(settings.AccentColorHex, out _))
                {
                    _accent = settings.AccentColorHex;
                }

                _dark = settings.DefaultThemeDark;
                _logoPath = settings.LogoPath;
            }

            // A saved per-user choice beats the gym default; null follows the gym.
            var raw = HttpContext?.User.FindFirstValue(ClaimTypes.NameIdentifier);
            if (Guid.TryParse(raw, out var userId))
            {
                // #182: unread count on the INBOX tab — the MESSAGES badge idiom.
                _unreadNotifications = await db.Notifications.CountAsync(n => n.RecipientUserId == userId && n.ReadUtc == null);

                var account = await db.Users.Where(u => u.Id == userId)
                    .Select(u => new { u.PreferredThemeDark, u.IdleSignOutMinutes })
                    .FirstOrDefaultAsync();
                if (account?.PreferredThemeDark is { } dark)
                {
                    _dark = dark;
                }

                _idleMinutes = account?.IdleSignOutMinutes;

                // Capability set drives which links render (#218). Layouts query
                // their own factory context — never scoped services (v1.0.1).
                var me = await db.Persons.SingleOrDefaultAsync(p => p.UserId == userId && !p.Archived);
                if (me is not null)
                {
                    _isInstructor = me.HasRole(GymStation.Domain.People.PersonRoles.Instructor);
                    _caps = me.HasRole(GymStation.Domain.People.PersonRoles.Owner)
                        ? [.. Enum.GetValues<GymStation.Domain.People.GymCapability>()]
                        : [.. await db.PermissionGrants.Where(g => g.PersonId == me.Id).Select(g => g.Capability).ToListAsync()];
                }
            }
        }
    }
}
