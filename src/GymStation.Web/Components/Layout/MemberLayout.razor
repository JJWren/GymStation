@inherits LayoutComponentBase
@using System.Security.Claims
@using GymStation.Infrastructure
@using GymStation.Infrastructure.Tenancy
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<GymStationDbContext> DbFactory
@inject ITenantContext Tenant
@inject NavigationManager Nav

<div class="member-frame @(_dark ? null : "theme-light")" style="--tenant:@_accent" data-idle-minutes="@(_idleMinutes?.ToString(System.Globalization.CultureInfo.InvariantCulture))">
    <header class="member-top">
        <a class="brand-link" href="@(_gymSlug is null ? "/" : $"/{_gymSlug}")" title="Open your gym's public page">
            <div><b>@(_gymName ?? "GYMSTATION")</b><i>MEMBER</i></div>
        </a>
        <div class="member-top-side">
            <div class="member-top-actions">
                <form method="post" action="/auth/theme" class="signout">
                    <AntiforgeryToken />
                    <input type="hidden" name="dark" value="@((!_dark).ToString())" />
                    <input type="hidden" name="back" value="@(new Uri(Nav.Uri).PathAndQuery)" />
                    <button type="submit" title="Switch theme">@(_dark ? "PAPER" : "MAT")</button>
                </form>
                <a class="bell" href="/notifications" aria-label="Notifications@(_unreadNotifications > 0 ? $" — {_unreadNotifications} unread" : "")">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" />
                        <path d="M13.7 21a2 2 0 0 1-3.4 0" />
                    </svg>
                    @if (_unreadNotifications > 0)
                    {
                        @* #182: unread count chip — the INBOX/MESSAGES badge, bell-shaped. *@
                        <span class="bell-count" aria-hidden="true">@(_unreadNotifications > 99 ? "99+" : _unreadNotifications.ToString())</span>
                    }
                </a>
                <form method="post" action="/auth/logout" class="signout">
                    <AntiforgeryToken />
                    <button type="submit">SIGN OUT</button>
                </form>
            </div>
            @if (_email is not null)
            {
                <span class="signed-in-as">
                    SIGNED IN AS @_email
                    · <a href="@(_gymSlug is null ? "/" : $"/{_gymSlug}")" title="Your gym's public landing page">LANDING</a>
                    @if (_isStaff)
                    {
                        <text> · </text><a href="/" title="Back to the admin portal">ADMIN</a>
                    }
                </span>
            }
        </div>
    </header>
    <div class="member-body">
        @Body
        <PlatformFooter />
    </div>
    <nav class="member-tabs" aria-label="Member navigation">
        <NavLink href="/schedule"><b>▦</b><span>SCHEDULE</span></NavLink>
        <NavLink href="/diary"><b>▤</b><span>DIARY</span></NavLink>
        <NavLink href="/progress"><b>▲</b><span>PROGRESS</span></NavLink>
        <NavLink href="/events"><b>★</b><span>EVENTS</span></NavLink>
        @if (_isInstructor)
        {
            <NavLink href="/teach"><b>◆</b><span>TEACH</span></NavLink>
        }
    </nav>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [CascadingParameter] public HttpContext? HttpContext { get; set; }

    private string? _gymName;
    private string? _gymSlug;
    private string _accent = "#C9503B";
    private bool _dark = true;
    private bool _isInstructor;
    private bool _isStaff;
    private bool? _userThemePreference;
    private string? _email;
    private int? _idleMinutes;
    private int _unreadNotifications;

    protected override async Task OnInitializedAsync()
    {
        // UserName is the email throughout this app; the claim wins when present.
        // Whitespace normalizes to null so no blank "SIGNED IN AS" line renders.
        var accountName = HttpContext?.User.FindFirstValue(ClaimTypes.Email) ?? HttpContext?.User.Identity?.Name;
        _email = string.IsNullOrWhiteSpace(accountName) ? null : accountName;

        if (Tenant.CurrentGymId is { } gymId)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var gym = await db.Gyms.SingleOrDefaultAsync(g => g.Id == gymId);
            _gymName = gym?.Name.ToUpperInvariant();
            _gymSlug = gym?.Slug;

            var raw = HttpContext?.User.FindFirstValue(ClaimTypes.NameIdentifier);
            if (Guid.TryParse(raw, out var userId))
            {
                // #182: unread count chip on the bell — the MESSAGES badge idiom.
                _unreadNotifications = await db.Notifications.CountAsync(n => n.RecipientUserId == userId && n.ReadUtc == null);

                var roles = await db.Persons.Where(p => p.UserId == userId && !p.Archived)
                    .Select(p => p.Roles)
                    .SingleOrDefaultAsync();
                _isInstructor = roles.HasFlag(GymStation.Domain.People.PersonRoles.Instructor);
                _isStaff = roles.HasFlag(GymStation.Domain.People.PersonRoles.Admin)
                    || roles.HasFlag(GymStation.Domain.People.PersonRoles.Owner);

                var account = await db.Users.Where(u => u.Id == userId)
                    .Select(u => new { u.PreferredThemeDark, u.IdleSignOutMinutes })
                    .FirstOrDefaultAsync();
                _userThemePreference = account?.PreferredThemeDark;
                _idleMinutes = account?.IdleSignOutMinutes;
            }

            var settings = await db.GymSettings.SingleOrDefaultAsync();
            if (settings is not null)
            {
                if (GymStation.Domain.Tenancy.ThemeMath.TryParseHexColor(settings.AccentColorHex, out _))
                {
                    _accent = settings.AccentColorHex;
                }

                _dark = settings.DefaultThemeDark;
            }

            // A saved per-user choice beats the gym default; null follows the gym.
            if (_userThemePreference is { } dark)
            {
                _dark = dark;
            }
        }
    }
}
